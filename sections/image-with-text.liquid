{% comment %}
  "Image with text": an image (or video) beside a column of content built
  from blocks: caption, heading, text and buttons.

  - Image on the left or right, image width (1/3, 1/2, 2/3), image shape,
    image first or text first on mobile.
  - Layout: side by side, or a content card that overlaps the image.
  - Content vertical position and text alignment (separately for mobile).

  Styles live in assets/image-with-text.css; the image / video uses
  snippets/banner-media.liquid (assets/banner-media.css).
{% endcomment %}

{{ 'image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign show_video = false
  if section.settings.media_type == 'video'
    assign show_video = true
  endif

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = image.aspect_ratio | default: 1
      if show_video and section.settings.video != blank
        assign ratio = section.settings.video.aspect_ratio | default: ratio
      endif
  endcase

  case section.settings.image_width
    when 'small'
      assign image_fr = 1
      assign content_fr = 2
      assign image_sizes = '(min-width: 750px) 33vw, 100vw'
    when 'large'
      assign image_fr = 2
      assign content_fr = 1
      assign image_sizes = '(min-width: 750px) 66vw, 100vw'
    else
      assign image_fr = 1
      assign content_fr = 1
      assign image_sizes = '(min-width: 750px) 50vw, 100vw'
  endcase

  case section.settings.content_position
    when 'top'
      assign v_align = 'flex-start'
    when 'bottom'
      assign v_align = 'flex-end'
    else
      assign v_align = 'center'
  endcase

  assign card = false
  if section.settings.layout == 'overlap' or section.settings.content_card
    assign card = true
  endif
-%}

<div
  class="image-with-text image-with-text--image-{{ section.settings.image_position }} image-with-text--mobile-{{ section.settings.mobile_image_position }} image-with-text--layout-{{ section.settings.layout }} image-with-text--align-{{ section.settings.alignment }} image-with-text--mobile-align-{{ section.settings.mobile_alignment }}{% if card %} image-with-text--card{% endif %} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --iwt-ratio: {{ ratio }};
    --iwt-image-fr: {{ image_fr }}fr;
    --iwt-content-fr: {{ content_fr }}fr;
    --iwt-gap: {{ section.settings.gap }}px;
    --iwt-radius: {{ section.settings.corner_radius }}px;
    --iwt-justify: {{ v_align }};
    --iwt-content-width: {{ section.settings.content_width }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    <div class="image-with-text__grid">
      <div class="image-with-text__media">
        {% render 'banner-media',
          image: image,
          mobile_image: section.settings.mobile_image,
          show_video: show_video,
          video: section.settings.video,
          mobile_video: section.settings.mobile_video,
          video_url: section.settings.video_url,
          alt: image.alt,
          sizes: image_sizes,
          placeholder: 'lifestyle-1'
        %}
      </div>

      <div class="image-with-text__content-wrap">
        <div class="image-with-text__content{% if card %} color-{{ section.settings.content_color_scheme.id }}{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'caption' -%}
                {%- if block.settings.caption != blank -%}
                  <p
                    class="image-with-text__caption image-with-text__caption--{{ block.settings.style }} image-with-text__caption--{{ block.settings.size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.caption | escape -}}
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  {%- liquid
                    assign heading_tag = block.settings.heading_tag | default: 'h2'
                    assign heading_class = block.settings.heading_class | default: heading_tag
                  -%}
                  <{{ heading_tag }}
                    class="{{ heading_class }} image-with-text__heading{% if block.settings.uppercase %} image-with-text__heading--uppercase{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.heading -}}
                  </{{ heading_tag }}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="image-with-text__text rte image-with-text__text--{{ block.settings.size }}" {{ block.shopify_attributes }}>
                    {{- block.settings.text -}}
                  </div>
                {%- endif -%}

              {%- when 'buttons' -%}
                {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                  <div class="image-with-text__buttons" {{ block.shopify_attributes }}>
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                        class="button button--{{ block.settings.button_style }} image-with-text__button"
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 != blank %}
                          href="{{ block.settings.button_link_2 }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                        class="button button--{{ block.settings.button_style_2 }} image-with-text__button"
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

