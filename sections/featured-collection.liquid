      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "products_width",
      "label": "t:sections.featured_collection.products_width",
      "info": "t:sections.featured_collection.products_width_info",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "mobile_padding_custom",
      "label": "t:labels.mobile_padding_custom",
      "info": "t:labels.mobile_padding_custom_info",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:labels.mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:labels.mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "header",
