      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h4"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.multicolumn.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_list.products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product_list.layout",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.featured_collection.layout_carousel"
        },
        {
          "value": "grid",
          "label": "t:sections.product_list.layout_grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.featured_collection.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.featured_collection.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "desktop_peek",
      "label": "t:sections.featured_collection.desktop_peek",
      "info": "t:sections.featured_collection.desktop_peek_info",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.products_width == 'page' }}"
    },
    {
      "type": "checkbox",
      "id": "mobile_peek",
      "label": "t:sections.featured_collection.mobile_peek",
      "info": "t:sections.featured_collection.mobile_peek_info",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "t:sections.featured_collection.arrow_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.featured_collection.arrow_top"
        },
        {
          "value": "sides",
          "label": "t:sections.featured_collection.arrow_sides"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "t:sections.featured_collection.show_progress",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.view_all"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.show_view_all",
      "default": true
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:sections.featured_collection.view_all_style",
      "options": [
        {
          "value": "button",
          "label": "t:sections.featured_collection.view_all_button"
        },
        {
          "value": "link",
          "label": "t:sections.featured_collection.view_all_link"
        }
      ],
      "default": "button",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.button_text",
      "default": "View all",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "view_all_button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.button_style.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.button_style.secondary"
        }
      ],
      "default": "secondary",
      "visible_if": "{{ section.settings.show_view_all and section.settings.view_all_style == 'button' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.cards"
    },
    {
      "type": "paragraph",
      "content": "t:sections.featured_collection.cards_info"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
