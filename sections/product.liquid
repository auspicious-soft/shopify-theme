    {
      "type": "header",
      "content": "t:sections.product.media"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:sections.product.gallery_layout",
      "options": [
        { "value": "thumbnails", "label": "t:sections.product.gallery_thumbnails" },
        { "value": "thumbnails_left", "label": "t:sections.product.gallery_thumbnails_left" },
        { "value": "carousel", "label": "t:sections.product.gallery_carousel" },
        { "value": "grid", "label": "t:sections.product.gallery_grid" },
        { "value": "stacked", "label": "t:sections.product.gallery_stacked" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "t:sections.product.media_size",
      "options": [
        { "value": "small", "label": "t:options.size.small" },
        { "value": "medium", "label": "t:sections.all.medium" },
        { "value": "large", "label": "t:options.size.large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.product.media_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.all.ratio_adapt" },
        { "value": "square", "label": "t:sections.all.ratio_square" },
        { "value": "portrait", "label": "t:sections.all.ratio_portrait" },
        { "value": "tall", "label": "t:sections.all.ratio_tall" }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "t:sections.product.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:sections.product.video_loop",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.product.info"
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "t:sections.product.sticky_info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "size_guide",
      "name": "t:sections.product.size_guide.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show",
          "label": "t:sections.product.size_guide.show",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.product.size_guide.label",
          "default": "Size guide"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "t:sections.product.size_guide.show_icon",
          "default": true
        },
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.product.size_guide.placement",
          "info": "t:sections.product.size_guide.placement_info",
          "options": [
            { "value": "size_option", "label": "t:sections.product.size_guide.placement_size_option" },
            { "value": "block", "label": "t:sections.product.size_guide.placement_block" }
          ],
          "default": "size_option"
        },
        {
          "type": "checkbox",
          "id": "only_with_size",
          "label": "t:sections.product.size_guide.only_with_size",
          "info": "t:sections.product.size_guide.only_with_size_info",
          "default": true
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.product.size_guide.style",
          "options": [
            { "value": "drawer", "label": "t:sections.product.size_guide.style_drawer" },
            { "value": "popup", "label": "t:sections.product.size_guide.style_popup" }
          ],
          "default": "drawer"
        },
        {
          "type": "header",
          "content": "t:sections.product.size_guide.header_content"
        },
        {
          "type": "paragraph",
          "content": "t:sections.product.size_guide.metafield_info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.product.size_guide.heading",
          "info": "t:sections.product.size_guide.heading_info"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.product.size_guide.page",
          "info": "t:sections.product.size_guide.page_info"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product.size_guide.content",
          "info": "t:sections.product.size_guide.content_info"
        }
      ]
    },
    { "type": "@app" },
    {
      "type": "text",
      "name": "t:sections.product.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Text block</p>"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "t:labels.text_style",
          "options": [
            { "value": "body", "label": "t:sections.product.blocks.text.style_body" },
            { "value": "subtle", "label": "t:sections.product.blocks.text.style_subtle" },
            { "value": "uppercase", "label": "t:sections.product.blocks.text.style_uppercase" }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "vendor",
      "name": "t:sections.product.blocks.vendor.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "t:sections.product.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:labels.heading_tag",
          "info": "t:labels.heading_tag_info",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h1"
        },
        {
          "type": "select",
          "id": "heading_class",
          "label": "t:labels.heading_class",
          "info": "t:labels.heading_class_info",
          "options": [
            { "value": "h6", "label": "t:options.heading_size.extra_small" },
            { "value": "h5", "label": "t:options.heading_size.small" },
            { "value": "h4", "label": "t:options.heading_size.medium" },
            { "value": "h3", "label": "t:options.heading_size.large" },
            { "value": "h2", "label": "t:options.heading_size.extra_large" },
            { "value": "h1", "label": "t:options.heading_size.huge" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "rating",
      "name": "t:sections.product.blocks.rating.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.product.blocks.rating.info"
        }
      ]
    },
    {
      "type": "price",
      "name": "t:sections.product.blocks.price.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_saving",
          "label": "t:sections.product.blocks.price.show_saving",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "t:sections.product.blocks.price.show_tax_note",
          "default": true
        }
      ]
    },
    {
      "type": "sku",
      "name": "t:sections.product.blocks.sku.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "inventory",
      "name": "t:sections.product.blocks.inventory.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_threshold",
          "label": "t:sections.product.blocks.inventory.low_threshold",
          "info": "t:sections.product.blocks.inventory.low_threshold_info",
