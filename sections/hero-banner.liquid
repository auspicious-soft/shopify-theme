{% comment %}
  Full-bleed hero banner: background image with a darkening overlay and
  positionable text + button content. Reuses the theme's existing
  typography (h2), global .button styling and color scheme system instead
  of introducing one-off design tokens.
{% endcomment %}

{{ 'hero-banner.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}
{% liquid
  assign h_align = 'center'
  case section.settings.content_position_horizontal
    when 'left'
      assign h_align = 'flex-start'
    when 'right'
      assign h_align = 'flex-end'
  endcase

  assign v_align = 'flex-end'
  case section.settings.content_position_vertical
    when 'top'
      assign v_align = 'flex-start'
    when 'middle'
      assign v_align = 'center'
  endcase

  # "Adapt to image" sizes the banner from the image's own aspect ratio
  # (height: auto + aspect-ratio) instead of a fixed viewport-height preset.
  assign is_adapt = false
  if section.settings.height_type == 'adapt'
    assign is_adapt = true
  endif

  assign hero_height = '60vh'
  case section.settings.height_type
    when 'small'
      assign hero_height = '40vh'
    when 'medium'
      assign hero_height = '60vh'
    when 'large'
      assign hero_height = '80vh'
    when 'fullscreen'
      assign hero_height = '100svh'
  endcase

  assign show_video = false
  if section.settings.media_type == 'video'
    assign show_video = true
  endif

  assign hero_aspect_ratio = section.settings.background_image.aspect_ratio | default: 1.78
  if show_video and section.settings.video != blank
    assign hero_aspect_ratio = section.settings.video.aspect_ratio | default: hero_aspect_ratio
  endif
  assign hero_aspect_ratio_mobile = section.settings.mobile_image.aspect_ratio | default: hero_aspect_ratio
  if show_video and section.settings.mobile_video != blank
    assign hero_aspect_ratio_mobile = section.settings.mobile_video.aspect_ratio | default: hero_aspect_ratio_mobile
  endif
%}

{%- if section.settings.width == 'page' -%}<div class="page-width">{%- endif -%}
<div
  class="hero-banner{% if is_adapt %} hero-banner--adapt{% endif %}"
  style="
    --hero-banner-bg: {{ section.settings.background_color }};
    --hero-banner-text: {{ section.settings.text_color }};
    --hero-banner-overlay-color: {{ section.settings.overlay_color }};
    --hero-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {% if is_adapt %}
      --hero-banner-aspect-ratio: {{ hero_aspect_ratio }};
      --hero-banner-aspect-ratio-mobile: {{ hero_aspect_ratio_mobile }};
    {% else %}
      --hero-banner-height: {{ hero_height }};
    {% endif %}
    --hero-banner-align: {{ h_align }};
    --hero-banner-justify: {{ v_align }};
    --hero-banner-text-align: {{ section.settings.content_position_horizontal }};
    --hero-banner-padding-top: {{ section.settings.padding_top }}px;
    --hero-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hero-banner__media">
    {% render 'banner-media',
      image: section.settings.background_image,
      mobile_image: section.settings.mobile_image,
      show_video: show_video,
      video: section.settings.video,
      mobile_video: section.settings.mobile_video,
      video_url: section.settings.video_url,
      alt: section.settings.heading,
      eager: true
    %}
  </div>
  <div class="hero-banner__overlay"></div>

  <div class="hero-banner__inner page-width">
    <div class="hero-banner__content">
      {% if section.settings.heading != blank %}
        {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
        {%- assign heading_class = section.settings.heading_class | default: heading_tag -%}
        <{{ heading_tag }} class="{{ heading_class }} hero-banner__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.enable_button and section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_url | default: '#' }}"
          class="button button--{{ section.settings.button_style }} hero-banner__button color-{{ section.settings.button_color_scheme.id }}"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
{%- if section.settings.width == 'page' -%}</div>{%- endif -%}

{% schema %}
{
  "name": "t:general.hero_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:labels.media_type",
      "options": [
        { "value": "image", "label": "t:options.media_type.image" },
        { "value": "video", "label": "t:options.media_type.video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:labels.background_image_video_info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image",
      "info": "t:labels.mobile_image_info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "info": "t:labels.video_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "info": "t:labels.mobile_video_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube","vimeo"],
      "label": "t:labels.video_url",
      "info": "t:labels.video_url_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "info": "t:labels.hero_background_color_info",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "select",
      "id": "height_type",
      "label": "t:labels.height_type",
      "options": [
        { "value": "adapt", "label": "t:options.height_type.adapt" },
        { "value": "small", "label": "t:options.height_type.small" },
        { "value": "medium", "label": "t:options.height_type.medium" },
        { "value": "large", "label": "t:options.height_type.large" },
        { "value": "fullscreen", "label": "t:options.height_type.fullscreen" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:labels.content_settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "End of summer sale"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        { "value": "h6", "label": "t:options.heading_size.extra_small" },
        { "value": "h5", "label": "t:options.heading_size.small" },
        { "value": "h4", "label": "t:options.heading_size.medium" },
        { "value": "h3", "label": "t:options.heading_size.large" },
        { "value": "h2", "label": "t:options.heading_size.extra_large" },
        { "value": "h1", "label": "t:options.heading_size.huge" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Up to 40% off"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_position_horizontal",
      "label": "t:labels.content_position_horizontal",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position_vertical",
      "label": "t:labels.content_position_vertical",
      "options": [
        { "value": "top", "label": "t:options.vertical_position.top" },
        { "value": "middle", "label": "t:options.vertical_position.middle" },
        { "value": "bottom", "label": "t:options.vertical_position.bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:labels.button_settings"
    },
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "t:labels.enable_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:labels.button_text",
      "default": "Shop now",
      "visible_if": "{{ section.settings.enable_button }}"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.button_url",
      "visible_if": "{{ section.settings.enable_button }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "primary", "label": "t:options.button_style.primary" },
        { "value": "secondary", "label": "t:options.button_style.secondary" }
      ],
      "default": "primary",
      "visible_if": "{{ section.settings.enable_button }}"
    },
    {
      "type": "color_scheme",
      "id": "button_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.enable_button }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero_banner"
    }
  ]
}
{% endschema %}
