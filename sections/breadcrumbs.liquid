{% comment %}
  Breadcrumbs: the path to the current page (Home / Collection / Product …)
  from snippets/breadcrumbs.liquid, which also outputs structured data for
  search engines. Added as the first section of every page template; turn
  it off with "Show breadcrumbs", or hide / move the section per template.
  Styles: assets/breadcrumbs.css.
{% endcomment %}

{%- if section.settings.show -%}
  {{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}

  <div
    class="breadcrumbs-section breadcrumbs-section--{{ section.settings.alignment }} breadcrumbs-section--{{ section.settings.text_size }}{% unless section.settings.show_mobile %} breadcrumbs-section--hide-mobile{% endunless %} color-{{ section.settings.color_scheme.id }}"
    style="
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
      {% render 'breadcrumbs',
        separator: section.settings.separator,
        product_collection: section.settings.product_collection,
        collections_link: section.settings.collections_link,
        home_icon: section.settings.home_icon
      %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.breadcrumbs.name",
  "class": "section-breadcrumbs",
  "disabled_on": {
    "templates": ["index", "password", "gift_card"],
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "t:sections.breadcrumbs.show",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "t:sections.breadcrumbs.show_mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.breadcrumbs.header_path"
    },
    {
      "type": "checkbox",
      "id": "home_icon",
      "label": "t:sections.breadcrumbs.home_icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "product_collection",
      "label": "t:sections.breadcrumbs.product_collection",
      "info": "t:sections.breadcrumbs.product_collection_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collections_link",
      "label": "t:sections.breadcrumbs.collections_link",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.appearance"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "t:sections.breadcrumbs.separator",
      "options": [
        { "value": "chevron", "label": "t:sections.breadcrumbs.separator_chevron" },
        { "value": "slash", "label": "t:options.separator_style.slash" },
        { "value": "dot", "label": "t:options.separator_style.dot" },
        { "value": "pipe", "label": "t:options.separator_style.pipe" }
      ],
      "default": "chevron"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:labels.font_size",
      "options": [
        { "value": "small", "label": "t:options.heading_size.small" },
        { "value": "medium", "label": "t:options.heading_size.medium" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.breadcrumbs.name"
    }
  ]
}
{% endschema %}
