              "label": "t:sections.collection_banner.size_medium"
            },
            {
              "value": "large",
              "label": "t:sections.collection_banner.size_large"
            }
          ],
          "default": "small"
        },
        {
          "type": "select",
          "id": "letter_spacing",
          "label": "t:labels.letter_spacing",
          "options": [
