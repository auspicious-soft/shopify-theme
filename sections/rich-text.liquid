              "value": "none",
              "label": "t:options.letter_spacing.none"
            },
            {
              "value": "small",
              "label": "t:options.letter_spacing.small"
            },
            {
              "value": "medium",
              "label": "t:options.letter_spacing.medium"
            },
            {
              "value": "large",
              "label": "t:options.letter_spacing.large"
            }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:labels.heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:labels.heading_tag",
          "info": "t:labels.heading_tag_info",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "heading_class",
          "label": "t:labels.heading_class",
          "info": "t:labels.heading_class_info",
          "options": [
            {
              "value": "h6",
              "label": "t:options.heading_size.extra_small"
            },
            {
              "value": "h5",
              "label": "t:options.heading_size.small"
            },
            {
              "value": "h4",
              "label": "t:options.heading_size.medium"
            },
            {
              "value": "h3",
              "label": "t:options.heading_size.large"
            },
            {
              "value": "h2",
              "label": "t:options.heading_size.extra_large"
            },
            {
              "value": "h1",
              "label": "t:options.heading_size.huge"
            }
          ],
          "default": "h2"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "t:sections.collection_banner.heading_uppercase",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.rich_text.text_size",
          "options": [
            {
              "value": "small",
              "label": "t:sections.collection_banner.size_small"
            },
            {
              "value": "medium",
              "label": "t:sections.collection_banner.size_medium"
