{% comment %}
  "Rich text": a block of text for introductions, brand stories or
  announcements. Content is built from blocks you can add and reorder:
  caption, heading (with bold/italic/links), text (full rich text) and
  buttons (one or two).

  The section sets alignment (separately for mobile), where the content sits
  on wide screens, its max width, full or page width, color scheme and
  spacing.

  Styles live in assets/rich-text.css.
{% endcomment %}
{%- liquid
  # Theme editor only: guidance for empty fields. request.design_mode is false
  # on the live store, so these are never shown to customers.
  assign ph_caption = nil
  assign ph_heading = nil
  assign ph_text = nil
  assign ph_button_label = nil
  if request.design_mode
    assign ph_caption = 'editor_placeholders.caption' | t
    assign ph_heading = 'editor_placeholders.heading' | t
    assign ph_text = 'editor_placeholders.content' | t
    assign ph_button_label = 'editor_placeholders.button' | t
  endif

-%}

{{ 'rich-text.css' | asset_url | stylesheet_tag }}

<div
  class="rich-text rich-text--align-{{ section.settings.alignment }} rich-text--mobile-align-{{ section.settings.mobile_alignment }} rich-text--position-{{ section.settings.position }} color-{{ section.settings.color_scheme.id }}"
  style="
    {% render 'section-padding-vars', section: section %}
    --rich-text-width: {{ section.settings.content_width }}px;
    --rich-text-gap: {{ section.settings.block_spacing }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    <div class="rich-text__content">
      {%- for block in section.blocks -%}
    {%- liquid
      assign b_caption = block.settings.caption | default: ph_caption
      assign b_heading = block.settings.heading | default: ph_heading
      assign b_text = block.settings.text | default: ph_text
      assign b_button_label = block.settings.button_label | default: ph_button_label
    -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'caption' -%}
            {%- if b_caption != blank -%}
              <p
                class="rich-text__caption rich-text__caption--{{ block.settings.style }} rich-text__caption--{{ block.settings.size }}{% if block.settings.letter_spacing != 'none' %} letter-spacing--{{ block.settings.letter_spacing }}{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- b_caption | escape -}}
              </p>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if b_heading != blank -%}
              {%- liquid
                assign heading_tag = block.settings.heading_tag | default: 'h2'
                assign heading_class = block.settings.heading_class | default: heading_tag
              -%}
              <{{ heading_tag }}
                class="{{ heading_class }} rich-text__heading{% if block.settings.uppercase %} rich-text__heading--uppercase{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- b_heading -}}
              </{{ heading_tag }}>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if b_text != blank -%}
              <div class="rich-text__text rte rich-text__text--{{ block.settings.size }}" {{ block.shopify_attributes }}>
                {{- b_text -}}
              </div>
            {%- endif -%}

          {%- when 'buttons' -%}
            {%- if b_button_label != blank or block.settings.button_label_2 != blank -%}
              <div class="rich-text__buttons" {{ block.shopify_attributes }}>
                {%- if b_button_label != blank -%}
                  <a
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="button button--{{ block.settings.button_style }} rich-text__button"
                  >
                    {{- b_button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 != blank %}
                      href="{{ block.settings.button_link_2 }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="button button--{{ block.settings.button_style_2 }} rich-text__button"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "class": "section-rich-text",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.rich_text.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "t:sections.rich_text.mobile_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.rich_text.position",
      "info": "t:sections.rich_text.position_info",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.collection_banner.content_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "block_spacing",
      "label": "t:sections.rich_text.block_spacing",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "mobile_padding_custom",
      "label": "t:labels.mobile_padding_custom",
      "info": "t:labels.mobile_padding_custom_info",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:labels.mobile_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:labels.mobile_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:labels.button_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:options.button_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.button_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.button_size.large"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.text_case"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "caption",
      "name": "t:sections.rich_text.blocks.caption",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.rich_text.blocks.caption",
          "placeholder": "t:editor_placeholders.caption"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich_text.caption_style",
          "options": [
            {
              "value": "uppercase",
              "label": "t:sections.rich_text.caption_uppercase"
            },
            {
              "value": "subtitle",
              "label": "t:sections.rich_text.caption_subtitle"
            }
          ],
          "default": "uppercase"
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.rich_text.text_size",
          "options": [
