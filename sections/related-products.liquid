{% comment %}
  "You may also like" (product template): products Shopify's recommendation
  engine picks for the current product. Type "Related" shows similar
  products; "Pairs well with" shows complementary products (set up in the
  Search & Discovery app).

  Recommendations only exist when this section is requested through
  `routes.product_recommendations_url`, so the page first renders an empty
  <related-products>; once it nears the viewport it fetches itself from that
  endpoint and swaps the result in. Nothing is shown (and no space is taken)
  when there are no recommendations.
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'product-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
<script src="{{ 'slider.js' | asset_url }}" defer></script>
<script src="{{ 'related-products.js' | asset_url }}" defer></script>

<related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    {% render 'product-list', section: section, products: recommendations.products %}
  {% endif %}
</related-products>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "class": "section-related-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related_products.info"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.related_products.intent",
      "info": "t:sections.related_products.intent_info",
      "options": [
        {
          "value": "related",
          "label": "t:sections.related_products.intent_related"
        },
        {
          "value": "complementary",
          "label": "t:sections.related_products.intent_complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.multicolumn.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_list.products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product_list.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.product_list.layout_grid"
        },
        {
          "value": "slider",
          "label": "t:sections.product_list.layout_slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
