      "default": false
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:labels.mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:labels.mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:labels.button_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:options.button_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.button_size.medium"
        },
