    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "presets": [
    {
      "name": "t:sections.related_products.name"
    }
  ]
}
{% endschema %}
