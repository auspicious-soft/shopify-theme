{% comment %}
  "You may also like" (product template): products Shopify's recommendation
  engine picks for the current product. Type "Related" shows similar
  products; "Pairs well with" shows complementary products (set up in the
  Search & Discovery app).

  Recommendations only exist when this section is requested through
  `routes.product_recommendations_url`, so the page first renders an empty
  <related-products>; once it nears the viewport it fetches itself from that
  endpoint and swaps the result in. Nothing is shown (and no space is taken)
  when there are no recommendations.
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'product-list.css' | asset_url | stylesheet_tag }}

<related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    {% render 'product-list', section: section, products: recommendations.products %}
  {% endif %}
</related-products>

{% javascript %}
  if (!customElements.get('related-products')) {
    class RelatedProducts extends HTMLElement {
      connectedCallback() {
        if (!this.dataset.url || this.querySelector('.product-list')) return;

        if (!('IntersectionObserver' in window)) {
          this.load();
          return;
        }

        this.observer = new IntersectionObserver(
          (entries) => {
            if (!entries[0].isIntersecting) return;
            this.observer.disconnect();
            this.load();
          },
          { rootMargin: '0px 0px 600px 0px' }
        );
        this.observer.observe(this);
      }

      disconnectedCallback() {
        this.observer?.disconnect();
      }

      async load() {
        try {
          const response = await fetch(this.dataset.url);
          const html = await response.text();
          const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('related-products');

          if (fresh && fresh.querySelector('.product-card')) {
            this.innerHTML = fresh.innerHTML;
            // Inserted after the scroll-reveal observer ran, so show directly.
            this.querySelectorAll('[data-animate]').forEach((el) => el.classList.add('is-revealed'));
          } else {
            this.hidden = true;
          }
        } catch (error) {
          this.hidden = true;
        }
      }
    }

    customElements.define('related-products', RelatedProducts);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "class": "section-related-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related_products.info"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.related_products.intent",
      "info": "t:sections.related_products.intent_info",
      "options": [
        { "value": "related", "label": "t:sections.related_products.intent_related" },
        { "value": "complementary", "label": "t:sections.related_products.intent_complementary" }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_list.products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product_list.layout",
      "options": [
        { "value": "grid", "label": "t:sections.product_list.layout_grid" },
        { "value": "slider", "label": "t:sections.product_list.layout_slider" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "t:sections.related_products.name"
    }
  ]
}
{% endschema %}
