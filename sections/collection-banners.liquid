{% comment %}
  "Collection banners": a heading above a row of image tiles, one per
  collection (e.g. "Shop by gender" with Men / Women). Each tile is a block
  with a small subheading, heading and button over the image.

  A tile's collection fills in anything left empty: its image, title and
  link. Columns, image shape, content position, overlay and mobile layout
  (stacked or swipeable) are set on the section so every tile matches.
{% endcomment %}

{%- liquid
  case section.settings.content_position_horizontal
    when 'left'
      assign h_align = 'flex-start'
    when 'right'
      assign h_align = 'flex-end'
    else
      assign h_align = 'center'
  endcase

  case section.settings.content_position_vertical
    when 'top'
      assign v_align = 'flex-start'
    when 'middle'
      assign v_align = 'center'
    when 'split'
      assign v_align = 'flex-start'
    else
      assign v_align = 'flex-end'
  endcase

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '16 / 9'
  endcase

  assign columns = section.settings.columns_desktop
  assign image_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), 100vw'
-%}

<div
  class="collection-tiles collection-tiles--{{ section.settings.content_position_vertical }} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --tiles-columns: {{ columns }};
    --tiles-columns-mobile: {{ section.settings.columns_mobile }};
    --tiles-gap: {{ section.settings.gap }}px;
    --tiles-ratio: {{ ratio }};
    --tiles-radius: {{ section.settings.corner_radius }}px;
    --tiles-text: {{ section.settings.text_color }};
    --tiles-overlay: {{ section.settings.overlay_color }};
    --tiles-overlay-opacity: {{ section.settings.overlay_opacity }}%;
    --tiles-align: {{ h_align }};
    --tiles-justify: {{ v_align }};
    --tiles-text-align: {{ section.settings.content_position_horizontal }};
  "
>
  <div class="{% if section.settings.width == 'page' %}page-width{% else %}collection-tiles__full{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="collection-tiles__header collection-tiles__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-tiles__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="collection-tiles__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="collection-tiles__grid collection-tiles__grid--mobile-{{ section.settings.mobile_layout }}{% if section.settings.image_ratio == 'adapt' %} collection-tiles__grid--adapt{% endif %}"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign heading = block.settings.heading | default: collection.title
          assign link = block.settings.link | default: collection.url
          assign tile_ratio = image.aspect_ratio | default: 0.8
        -%}
        <li
          class="collection-tile{% if section.settings.zoom_on_hover %} collection-tile--zoom{% endif %}"
          style="--tile-ratio: {{ tile_ratio }};"
          {{ block.shopify_attributes }}
        >
          <div class="collection-tile__media">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1800
                | image_tag:
                  class: 'collection-tile__image',
                  widths: '375, 550, 750, 1100, 1500, 1800',
                  sizes: image_sizes,
                  loading: 'lazy',
                  alt: heading
              }}
            {%- else -%}
              {%- liquid
                assign placeholder_name = 'lifestyle-1'
                assign odd = forloop.index | modulo: 2
                if odd == 0
                  assign placeholder_name = 'lifestyle-2'
                endif
              -%}
              {{ placeholder_name | placeholder_svg_tag: 'collection-tile__image collection-tile__placeholder' }}
            {%- endif -%}
          </div>

          <div class="collection-tile__overlay" aria-hidden="true"></div>

          {%- if link != blank -%}
            <a href="{{ link }}" class="collection-tile__link" tabindex="-1" aria-hidden="true"></a>
          {%- endif -%}

          <div class="collection-tile__content">
            {%- if block.settings.subheading != blank -%}
              <p class="collection-tile__subheading">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if heading != blank -%}
              <h3 class="collection-tile__heading collection-tile__heading--{{ section.settings.heading_size }}{% if section.settings.heading_uppercase %} collection-tile__heading--uppercase{% endif %}">
                {{- heading | escape -}}
              </h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="collection-tile__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank and link != blank -%}
              <a
                href="{{ link }}"
                class="button button--{{ section.settings.button_style }} collection-tile__button collection-tile__button--{{ section.settings.button_size }} color-{{ section.settings.button_color_scheme.id }}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .collection-tiles {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .collection-tiles__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-block-end: 1.25rem;
  }

  .collection-tiles__full .collection-tiles__header {
    padding-inline: var(--page-margin);
  }

  .collection-tiles__header--center {
    align-items: center;
    text-align: center;
  }

  .collection-tiles__title {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .collection-tiles__subtitle {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .collection-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--tiles-columns-mobile), minmax(0, 1fr));
    gap: var(--tiles-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile "slider": tiles scroll sideways, the next one peeking in. */
  @media screen and (max-width: 749px) {
    .collection-tiles__grid--mobile-slider {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    .collection-tiles__grid--mobile-slider::-webkit-scrollbar {
      display: none;
    }

    .collection-tiles__grid--mobile-slider > .collection-tile {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .collection-tiles__full .collection-tiles__grid--mobile-slider {
      scroll-padding-inline: var(--page-margin);
      padding-inline: var(--page-margin);
    }
  }

  @media screen and (min-width: 750px) {
    .collection-tiles__grid {
      grid-template-columns: repeat(var(--tiles-columns), minmax(0, 1fr));
    }
  }

  .collection-tile {
    position: relative;
    display: flex;
    aspect-ratio: var(--tiles-ratio);
    overflow: hidden;
    border-radius: var(--tiles-radius);
    color: var(--tiles-text);
    isolation: isolate;
  }

  .collection-tiles__grid--adapt .collection-tile {
    aspect-ratio: var(--tile-ratio);
  }

  .collection-tile__media,
  .collection-tile__overlay,
  .collection-tile__link {
    position: absolute;
    inset: 0;
  }

  .collection-tile__media {
    z-index: -2;
    background-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .collection-tile__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  @media (hover: hover) {
    .collection-tile--zoom:hover .collection-tile__image {
      transform: scale(1.05);
    }
  }

  .collection-tile__overlay {
    z-index: -1;
    background-color: color-mix(in srgb, var(--tiles-overlay) var(--tiles-overlay-opacity), transparent);
    pointer-events: none;
  }

  .collection-tile__link {
    z-index: 1;
  }

  .collection-tile__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: var(--tiles-align);
    justify-content: var(--tiles-justify);
    gap: 0.6rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    text-align: var(--tiles-text-align);
    pointer-events: none;
  }

  .collection-tile__content a {
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }

  .collection-tile__subheading {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .collection-tile__heading {
    margin: 0;
    color: inherit;
    line-height: 1.1;
  }

  .collection-tile__heading--small {
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
  }

  .collection-tile__heading--medium {
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
  }

  .collection-tile__heading--large {
    font-size: clamp(1.6rem, 3.2vw, 2.75rem);
  }

  .collection-tile__heading--uppercase {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .collection-tile__text > * {
    margin: 0;
  }

  /* "Split": heading at the top, button pinned to the bottom. */
  .collection-tiles--split .collection-tile__button {
    margin-top: auto;
  }

  .collection-tile__button--small {
    min-width: 0;
    padding: 0.6rem 1.1rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tile__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_banners.name",
  "class": "section-collection-banners",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by gender"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.collection_banners.mobile_layout",
      "options": [
        { "value": "stack", "label": "t:sections.collection_banners.mobile_stack" },
        { "value": "slider", "label": "t:sections.collection_banners.mobile_slider" }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.collection_banner.width",
      "options": [
        { "value": "full", "label": "t:sections.collection_banner.width_full" },
        { "value": "page", "label": "t:sections.collection_banner.width_page" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.item_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.collection_banner.header_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection_banners.image_ratio",
      "options": [
        { "value": "adapt", "label": "t:options.height_type.adapt" },
        { "value": "portrait", "label": "t:sections.collection_banners.ratio_portrait" },
        { "value": "tall", "label": "t:sections.collection_banners.ratio_tall" },
        { "value": "square", "label": "t:sections.collection_banners.ratio_square" },
        { "value": "landscape", "label": "t:sections.collection_banners.ratio_landscape" },
        { "value": "wide", "label": "t:sections.collection_banners.ratio_wide" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:sections.collection_banner.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "zoom_on_hover",
      "label": "t:sections.collection_banner.zoom_on_hover",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "header",
      "content": "t:labels.content_settings"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.collection_banner.heading_size",
      "options": [
        { "value": "small", "label": "t:sections.collection_banner.size_small" },
        { "value": "medium", "label": "t:sections.collection_banner.size_medium" },
        { "value": "large", "label": "t:sections.collection_banner.size_large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "t:sections.collection_banner.heading_uppercase",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_position_horizontal",
      "label": "t:labels.content_position_horizontal",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_vertical",
      "label": "t:labels.content_position_vertical",
      "options": [
        { "value": "top", "label": "t:options.vertical_position.top" },
        { "value": "middle", "label": "t:options.vertical_position.middle" },
        { "value": "bottom", "label": "t:options.vertical_position.bottom" },
        { "value": "split", "label": "t:sections.collection_banners.position_split" }
      ],
      "default": "split"
    },
    {
      "type": "header",
      "content": "t:labels.button_settings"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "primary", "label": "t:options.button_style.primary" },
        { "value": "secondary", "label": "t:options.button_style.secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.collection_banner.button_size",
      "options": [
        { "value": "small", "label": "t:sections.collection_banner.size_small" },
        { "value": "medium", "label": "t:sections.collection_banner.size_medium" }
      ],
      "default": "small"
    },
    {
      "type": "color_scheme",
      "id": "button_color_scheme",
      "label": "t:sections.collection_banner.button_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_banner.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_banners.block_name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_banner.collection",
          "info": "t:sections.collection_banner.collection_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_banner.image",
          "info": "t:sections.collection_banner.image_info"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:labels.subheading",
          "default": "Men"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "info": "t:sections.collection_banner.heading_info",
          "default": "Shop the latest drops"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_text",
          "info": "t:sections.collection_banner.button_label_info",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link",
          "info": "t:sections.collection_banner.button_link_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_banners.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "subheading": "Male",
            "heading": "Shop the latest drops",
            "button_label": "Explore male"
          }
        },
        {
          "type": "collection",
          "settings": {
            "subheading": "Female",
            "heading": "Discover new silhouettes",
            "button_label": "Explore female"
          }
        }
      ]
    }
  ]
}
{% endschema %}
