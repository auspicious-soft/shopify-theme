{% comment %}
  "Related articles" (article template): more articles from the same blog,
  shown below the article. Articles sharing a tag with the current one are
  picked first, then the newest others (shown newest first), never the
  current article itself. "Hide the featured story" leaves out the article
  the blog page features (the newest one, or the newest with a tag), to
  match the Blog section's "Featured article" setting. Grid, or a carousel
  driven by <slider-component> (assets/slider.js).
{% endcomment %}

{{ 'related-articles.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slider.js' | asset_url }}" defer></script>

{%- liquid
  assign limit = section.settings.articles_to_show
  assign layout = section.settings.layout
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 750px) 50vw, 85vw'

  # The blog's featured story, when it should be left out.
  assign hidden_id = ''
  assign featured_key = ''
  case section.settings.hide_featured
    when 'latest'
      assign hidden_id = blog.articles.first.id
    when 'tag'
      assign featured_key = section.settings.featured_tag | downcase | strip
      if featured_key != blank
        for candidate in blog.articles
          for candidate_tag in candidate.tags
            assign candidate_tag_key = candidate_tag | downcase
            if candidate_tag_key == featured_key
              assign hidden_id = candidate.id
              break
            endif
          endfor
          if hidden_id != ''
            break
          endif
        endfor
      endif
  endcase

  # Pick articles: tag matches first, then the rest, skipping the current one.
  assign picked_ids = ','
  assign count = 0
  if article.tags.size > 0
    for candidate in blog.articles
      if count >= limit
        break
      endif
      if candidate.id == article.id or candidate.id == hidden_id
        continue
      endif
      for tag in candidate.tags
        # The "featured" tag isn't a shared topic.
        assign tag_key = tag | downcase
        if featured_key != blank and tag_key == featured_key
          continue
        endif
        if article.tags contains tag
          assign picked_ids = picked_ids | append: candidate.id | append: ','
          assign count = count | plus: 1
          break
        endif
      endfor
    endfor
  endif
  for candidate in blog.articles
    if count >= limit
      break
    endif
    assign candidate_key = ',' | append: candidate.id | append: ','
    if candidate.id == article.id or candidate.id == hidden_id or picked_ids contains candidate_key
      continue
    endif
    assign picked_ids = picked_ids | append: candidate.id | append: ','
    assign count = count | plus: 1
  endfor
  assign picked = picked_ids | split: ','

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
-%}

{%- if count > 0 -%}
  <slider-component
    class="related-articles related-articles--{{ layout }} color-{{ section.settings.color_scheme.id }}"
    data-slider-arrow-anchor=".article-card__media"
    style="
      {% render 'section-padding-vars', section: section %}
      --related-columns: {{ columns }};
      --related-columns-mobile: {{ section.settings.columns_mobile }};
    "
  >
    <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
      <div class="related-articles__header related-articles__header--{{ section.settings.heading_alignment }}">
        <div class="related-articles__titles">
          {%- if section.settings.subheading != blank -%}
            <p class="related-articles__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} class="{{ heading_class }} related-articles__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}
        </div>
        <div class="related-articles__actions">
          {%- if section.settings.show_view_all -%}
            <a href="{{ blog.url }}" class="related-articles__view-all">{{ 'blog.view_all' | t }}</a>
          {%- endif -%}
          {%- if layout == 'slider' -%}
            <div class="related-articles__arrows">
              <button type="button" class="related-articles__arrow related-articles__arrow--prev" data-slider-prev aria-label="{{ 'products.scroll_previous' | t }}" disabled>
                {{- 'icon-chevron.svg' | inline_asset_content -}}
              </button>
              <button type="button" class="related-articles__arrow related-articles__arrow--next" data-slider-next aria-label="{{ 'products.scroll_next' | t }}">
                {{- 'icon-chevron.svg' | inline_asset_content -}}
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      <ul class="related-articles__track" role="list" {% if layout == 'slider' %}data-slider-track{% endif %}>
        {%- for candidate in blog.articles -%}
          {%- assign candidate_id = candidate.id | append: '' -%}
          {%- unless picked contains candidate_id -%}
            {%- continue -%}
          {%- endunless -%}
          <li class="related-articles__item">
            {% render 'article-card',
              article: candidate,
              image_ratio: section.settings.image_ratio,
              sizes: card_sizes,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt,
              excerpt_words: 20,
              show_topic: section.settings.show_topic,
              show_reading_time: section.settings.show_reading_time,
              title_uppercase: section.settings.title_uppercase,
              meta_position: section.settings.meta_position,
              read_more: section.settings.read_more,
              zoom: true
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </slider-component>
{%- endif -%}

{% render 'text-case', section: section %}

{% schema %}
