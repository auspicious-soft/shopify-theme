{% comment %}
  "Multicolumn": a heading area above a row of columns, each with an image
  (or icon), a number (01, 02… or the column's own), or nothing on top,
  then a title, text and an optional link. Good for features, benefits,
  services or values ("Free shipping", "30-day returns", ...).

  - Columns per row on desktop and mobile; on mobile a grid or a swipe slider.
  - Image shape (adapt, square, portrait, landscape, circle) and image size
    (full, half or a third of the column, for icons).
  - Column text alignment and an optional card background per column.
  - Optional button under the columns.

  Styles live in assets/multicolumn.css.
{% endcomment %}

{{ 'multicolumn.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'circle'
      assign ratio = '1 / 1'
    else
      assign ratio = ''
  endcase

  case section.settings.image_width
    when 'half'
      assign image_share = 50
    when 'third'
      assign image_share = 33
    else
      assign image_share = 100
  endcase
  assign image_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: ' * ' | append: image_share | append: ' / 100), calc(100vw / ' | append: columns_mobile | append: ' * ' | append: image_share | append: ' / 100)'

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
-%}

<div
  class="multicolumn multicolumn--align-{{ section.settings.column_alignment }} multicolumn--mobile-align-{{ section.settings.mobile_column_alignment | default: 'same' }} multicolumn--header-{{ section.settings.heading_alignment }} multicolumn--mobile-{{ section.settings.mobile_layout }} multicolumn--image-{{ section.settings.image_width }}{% if section.settings.image_ratio == 'circle' %} multicolumn--circle{% endif %}{% if section.settings.card %} multicolumn--card{% endif %} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mc-columns: {{ columns }};
    --mc-columns-mobile: {{ columns_mobile }};
    --mc-gap: {{ section.settings.gap }}px;
    --mc-radius: {{ section.settings.corner_radius }}px;
    {% if ratio != '' %}--mc-ratio: {{ ratio }};{% endif %}
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      <div class="multicolumn__header">
        {%- if section.settings.subheading != blank -%}
          <p class="multicolumn__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="{{ heading_class }} multicolumn__heading">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="multicolumn__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="multicolumn__list" role="list">
      {%- for block in section.blocks -%}
        <li class="multicolumn__item{% if section.settings.card %} color-{{ section.settings.card_color_scheme.id }}{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank and block.settings.link_label == blank -%}
            <a href="{{ block.settings.link }}" class="multicolumn__cover-link" aria-label="{{ block.settings.title | strip_html | escape }}"></a>
          {%- endif -%}

          {%- assign column_top = section.settings.column_media | default: 'image' -%}
          {%- if column_top == 'number' -%}
            {%- liquid
              if block.settings.number != blank
                assign column_number = block.settings.number
              else
                assign column_number = forloop.index
                if section.settings.number_format == 'padded' and forloop.index < 10
                  assign column_number = '0' | append: forloop.index
                endif
              endif
            -%}
            <p class="multicolumn__number multicolumn__number--{{ section.settings.number_size }}" aria-hidden="true">{{ column_number | escape }}</p>
          {%- elsif column_top == 'none' -%}
            {%- comment -%} No image or number. {%- endcomment -%}
          {%- elsif block.settings.image != blank -%}
            <div class="multicolumn__media{% if ratio == '' %} multicolumn__media--adapt{% endif %}">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'multicolumn__image',
                  loading: 'lazy',
                  widths: '165, 275, 360, 535, 750, 1000, 1200',
                  sizes: image_sizes,
                  alt: block.settings.image.alt
              }}
            </div>
          {%- elsif section.settings.show_placeholders -%}
            <div class="multicolumn__media multicolumn__media--placeholder">
              {{ 'image' | placeholder_svg_tag: 'multicolumn__image multicolumn__placeholder' }}
            </div>
          {%- endif -%}

          <div class="multicolumn__body">
            {%- if block.settings.title != blank -%}
              <h3 class="multicolumn__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="multicolumn__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="multicolumn__link">
                <span>{{ block.settings.link_label | escape }}</span>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5"/></svg>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="multicolumn__footer">
        <a href="{{ section.settings.button_link }}" class="button button--{{ section.settings.button_style }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% render 'text-case', section: section %}

