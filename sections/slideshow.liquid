{% comment %}
  "Slideshow": full-width image (or video) slides with a subheading, heading,
  text and up to two buttons each.

  - Transition: slide or fade, with an optional slow zoom on the active image.
  - Autoplay with its own speed, pause on hover.
  - Pagination: dots, numbers, fraction (1 / 3), bars (fill up during
    autoplay), progress line, or none; left / center / right.
  - Arrows on the sides or next to the pagination.
  - Height presets (or adapt to the first image), separate mobile height,
    full or page width.

  Each slide has its own color scheme (text, buttons, and the background
  behind the image).

  Styles: assets/slideshow.css. Behavior: assets/slideshow.js (<slide-show>).
{% endcomment %}

{{ 'slideshow.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slideshow.js' | asset_url }}" defer></script>

{%- liquid
  assign slide_count = section.blocks.size
  assign pagination = section.settings.pagination_type
  if slide_count < 2
    assign pagination = 'none'
  endif
  assign arrows = section.settings.show_arrows
  if slide_count < 2
    assign arrows = false
  endif

  case section.settings.height
    when 'small'
      assign height = '45vh'
    when 'medium'
      assign height = '65vh'
    when 'large'
      assign height = '80vh'
    when 'fullscreen'
      assign height = '100svh'
    else
      assign height = 'auto'
  endcase

  case section.settings.mobile_height
    when 'small'
      assign mobile_height = '55vh'
    when 'large'
      assign mobile_height = '85vh'
    when 'fullscreen'
      assign mobile_height = '100svh'
    else
      assign mobile_height = '70vh'
  endcase

  assign first_image = section.blocks.first.settings.image
  assign ratio = first_image.aspect_ratio | default: 1.78
  assign first_mobile = section.blocks.first.settings.mobile_image | default: first_image
  assign mobile_ratio = first_mobile.aspect_ratio | default: 0.8

  assign region_label = 'slideshow.label' | t
  if section.settings.accessibility_label != blank
    assign region_label = section.settings.accessibility_label
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
-%}

{%- capture arrow_buttons -%}
  <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev aria-label="{{ 'slideshow.previous' | t }}">
    {{ 'icon-chevron.svg' | inline_asset_content }}
  </button>
  <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next aria-label="{{ 'slideshow.next' | t }}">
    {{ 'icon-chevron.svg' | inline_asset_content }}
  </button>
{%- endcapture -%}

<div
  class="slideshow-section color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="{% if section.settings.width == 'page' %}page-width{% endif %}">
    <slide-show
      class="slideshow slideshow--{{ section.settings.transition }} slideshow--height-{{ section.settings.height }} slideshow--mobile-{{ section.settings.mobile_height }} slideshow--pagination-{{ pagination }} slideshow--pagination-{{ section.settings.pagination_position }} slideshow--arrows-{{ section.settings.arrow_position }}{% if section.settings.image_zoom %} slideshow--zoom{% endif %}"
      role="region"
      aria-roledescription="{{ 'slideshow.carousel' | t }}"
      aria-label="{{ region_label | escape }}"
      tabindex="0"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
      data-pause-on-hover="{{ section.settings.pause_on_hover }}"
      style="
        --slideshow-height: {{ height }};
        --slideshow-height-mobile: {{ mobile_height }};
        --slideshow-ratio: {{ ratio }};
        --slideshow-ratio-mobile: {{ mobile_ratio }};
        --slideshow-radius: {{ section.settings.corner_radius }}px;
        --slideshow-speed: {{ section.settings.transition_speed }}ms;
        --slideshow-duration: {{ section.settings.autoplay_speed }}s;
        --slideshow-controls: {{ section.settings.controls_color }};
        --slideshow-content-width: {{ section.settings.content_width }}px;
        --slide-count: {{ slide_count | at_least: 1 }};
      "
    >
      <div class="slideshow__track">
        {%- for block in section.blocks -%}
          {%- liquid
            case block.settings.content_position_horizontal
              when 'left'
                assign h_align = 'flex-start'
              when 'right'
                assign h_align = 'flex-end'
              else
                assign h_align = 'center'
            endcase
            case block.settings.content_position_vertical
              when 'top'
                assign v_align = 'flex-start'
              when 'bottom'
                assign v_align = 'flex-end'
              else
                assign v_align = 'center'
            endcase
            assign show_video = false
            if block.settings.media_type == 'video'
              assign show_video = true
            endif
            assign eager = false
            if forloop.first and section.index == 1
              assign eager = true
            endif
            assign placeholder_name = 'lifestyle-1'
            assign odd = forloop.index | modulo: 2
            if odd == 0
              assign placeholder_name = 'lifestyle-2'
            endif
          -%}
          <div
            class="slideshow__slide{% if forloop.first %} is-active{% endif %} color-{{ block.settings.color_scheme.id }}"
            data-slide
            role="group"
            aria-roledescription="{{ 'slideshow.slide' | t }}"
            aria-label="{{ 'slideshow.slide_of' | t: index: forloop.index, count: slide_count }}"
            {% unless forloop.first %}
              aria-hidden="true" inert
            {% endunless %}
            style="
              --slide-overlay: {{ block.settings.overlay_color }};
              --slide-overlay-opacity: {{ block.settings.overlay_opacity }}%;
              --slide-align: {{ h_align }};
              --slide-justify: {{ v_align }};
              --slide-text-align: {{ block.settings.content_position_horizontal }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="slideshow__media">
              {% render 'banner-media',
                image: block.settings.image,
                mobile_image: block.settings.mobile_image,
                show_video: show_video,
                video: block.settings.video,
                mobile_video: block.settings.mobile_video,
                video_url: block.settings.video_url,
                alt: block.settings.heading,
                eager: eager,
                placeholder: placeholder_name
              %}
            </div>
            <div class="slideshow__overlay" aria-hidden="true"></div>

            {%- if block.settings.full_link and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="slideshow__link" tabindex="-1" aria-hidden="true"></a>
            {%- endif -%}

            <div class="slideshow__inner page-width">
              <div class="slideshow__content">
                {%- if block.settings.subheading != blank -%}
                  <p class="slideshow__subheading">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <{{ heading_tag }} class="{{ heading_class }} slideshow__heading{% if section.settings.heading_uppercase %} slideshow__heading--uppercase{% endif %}">
                    {{- block.settings.heading | escape -}}
                  </{{ heading_tag }}>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="slideshow__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                  <div class="slideshow__buttons">
                    {%- if block.settings.button_label != blank -%}
                      <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="button button--{{ section.settings.button_style }} slideshow__button"
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        href="{{ block.settings.button_link_2 | default: '#' }}"
                        class="button button--{{ section.settings.button_style_2 }} slideshow__button"
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if arrows and section.settings.arrow_position == 'sides' -%}
        <div class="slideshow__arrows slideshow__arrows--sides">{{ arrow_buttons }}</div>
      {%- endif -%}

      {%- if pagination != 'none' or arrows and section.settings.arrow_position == 'bottom' -%}
        <div class="slideshow__controls page-width">
          {%- if arrows and section.settings.arrow_position == 'bottom' -%}
            <div class="slideshow__arrows slideshow__arrows--bottom">{{ arrow_buttons }}</div>
          {%- endif -%}

          {%- case pagination -%}
            {%- when 'dots' or 'numbers' or 'bars' -%}
              <div class="slideshow__pagination slideshow__pagination--{{ pagination }}">
                {%- for block in section.blocks -%}
                  <button
                    type="button"
                    class="slideshow__page{% if forloop.first %} is-active{% endif %}"
                    data-slide-to="{{ forloop.index0 }}"
                    aria-label="{{ 'slideshow.go_to' | t: index: forloop.index }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                  >
                    {%- if pagination == 'numbers' -%}
                      {%- if forloop.index < 10 %}0{% endif -%}
                      {{- forloop.index -}}
                    {%- elsif pagination == 'bars' -%}
                      <span class="slideshow__bar-fill"></span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- when 'fraction' -%}
              <p class="slideshow__pagination slideshow__pagination--fraction" aria-live="polite">
                <span data-slide-current>1</span>
                <span class="slideshow__fraction-sep" aria-hidden="true">/</span>
                <span>{{ slide_count }}</span>
              </p>
            {%- when 'progress' -%}
              <div class="slideshow__pagination slideshow__pagination--progress" aria-hidden="true">
                <span class="slideshow__progress-fill"></span>
              </div>
          {%- endcase -%}
        </div>
      {%- endif -%}
    </slide-show>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
