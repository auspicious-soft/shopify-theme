          "value": "dots",
          "label": "t:sections.slideshow.pagination_dots"
        },
        {
          "value": "numbers",
          "label": "t:sections.slideshow.pagination_numbers"
        },
        {
          "value": "fraction",
          "label": "t:sections.slideshow.pagination_fraction"
