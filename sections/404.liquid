{% comment %}
  404 page (templates/404.json): a large "404", heading and message, a
  search box, buttons back to the shop / home, an optional menu of quick
  links and optional product suggestions. Styles live in assets/404.css.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{{ '404.css' | asset_url | stylesheet_tag }}
{%- if section.settings.products_collection != blank -%}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-card.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign button_url = section.settings.button_url | default: routes.all_products_collection_url
-%}

<div
  class="not-found not-found--{{ section.settings.alignment }} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', class: 'page-breadcrumbs not-found__breadcrumbs' %}{%- endif -%}

    <div class="not-found__content">
      {%- if section.settings.show_code -%}
        <p class="not-found__code" aria-hidden="true">404</p>
      {%- endif -%}

      <{{ heading_tag }} class="{{ heading_class }} not-found__heading">
        {%- if section.settings.heading != blank -%}
          {{- section.settings.heading | escape -}}
        {%- else -%}
          {{- '404.heading' | t -}}
        {%- endif -%}
      </{{ heading_tag }}>

      <div class="not-found__text">
        {%- if section.settings.text != blank -%}
          {{- section.settings.text -}}
        {%- else -%}
          <p>{{ '404.text' | t }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search">
          <label for="NotFoundSearch-{{ section.id }}" class="visually-hidden">{{ 'search.title' | t }}</label>
          <input
            id="NotFoundSearch-{{ section.id }}"
            class="not-found__search-input"
            type="search"
            name="q"
            placeholder="{{ '404.search_placeholder' | t }}"
            autocomplete="off"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="not-found__search-submit" aria-label="{{ 'search.submit' | t }}">
            {{ 'icon-search.svg' | inline_asset_content }}
          </button>
        </form>
      {%- endif -%}

      <div class="not-found__buttons">
        <a href="{{ button_url }}" class="button button--primary">
          {%- if section.settings.button_label != blank -%}
            {{- section.settings.button_label | escape -}}
          {%- else -%}
            {{- '404.back_to_shopping' | t -}}
          {%- endif -%}
        </a>
        {%- if section.settings.show_home_button -%}
          <a href="{{ routes.root_url }}" class="button button--secondary">{{ '404.back_home' | t }}</a>
        {%- endif -%}
      </div>

      {%- assign menu = section.settings.menu -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        <nav class="not-found__links" aria-label="{{ section.settings.menu_heading | default: menu.title | escape }}">
          {%- if section.settings.menu_heading != blank -%}
            <p class="not-found__links-heading">{{ section.settings.menu_heading | escape }}</p>
          {%- endif -%}
          <ul class="not-found__links-list" role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}" class="not-found__link">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- assign suggestions = section.settings.products_collection -%}
    {%- if suggestions != blank and suggestions.products_count > 0 -%}
      <div class="not-found__products">
        <h2 class="h4 not-found__products-heading">
          {%- if section.settings.products_heading != blank -%}
            {{- section.settings.products_heading | escape -}}
          {%- else -%}
            {{- 'search.popular_products' | t -}}
          {%- endif -%}
        </h2>
        <ul class="not-found__products-grid" role="list" style="--not-found-columns: {{ section.settings.products_count | at_most: 4 }};">
          {%- for product in suggestions.products limit: section.settings.products_count -%}
            <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.breadcrumbs.show",
      "info": "t:sections.breadcrumbs.show_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_code",
      "label": "t:sections.not_found.show_code",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.not_found.heading_info"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:sections.not_found.text_info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.not_found.actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.not_found.show_search",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.not_found.button_label",
      "info": "t:sections.not_found.button_label_info"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.not_found.button_url",
      "info": "t:sections.not_found.button_url_info"
    },
    {
      "type": "checkbox",
      "id": "show_home_button",
      "label": "t:sections.not_found.show_home_button",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.not_found.menu",
      "info": "t:sections.not_found.menu_info"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "t:sections.not_found.menu_heading",
      "default": "Popular pages"
    },
    {
      "type": "header",
      "content": "t:sections.not_found.products"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "t:sections.not_found.products_collection",
      "info": "t:sections.not_found.products_collection_info"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "t:sections.not_found.products_heading",
      "info": "t:sections.not_found.products_heading_info"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "t:sections.not_found.products_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.products_collection != blank }}"
    },
    {
      "type": "header",
      "content": "t:general.section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:labels.button_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:options.button_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.button_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.button_size.large"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.text_case"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "default": "uppercase",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ]
    }
  ]
}
{% endschema %}
