{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{{ 'page.css' | asset_url | stylesheet_tag }}

<div class="main-page main-page--align-{{ section.settings.alignment | default: 'left' }} page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}"
  style="{% render 'section-padding-vars', section: section %}"
>
  {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
  {%- assign heading_class = section.settings.heading_class | default: heading_tag -%}
  {%- comment -%} Breadcrumbs first, at the top of the page. {%- endcomment -%}
  {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', class: 'page-breadcrumbs' %}{%- endif -%}
  {%- comment -%} A hidden title stays in the page for search engines and screen readers. {%- endcomment -%}
  <{{ heading_tag }} class="{% if section.settings.show_title == false %}visually-hidden{% else %}{{ heading_class }} main-page__title{% endif %}">{{ page.title }}</{{ heading_tag }}>

  {{ page.content }}
</div>

{% render 'text-case', section: section %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.breadcrumbs.show",
      "info": "t:sections.breadcrumbs.show_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.page.show_title",
      "info": "t:sections.page.show_title_info",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1",
      "visible_if": "{{ section.settings.show_title }}"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h1",
      "visible_if": "{{ section.settings.show_title }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.page.title_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "mobile_padding_custom",
      "label": "t:labels.mobile_padding_custom",
      "info": "t:labels.mobile_padding_custom_info",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:labels.mobile_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:labels.mobile_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.mobile_padding_custom }}"
    },
    {
      "type": "header",
      "content": "t:labels.text_case"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ]
}
{% endschema %}
