{% comment %}
  "Collection banner": one large image promoting a collection, with a small
  subheading, heading, text and button over it (e.g. "New items / Long
  shirts / View products").

  Pick a collection and the banner fills itself in: its image, title and
  link are used wherever the matching setting is left empty. Separate
  mobile image, height, content position, overlay, full or page width,
  and an option to make the whole banner clickable.
{% endcomment %}

{{ 'collection-banner.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign image = section.settings.image | default: collection.featured_image
  assign mobile_image = section.settings.mobile_image | default: image
  assign heading = section.settings.heading | default: collection.title
  assign link = section.settings.button_link | default: collection.url

  case section.settings.content_position_horizontal
    when 'left'
      assign h_align = 'flex-start'
    when 'right'
      assign h_align = 'flex-end'
    else
      assign h_align = 'center'
  endcase

  case section.settings.content_position_vertical
    when 'top'
      assign v_align = 'flex-start'
    when 'middle'
      assign v_align = 'center'
    else
      assign v_align = 'flex-end'
  endcase

  case section.settings.height
    when 'small'
      assign height = '40vh'
    when 'large'
      assign height = '80vh'
    when 'fullscreen'
      assign height = '100svh'
    else
      assign height = '60vh'
  endcase

  case section.settings.mobile_height
    when 'small'
      assign mobile_height = '50vh'
    when 'large'
      assign mobile_height = '85vh'
    else
      assign mobile_height = '65vh'
  endcase

  assign show_video = false
  if section.settings.media_type == 'video'
    assign show_video = true
  endif

  assign ratio = image.aspect_ratio | default: 1.78
  assign mobile_ratio = mobile_image.aspect_ratio | default: 0.8
  if show_video and section.settings.video != blank
    assign ratio = section.settings.video.aspect_ratio | default: ratio
    assign mobile_ratio = section.settings.video.aspect_ratio | default: mobile_ratio
  endif
  if show_video and section.settings.mobile_video != blank
    assign mobile_ratio = section.settings.mobile_video.aspect_ratio | default: mobile_ratio
  endif
-%}

<div
  class="promo-banner-section color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="{% if section.settings.width == 'page' %}page-width{% endif %}">
    <div
      class="promo-banner promo-banner--{{ section.settings.height }} promo-banner--mobile-{{ section.settings.mobile_height }}{% if section.settings.zoom_on_hover %} promo-banner--zoom{% endif %}"
      style="
        --promo-height: {{ height }};
        --promo-height-mobile: {{ mobile_height }};
        --promo-ratio: {{ ratio }};
        --promo-ratio-mobile: {{ mobile_ratio }};
        --promo-radius: {{ section.settings.corner_radius }}px;
        --promo-text: {{ section.settings.text_color }};
        --promo-overlay: {{ section.settings.overlay_color }};
        --promo-overlay-opacity: {{ section.settings.overlay_opacity }}%;
        --promo-align: {{ h_align }};
        --promo-justify: {{ v_align }};
        --promo-text-align: {{ section.settings.content_position_horizontal }};
        --promo-content-width: {{ section.settings.content_width }}px;
      "
    >
      <div class="promo-banner__media">
        {% render 'banner-media',
          image: image,
          mobile_image: section.settings.mobile_image,
          show_video: show_video,
          video: section.settings.video,
          mobile_video: section.settings.mobile_video,
          video_url: section.settings.video_url,
          alt: heading,
          placeholder: 'lifestyle-2'
        %}
      </div>

      <div class="promo-banner__overlay" aria-hidden="true"></div>

      {%- if section.settings.full_link and link != blank -%}
        <a href="{{ link }}" class="promo-banner__link" tabindex="-1" aria-hidden="true"></a>
      {%- endif -%}

      <div class="promo-banner__inner">
        <div class="promo-banner__content">
          {%- if section.settings.subheading != blank -%}
            <p class="promo-banner__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if heading != blank -%}
            {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
            {%- assign heading_class = section.settings.heading_class | default: heading_tag -%}
            <{{ heading_tag }} class="{{ heading_class }} promo-banner__heading{% if section.settings.heading_uppercase %} promo-banner__heading--uppercase{% endif %}">
              {{- heading | escape -}}
            </{{ heading_tag }}>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="promo-banner__text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank and link != blank -%}
            <a
              href="{{ link }}"
              class="button button--{{ section.settings.button_style }} promo-banner__button promo-banner__button--{{ section.settings.button_size }} color-{{ section.settings.button_color_scheme.id }}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.collection_banner.collection",
      "info": "t:sections.collection_banner.collection_info"
    },
    {
      "type": "header",
      "content": "t:sections.collection_banner.header_image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.collection_banner.image",
      "info": "t:sections.collection_banner.image_info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.collection_banner.mobile_image",
      "info": "t:sections.collection_banner.mobile_image_info"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:labels.media_type",
      "options": [
        { "value": "image", "label": "t:options.media_type.image" },
        { "value": "video", "label": "t:options.media_type.video" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "info": "t:labels.video_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "info": "t:labels.mobile_video_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube","vimeo"],
      "label": "t:labels.video_url",
      "info": "t:labels.video_url_info",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.collection_banner.height",
      "options": [
        { "value": "adapt", "label": "t:options.height_type.adapt" },
        { "value": "small", "label": "t:options.height_type.small" },
        { "value": "medium", "label": "t:options.height_type.medium" },
        { "value": "large", "label": "t:options.height_type.large" },
        { "value": "fullscreen", "label": "t:options.height_type.fullscreen" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:sections.collection_banner.mobile_height",
      "options": [
        { "value": "adapt", "label": "t:options.height_type.adapt" },
        { "value": "small", "label": "t:options.height_type.small" },
        { "value": "medium", "label": "t:options.height_type.medium" },
        { "value": "large", "label": "t:options.height_type.large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:sections.collection_banner.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "zoom_on_hover",
      "label": "t:sections.collection_banner.zoom_on_hover",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:labels.content_settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "New items"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.collection_banner.heading_info",
      "default": "Long shirts"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        { "value": "h6", "label": "t:options.heading_size.extra_small" },
        { "value": "h5", "label": "t:options.heading_size.small" },
        { "value": "h4", "label": "t:options.heading_size.medium" },
        { "value": "h3", "label": "t:options.heading_size.large" },
        { "value": "h2", "label": "t:options.heading_size.extra_large" },
        { "value": "h1", "label": "t:options.heading_size.huge" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "t:sections.collection_banner.heading_uppercase",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_position_horizontal",
      "label": "t:labels.content_position_horizontal",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_vertical",
      "label": "t:labels.content_position_vertical",
      "options": [
        { "value": "top", "label": "t:options.vertical_position.top" },
        { "value": "middle", "label": "t:options.vertical_position.middle" },
        { "value": "bottom", "label": "t:options.vertical_position.bottom" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.collection_banner.content_width",
      "min": 240,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "header",
      "content": "t:labels.button_settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_text",
      "info": "t:sections.collection_banner.button_label_info",
      "default": "View products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_url",
      "info": "t:sections.collection_banner.button_link_info"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "primary", "label": "t:options.button_style.primary" },
        { "value": "secondary", "label": "t:options.button_style.secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.collection_banner.button_size",
      "options": [
        { "value": "small", "label": "t:sections.collection_banner.size_small" },
        { "value": "medium", "label": "t:sections.collection_banner.size_medium" }
      ],
      "default": "small"
    },
    {
      "type": "color_scheme",
      "id": "button_color_scheme",
      "label": "t:sections.collection_banner.button_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_link",
      "label": "t:sections.collection_banner.full_link",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_banner.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_banner.name"
    }
  ]
}
{% endschema %}
