{% comment %}
  Blog page (templates/blog.json): the blog title and an optional intro,
  a row of tag filters (All / each tag, using Shopify's /tagged/ URLs),
  then the articles as a grid or list with numbered pagination.

  "Feature the first article" shows the newest article above the others on
  page 1 (grid layout, on every tag tab too), either as a large card or as
  an editorial "story": label, title, the excerpt as a pull quote, the
  opening of the article, date and reading time, beside the image.

  The featured article is the newest post, or the newest post with a chosen
  tag (e.g. "featured"); that tag is left out of the filter and card topics.
  It's looked up in the whole blog, so it stays the same on every tag tab.
  The tag filter (pills or underlined text tabs) sits below the featured
  article, above the grid.
  Cards come from snippets/article-card.liquid and follow Theme settings >
  Blog cards.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{{ 'blog.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}
{{ 'pagination.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout
  assign columns = section.settings.columns_desktop
  if layout == 'list'
    assign columns = 1
  endif
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 750px) 50vw, 100vw'
  if layout == 'list'
    assign card_sizes = '(min-width: 750px) 40vw, 100vw'
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign card_heading_tag = 'h2'
-%}

<div
  class="blog blog--align-{{ section.settings.heading_alignment }} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --blog-columns: {{ columns }};
    --blog-columns-mobile: {{ section.settings.columns_mobile }};
    --blog-gap: {{ section.settings.gap }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {%- if section.settings.show_title or section.settings.show_breadcrumbs or section.settings.description != blank and current_tags == blank -%}
    <header class="blog__header">
      {%- if section.settings.show_title -%}
        <{{ heading_tag }} class="{{ heading_class }} blog__title">
          {%- if current_tags -%}
            {{ current_tags.first | escape }}
          {%- else -%}
            {{ blog.title | escape }}
          {%- endif -%}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', class: 'blog__breadcrumbs' %}{%- endif -%}
      {%- if section.settings.description != blank and current_tags == blank -%}
        <div class="blog__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>
    {%- endif -%}

    {%- liquid
      # On a tag page blog.articles only holds that tag's posts, so the
      # featured article comes from the whole blog.
      assign all_articles = blogs[blog.handle].articles | default: blog.articles

      # Featured article chosen by tag: the newest article carrying it.
      assign featured_tag_name = ''
      assign featured_tag_key = ''
      assign tagged_feature = nil
      if section.settings.featured_source == 'tag' and section.settings.featured_tag != blank
        assign featured_tag_name = section.settings.featured_tag | strip
        assign featured_tag_key = featured_tag_name | downcase
        for candidate in all_articles
          for candidate_tag in candidate.tags
            assign candidate_key = candidate_tag | downcase
            if candidate_key == featured_tag_key
              assign tagged_feature = candidate
              break
            endif
          endfor
          if tagged_feature
            break
          endif
        endfor
      endif
    -%}

    {%- capture tag_filter -%}
    {%- if section.settings.show_tag_filter and blog.all_tags.size > 0 -%}
      <nav class="blog__tags blog__tags--{{ section.settings.tag_style | default: 'pills' }}" aria-label="{{ 'blog.filter_by_tag' | t }}">
        <ul class="blog__tag-list" role="list">
          <li>
            <a
              href="{{ blog.url }}"
              class="blog__tag{% if current_tags == blank %} is-active{% endif %}"
              {% if current_tags == blank %}aria-current="page"{% endif %}
            >
              {%- if section.settings.all_label != blank -%}
                {{- section.settings.all_label | escape -}}
              {%- else -%}
                {{- 'blog.all' | t -}}
              {%- endif -%}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            {%- assign tag_key = tag | downcase -%}
            {%- if featured_tag_key != blank and tag_key == featured_tag_key -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign active = false -%}
            {%- if current_tags contains tag -%}
              {%- assign active = true -%}
            {%- endif -%}
            <li>
              <a
                href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                class="blog__tag{% if active %} is-active{% endif %}"
                {% if active %}aria-current="page"{% endif %}
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    {%- endcapture -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- liquid
        assign featured_first = false
        if section.settings.feature_first and layout == 'grid' and paginate.current_page == 1
          assign featured_first = true
        endif
        assign feature = all_articles.first | default: blog.articles.first
        if tagged_feature
          assign feature = tagged_feature
        endif
      -%}

      {%- if blog.articles.size > 0 -%}
        {%- if featured_first and section.settings.featured_style == 'story' -%}
          {%- liquid
            assign feature_words = feature.content | strip_html | split: ' ' | size
            assign feature_minutes = feature_words | plus: 199 | divided_by: 200 | at_least: 1
            # With the blog title hidden, the story title is the page's main heading.
            assign feature_tag = 'h2'
            unless section.settings.show_title
              assign feature_tag = 'h1'
            endunless
          -%}
          <article
            class="blog-feature blog-feature--image-{{ section.settings.featured_image_position }}{% unless feature.image %} blog-feature--no-image{% endunless %}"
            {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}
          >
            <div class="blog-feature__content">
              {%- if section.settings.featured_label != blank -%}
                <p class="blog-feature__label">{{ section.settings.featured_label | escape }}</p>
              {%- endif -%}
              <{{ feature_tag }} class="blog-feature__title{% if section.settings.featured_uppercase %} blog-feature__title--uppercase{% endif %}">
                <a href="{{ feature.url }}">{{ feature.title | escape }}</a>
              </{{ feature_tag }}>
              {%- if feature.excerpt != blank -%}
                <blockquote class="blog-feature__quote">{{ feature.excerpt | strip_html | truncatewords: 45 }}</blockquote>
              {%- endif -%}
              {%- if section.settings.featured_words > 0 -%}
                <p class="blog-feature__text">{{ feature.content | strip_html | truncatewords: section.settings.featured_words }}</p>
              {%- endif -%}
              <p class="blog-feature__meta">
                {%- if section.settings.show_date -%}
                  <span class="blog-feature__meta-item">{{ feature.published_at | time_tag: format: 'date' }}</span>
                {%- endif -%}
                {%- if section.settings.show_reading_time -%}
                  <span class="blog-feature__meta-item">{{ 'blog.reading_time' | t: count: feature_minutes }}</span>
                {%- endif -%}
              </p>
            </div>
            {%- if feature.image -%}
              <a href="{{ feature.url }}" class="blog-feature__media" tabindex="-1" aria-hidden="true">
                {{
                  feature.image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'blog-feature__image',
                    widths: '600, 900, 1200, 1500, 1800',
                    sizes: '(min-width: 750px) 60vw, 100vw',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: feature.image.alt
                }}
              </a>
            {%- endif -%}
          </article>
        {%- elsif featured_first -%}
          <div class="blog__featured">
            {% render 'article-card',
              article: feature,
              featured: true,
              image_ratio: section.settings.image_ratio,
              sizes: '(min-width: 750px) 60vw, 100vw',
              show_image: section.settings.show_image,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt,
              excerpt_words: section.settings.excerpt_words,
              show_tags: section.settings.show_card_tags,
              show_topic: section.settings.show_topic,
              skip_tag: featured_tag_name,
              show_reading_time: section.settings.show_reading_time,
              read_more: section.settings.read_more,
              read_more_style: section.settings.read_more_style,
              heading_tag: card_heading_tag,
              zoom: section.settings.zoom_on_hover,
              eager: true
            %}
          </div>
        {%- endif -%}

        {{ tag_filter }}

        {%- capture grid_items -%}
          {%- for article in blog.articles -%}
            {%- if featured_first and article.id == feature.id -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign eager = false
              if forloop.index <= columns and paginate.current_page == 1 and featured_first == false
                assign eager = true
              endif
            -%}
            <li class="blog__item">
              {% render 'article-card',
                article: article,
                image_ratio: section.settings.image_ratio,
                sizes: card_sizes,
                show_image: section.settings.show_image,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_excerpt: section.settings.show_excerpt,
                excerpt_words: section.settings.excerpt_words,
                show_tags: section.settings.show_card_tags,
                show_topic: section.settings.show_topic,
                skip_tag: featured_tag_name,
                show_reading_time: section.settings.show_reading_time,
                read_more: section.settings.read_more,
                read_more_style: section.settings.read_more_style,
                heading_tag: card_heading_tag,
                zoom: section.settings.zoom_on_hover,
                eager: eager
              %}
            </li>
          {%- endfor -%}
        {%- endcapture -%}

        {%- if grid_items != blank -%}
          <ul class="blog__grid blog__grid--{{ layout }}" role="list">
            {{ grid_items }}
          </ul>
        {%- endif -%}

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        {{ tag_filter }}
        <div class="blog__empty">
          {%- if current_tags -%}
            <p>{{ 'blog.no_tagged_articles' | t: tag: current_tags.first }}</p>
            <a href="{{ blog.url }}" class="button button--secondary">{{ 'blog.view_all' | t }}</a>
          {%- else -%}
            <p>{{ 'blog.no_articles' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.blog",
  "class": "section-blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.breadcrumbs.show",
      "info": "t:sections.breadcrumbs.show_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.blog.header_heading"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.blog.show_title",
      "info": "t:sections.blog.show_title_info",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.blog.description",
      "info": "t:sections.blog.description_info"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "t:sections.blog.show_tag_filter",
      "info": "t:sections.blog.show_tag_filter_info",
      "default": true
    },
    {
      "type": "select",
      "id": "tag_style",
      "label": "t:sections.blog.tag_style",
      "options": [
        {
          "value": "pills",
          "label": "t:sections.blog.tag_style_pills"
        },
        {
          "value": "tabs",
          "label": "t:sections.blog.tag_style_tabs"
        }
      ],
      "default": "pills",
      "visible_if": "{{ section.settings.show_tag_filter }}"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "t:sections.blog.all_label",
      "info": "t:sections.blog.all_label_info",
      "visible_if": "{{ section.settings.show_tag_filter }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.blog.layout_grid"
        },
        {
          "value": "list",
          "label": "t:sections.blog.layout_list"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "t:sections.blog.feature_first",
      "info": "t:sections.blog.feature_first_info",
      "default": true
    },
    {
      "type": "select",
      "id": "featured_source",
      "label": "t:sections.blog.featured_source",
      "options": [
        {
          "value": "latest",
          "label": "t:sections.blog.featured_source_latest"
        },
        {
          "value": "tag",
          "label": "t:sections.blog.featured_source_tag"
        }
      ],
      "default": "latest",
      "visible_if": "{{ section.settings.feature_first }}"
    },
    {
      "type": "text",
      "id": "featured_tag",
      "label": "t:sections.blog.featured_tag",
      "info": "t:sections.blog.featured_tag_info",
      "default": "featured",
      "visible_if": "{{ section.settings.feature_first and section.settings.featured_source == 'tag' }}"
    },
    {
      "type": "select",
      "id": "featured_style",
      "label": "t:sections.blog.featured_style",
      "options": [
        {
          "value": "card",
          "label": "t:sections.blog.featured_card"
        },
        {
          "value": "story",
          "label": "t:sections.blog.featured_story"
        }
      ],
      "default": "card",
      "visible_if": "{{ section.settings.feature_first }}"
    },
    {
      "type": "select",
      "id": "featured_image_position",
      "label": "t:sections.blog.featured_image_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.feature_first and section.settings.featured_style == 'story' }}"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "t:sections.blog.featured_label",
      "default": "Featured story",
      "visible_if": "{{ section.settings.feature_first and section.settings.featured_style == 'story' }}"
    },
    {
      "type": "checkbox",
      "id": "featured_uppercase",
      "label": "t:sections.blog.featured_uppercase",
      "default": true,
      "visible_if": "{{ section.settings.feature_first and section.settings.featured_style == 'story' }}"
    },
    {
      "type": "range",
      "id": "featured_words",
      "label": "t:sections.blog.featured_words",
      "info": "t:sections.blog.featured_words_info",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "visible_if": "{{ section.settings.feature_first and section.settings.featured_style == 'story' }}"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:sections.blog.articles_per_page",
      "info": "t:sections.blog.articles_per_page_info",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop",
      "info": "t:sections.blog.columns_info",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.grid_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.blog.header_card"
    },
    {
      "type": "paragraph",
      "content": "t:sections.blog.card_style_info"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.blog.show_image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.blog.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.ratio_adapt"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.ratio_landscape"
        },
        {
          "value": "wide",
          "label": "t:sections.blog.ratio_wide"
        },
        {
          "value": "square",
          "label": "t:sections.all.ratio_square"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.ratio_portrait"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "zoom_on_hover",
      "label": "t:sections.collection_banner.zoom_on_hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.blog.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.blog.show_author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:sections.article.show_reading_time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_topic",
      "label": "t:sections.blog.show_topic",
      "info": "t:sections.blog.show_topic_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog.show_excerpt",
      "default": true
