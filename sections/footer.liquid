{% comment %}
  Site footer (footer group).

  Top: columns built from blocks (Brand, Menu, Text, Newsletter, Social
  icons). Each block has its own desktop column width (% of the row);
  columns wrap onto a new row once they add up to more than 100%.
  Bottom bar: copyright, policy links, "Powered by Shopify" and payment
  icons, each optional.

  Mobile (below 750px): columns stack full width. Menu columns follow
  Footer > Mobile menu style: "accordion" (tap the heading to open) or
  "simple" (always open). On desktop menus are always open; <site-footer>
  keeps the <details> in sync as the viewport crosses the breakpoint.
  Styles live in assets/footer.css.
{% endcomment %}

{{ 'footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign mobile_style = section.settings.mobile_menu_style
-%}

<site-footer
  class="footer color-{{ section.settings.color_scheme.id }}"
  data-mobile-style="{{ mobile_style }}"
  style="
    --footer-padding-top: {{ section.settings.padding_top }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
    --footer-column-gap: {{ section.settings.column_gap }}px;
  "
>
  <footer class="footer__inner {% if section.settings.footer_width == 'full' %}footer__inner--full{% else %}page-width{% endif %}">
    {% if section.blocks.size > 0 %}
      <div class="footer__columns">
        {% for block in section.blocks %}
          <div
            class="footer__column footer__column--{{ block.type }}"
            style="--column-width: {{ block.settings.column_width }};"
            {{ block.shopify_attributes }}
          >
            {% case block.type %}
              {% when 'brand' %}
                {%- liquid
                  assign brand_image = block.settings.image | default: settings.brand_image
                  assign brand_headline = block.settings.headline | default: settings.brand_headline
                  assign brand_text = block.settings.text | default: settings.brand_description
                -%}
                {% if brand_image != blank %}
                  <a href="{{ routes.root_url }}" class="footer__logo" style="--logo-width: {{ block.settings.image_width }}px;">
                    {{
                      brand_image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', widths: '150, 300, 450, 600', sizes: '(min-width: 750px) 15rem, 50vw', alt: shop.name
                    }}
                  </a>
                {% elsif block.settings.show_shop_name %}
                  <a href="{{ routes.root_url }}" class="footer__shop-name">{{ shop.name | escape }}</a>
                {% endif %}
                {% if brand_headline != blank %}
                  <p class="footer__headline">{{ brand_headline }}</p>
                {% endif %}
                {% if brand_text != blank %}
                  <div class="footer__text rte">{{ brand_text }}</div>
                {% endif %}
                {% if block.settings.show_social %}
                  {% render 'social-icons', class: 'footer__social' %}
                {% endif %}

              {% when 'menu' %}
                {%- assign menu = block.settings.menu -%}
                {% if menu != blank and menu.links.size > 0 %}
                  <details class="footer__menu" data-footer-accordion open>
                    <summary class="footer__heading footer__summary">
                      <span>{{ block.settings.heading | default: menu.title | escape }}</span>
                      <span class="footer__plus" aria-hidden="true"></span>
                    </summary>
                    <ul class="footer__links" role="list">
                      {% for link in menu.links %}
                        <li>
                          <a
                            href="{{ link.url }}"
                            class="footer__link"
                            {% if link.current %}aria-current="page"{% endif %}
                          >
                            {{- link.title | escape -}}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </details>
                {% endif %}

              {% when 'text' %}
                {% if block.settings.heading != blank %}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {% endif %}

              {% when 'newsletter' %}
                {%- assign form_id = 'FooterNewsletter-' | append: block.id -%}
                {% if block.settings.heading != blank %}
                  <h2 class="footer__heading footer__heading--large">{{ block.settings.heading | escape }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {% endif %}
                {% form 'customer', id: form_id, class: 'footer__newsletter' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {% if form.posted_successfully? %}
                    <p class="footer__newsletter-message footer__newsletter-message--success" role="status" tabindex="-1" autofocus>
                      {{ 'general.newsletter.success' | t }}
                    </p>
                  {% else %}
                    <div class="footer__newsletter-field">
                      <label for="{{ form_id }}-email" class="visually-hidden">{{ 'general.newsletter.email_label' | t }}</label>
                      <input
                        id="{{ form_id }}-email"
                        type="email"
                        name="contact[email]"
                        class="footer__newsletter-input"
                        placeholder="{{ 'general.newsletter.email_label' | t }}"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        required
                        {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
                      >
                      <button type="submit" class="footer__newsletter-submit" name="commit">
                        {%- if block.settings.button_label != blank -%}
                          <span>{{ block.settings.button_label | escape }}</span>
                        {%- else -%}
                          <span class="visually-hidden">{{ 'general.newsletter.subscribe' | t }}</span>
                        {%- endif -%}
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width, 1.25)" d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5"/></svg>
                      </button>
                    </div>
                    {% if form.errors %}
                      <p id="{{ form_id }}-error" class="footer__newsletter-message footer__newsletter-message--error" role="alert">
                        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                      </p>
                    {% endif %}
                  {% endif %}
                {% endform %}
                {% if block.settings.show_social %}
                  {% render 'social-icons', class: 'footer__social' %}
                {% endif %}

              {% when 'social' %}
                {% if block.settings.heading != blank %}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}
                {% render 'social-icons', class: 'footer__social' %}
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="footer__bottom{% if section.settings.show_divider %} footer__bottom--divider{% endif %}">
      <div class="footer__legal">
        <p class="footer__copyright">
          {%- if section.settings.copyright_text != blank -%}
            {%- assign current_year = 'now' | date: '%Y' -%}
            {{ section.settings.copyright_text | replace: '[year]', current_year }}
          {%- else -%}
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
          {%- endif -%}
          {%- if section.settings.show_powered_by %}
            <span class="footer__powered">{{ powered_by_link }}</span>
          {%- endif -%}
        </p>

        {% if section.settings.show_policies and shop.policies.size > 0 %}
          <ul class="footer__policies" role="list">
            {% for policy in shop.policies %}
              {% if policy.body != blank %}
                <li><a href="{{ policy.url }}" class="footer__policy-link">{{ policy.title | escape }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <ul class="footer__payment" role="list" aria-label="{{ 'general.payment_methods' | t }}">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </footer>
</site-footer>

{% javascript %}
  if (!customElements.get('site-footer')) {
    class SiteFooter extends HTMLElement {
      connectedCallback() {
        this.media = window.matchMedia('(min-width: 750px)');
        this.sync = this.sync.bind(this);
        this.media.addEventListener('change', this.sync);
        this.sync();
      }

      disconnectedCallback() {
        this.media?.removeEventListener('change', this.sync);
      }

      // Desktop, and "simple" on mobile: every menu open. Accordion on
      // mobile: start closed and let the shopper open them.
      sync() {
        const openAll = this.media.matches || this.dataset.mobileStyle !== 'accordion';
        this.querySelectorAll('[data-footer-accordion]').forEach((details) => {
          details.open = openAll;
        });
        this.classList.toggle('footer--accordion', !openAll);
      }
    }

    customElements.define('site-footer', SiteFooter);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "select",
      "id": "footer_width",
      "label": "t:sections.footer.footer_width",
      "info": "t:sections.footer.footer_width_info",
      "options": [
        { "value": "page", "label": "t:sections.footer.footer_width_page" },
        { "value": "full", "label": "t:sections.footer.footer_width_full" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "mobile_menu_style",
      "label": "t:sections.footer.mobile_menu_style",
      "options": [
        { "value": "accordion", "label": "t:sections.footer.mobile_accordion" },
        { "value": "simple", "label": "t:sections.footer.mobile_simple" }
      ],
      "default": "accordion"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:sections.footer.column_gap",
      "min": 16,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.footer.bottom_bar"
    },
    {
      "type": "inline_richtext",
      "id": "copyright_text",
      "label": "t:sections.footer.copyright_text",
      "info": "t:sections.footer.copyright_text_info"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:sections.footer.show_powered_by",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.show_policies",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.footer.show_divider",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "label": "t:sections.footer.column_width",
          "info": "t:sections.footer.column_width_info",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.footer.blocks.brand.image"
        },
        {
          "type": "range",
          "id": "image_width",
          "label": "t:sections.footer.blocks.brand.image_width",
          "min": 50,
          "max": 300,
          "step": 10,
          "unit": "px",
          "default": 140
        },
        {
          "type": "checkbox",
          "id": "show_shop_name",
          "label": "t:sections.footer.blocks.brand.show_shop_name",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "headline",
          "label": "t:sections.footer.blocks.brand.headline"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:sections.footer.show_social",
          "info": "t:sections.footer.show_social_info",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "label": "t:sections.footer.column_width",
          "info": "t:sections.footer.column_width_info",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 15
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "info": "t:sections.footer.blocks.menu.heading_info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "label": "t:sections.footer.column_width",
          "info": "t:sections.footer.column_width_info",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Share your store's contact details, opening hours or a short message.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "label": "t:sections.footer.column_width",
          "info": "t:sections.footer.column_width_info",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.newsletter.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Join our newsletter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Be the first to hear about new arrivals and exclusive offers.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_text",
          "info": "t:sections.footer.blocks.newsletter.button_label_info"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:sections.footer.show_social",
          "info": "t:sections.footer.show_social_info",
          "default": false
        }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "label": "t:sections.footer.column_width",
          "info": "t:sections.footer.column_width_info",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "paragraph",
          "content": "t:sections.footer.show_social_info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Follow us"
        }
      ]
    }
  ]
}
{% endschema %}
