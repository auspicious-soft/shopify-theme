{% comment %}
  Password page (templates/password.json, layout/password.liquid): the
  landing page shown while the store is password protected.

  Full-screen background (image, separate mobile image, or video via
  snippets/banner-media.liquid) under an overlay, with the content centered
  or to one side, plain or on a frosted card:
  logo, subheading, heading, message, an optional launch countdown, an
  email sign-up, social icons, and an "Enter using password" dialog (opened
  automatically when a wrong password was entered).

  Styles: assets/password.css, behavior: assets/password.js.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{{ 'password.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password.js' | asset_url }}" defer></script>

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign logo = section.settings.logo | default: settings.logo
  assign has_background = false
  if section.settings.image != blank or section.settings.video != blank or section.settings.video_url != blank
    assign has_background = true
  endif
  assign newsletter_id = 'PasswordNewsletter-' | append: section.id
  assign countdown_done = section.settings.countdown_done
  if countdown_done == blank
    assign countdown_done = 'password.countdown_done' | t
  endif
-%}

<div
  class="password-page password-page--{{ section.settings.content_position }} password-page--{{ section.settings.content_style }}{% if has_background %} password-page--has-media{% endif %} color-{{ section.settings.color_scheme.id }}"
  style="
    --password-overlay: {{ section.settings.overlay_opacity }}%;
    --password-logo-width: {{ section.settings.logo_width }}px;
  "
>
  {%- if has_background -%}
    <div class="password-page__media" aria-hidden="true">
      {% render 'banner-media',
        image: section.settings.image,
        mobile_image: section.settings.mobile_image,
        show_video: true,
        video: section.settings.video,
        video_url: section.settings.video_url,
        alt: '',
        eager: true
      %}
    </div>
    <div class="password-page__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <header class="password-page__header">
    <a href="{{ routes.root_url }}" class="password-page__logo">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 600
          | image_tag: alt: shop.name, widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 20vw, 40vw', class: 'password-page__logo-image'
        }}
      {%- else -%}
        <span class="password-page__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </header>

  <main class="password-page__main" id="MainContent">
    <div class="password-page__content">
      {%- if section.settings.subheading != blank -%}
        <p class="password-page__subheading{% if section.settings.subheading_letter_spacing != blank and section.settings.subheading_letter_spacing != 'none' %} letter-spacing--{{ section.settings.subheading_letter_spacing }}{% endif %}">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <{{ heading_tag }} class="{{ heading_class }} password-page__heading">
        {%- if section.settings.heading != blank -%}
          {{- section.settings.heading | escape -}}
        {%- else -%}
          {{- 'password.heading' | t -}}
        {%- endif -%}
      </{{ heading_tag }}>

      {%- if section.settings.text != blank -%}
        <div class="password-page__text">{{ section.settings.text }}</div>
      {%- elsif shop.password_message != blank -%}
        <div class="password-page__text"><p>{{ shop.password_message }}</p></div>
      {%- endif -%}

      {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
        <password-countdown
          class="password-page__countdown"
          data-date="{{ section.settings.countdown_date | escape }}"
          data-done="{{ countdown_done | escape }}"
          role="timer"
          aria-label="{{ 'password.countdown_label' | t }}"
          hidden
        >
          {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
          {%- for unit in units -%}
            {%- assign unit_key = 'password.units.' | append: unit -%}
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-value" data-unit="{{ unit }}">00</span>
              <span class="password-page__countdown-label">{{ unit_key | t }}</span>
            </div>
          {%- endfor -%}
        </password-countdown>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="password-page__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <p class="password-page__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</p>
          {%- endif -%}
          {% form 'customer', id: newsletter_id, class: 'password-page__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter, password page">
            {%- if form.posted_successfully? -%}
              <p class="password-page__message password-page__message--success" role="status" tabindex="-1" autofocus>
                {{ 'password.newsletter_success' | t }}
              </p>
            {%- else -%}
              <div class="password-page__field">
                <label for="{{ newsletter_id }}-email" class="visually-hidden">{{ 'general.newsletter.email_label' | t }}</label>
                <input
                  id="{{ newsletter_id }}-email"
                  class="password-page__input"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ 'general.newsletter.email_label' | t }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"{% endif %}
                >
                <button type="submit" class="button button--primary password-page__submit" name="commit">
                  {%- if section.settings.newsletter_button != blank -%}
                    {{- section.settings.newsletter_button | escape -}}
                  {%- else -%}
                    {{- 'password.notify_me' | t -}}
                  {%- endif -%}
                </button>
              </div>
              {%- if form.errors -%}
                <p id="{{ newsletter_id }}-error" class="password-page__message password-page__message--error" role="alert">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {% render 'social-icons', class: 'password-page__social' %}
      {%- endif -%}
    </div>
  </main>

  <footer class="password-page__footer">
    <button type="button" class="password-page__open" data-password-open aria-haspopup="dialog">
      {{ 'icon-lock.svg' | inline_asset_content }}
      <span>{{ 'password.enter_using_password' | t }}</span>
    </button>
    <p class="password-page__powered">
      {{ 'password.store_owner' | t }}
      <a href="/admin" class="password-page__admin">{{ 'password.log_in' | t }}</a>
      <span aria-hidden="true">·</span>
      {{ powered_by_link }}
    </p>
  </footer>

  {%- comment -%} Password dialog {%- endcomment -%}
  <dialog class="password-dialog color-{{ section.settings.dialog_color_scheme.id }}" aria-labelledby="PasswordDialogTitle-{{ section.id }}" data-password-dialog>
    <button type="button" class="password-dialog__close" data-password-close aria-label="{{ 'accessibility.close' | t }}">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
    <h2 id="PasswordDialogTitle-{{ section.id }}" class="h4 password-dialog__title">{{ 'password.enter_store' | t }}</h2>
    {% form 'storefront_password', class: 'password-dialog__form' %}
      {%- if form.errors -%}
        <p class="password-page__message password-page__message--error" role="alert" data-password-error>
          {{ 'password.wrong_password' | t }}
        </p>
      {%- endif -%}
      <label for="PasswordInput-{{ section.id }}" class="visually-hidden">{{ 'password.password' | t }}</label>
      <input
        id="PasswordInput-{{ section.id }}"
        class="password-page__input"
        type="password"
        name="password"
        placeholder="{{ 'password.password' | t }}"
        autocomplete="current-password"
        required
        {% if form.errors %}aria-invalid="true"{% endif %}
      >
      <button type="submit" class="button button--primary password-dialog__submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </dialog>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.password.background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.password.image",
      "info": "t:sections.password.image_info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.password.mobile_image",
      "info": "t:sections.password.mobile_image_info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.password.video",
      "info": "t:sections.password.video_info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.password.video_url",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "t:sections.password.layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.password.content_position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "t:sections.password.content_style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "t:sections.password.content_style_plain"
        },
        {
          "value": "card",
          "label": "t:sections.password.content_style_card"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "dialog_color_scheme",
      "label": "t:sections.password.dialog_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.password.content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.password.logo",
      "info": "t:sections.password.logo_info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.password.logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Coming soon"
    },
    {
      "type": "select",
      "id": "subheading_letter_spacing",
      "label": "t:labels.letter_spacing",
      "options": [
        {
          "value": "none",
          "label": "t:options.letter_spacing.none"
        },
        {
          "value": "small",
          "label": "t:options.letter_spacing.small"
        },
        {
          "value": "medium",
          "label": "t:options.letter_spacing.medium"
        },
        {
          "value": "large",
          "label": "t:options.letter_spacing.large"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.password.heading_info"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:sections.password.text_info"
    },
    {
      "type": "header",
      "content": "t:sections.password.countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "t:sections.password.show_countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "t:sections.password.countdown_date",
      "info": "t:sections.password.countdown_date_info",
      "placeholder": "2026-12-01 09:00",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "countdown_done",
      "label": "t:sections.password.countdown_done",
      "info": "t:sections.password.countdown_done_info",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "header",
      "content": "t:sections.password.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.password.show_newsletter",
      "info": "t:sections.password.show_newsletter_info",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.password.newsletter_heading",
      "default": "Be the first to know when we launch",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "t:sections.password.newsletter_button",
      "info": "t:sections.password.newsletter_button_info",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.password.show_social",
      "info": "t:sections.password.show_social_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:labels.button_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:options.button_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.button_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.button_size.large"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.text_case"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ]
}
{% endschema %}
