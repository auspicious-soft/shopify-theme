{% comment %}
  "Recommended products": products the merchant picks, either a hand-picked
  list or the first products of a collection (a hand-picked list wins when
  both are set). Works on any template. Shows placeholder cards in the
  theme editor until products are chosen. Optional "View all" link to the
  collection.
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'product-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products = section.settings.product_list
  assign view_all_url = blank

  if products == blank or products.size == 0
    assign products = section.settings.collection.products
  endif

  if section.settings.show_view_all and section.settings.collection != blank
    assign view_all_url = section.settings.collection.url
  endif

  assign placeholder_count = 0
  if request.design_mode and products.size == 0
    assign placeholder_count = section.settings.products_to_show
  endif
-%}

{% if products.size > 0 or placeholder_count > 0 %}
  {% render 'product-list',
    section: section,
    products: products,
    view_all_url: view_all_url,
    placeholder_count: placeholder_count
  %}
{% endif %}

{% schema %}
{
  "name": "t:sections.recommended_products.name",
  "class": "section-recommended-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Recommended products"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        { "value": "h6", "label": "t:options.heading_size.extra_small" },
        { "value": "h5", "label": "t:options.heading_size.small" },
        { "value": "h4", "label": "t:options.heading_size.medium" },
        { "value": "h3", "label": "t:options.heading_size.large" },
        { "value": "h2", "label": "t:options.heading_size.extra_large" },
        { "value": "h1", "label": "t:options.heading_size.huge" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.recommended_products.products"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.recommended_products.product_list",
      "info": "t:sections.recommended_products.product_list_info",
      "limit": 12
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.recommended_products.collection",
      "info": "t:sections.recommended_products.collection_info"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.recommended_products.show_view_all",
      "info": "t:sections.recommended_products.show_view_all_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_list.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product_list.layout",
      "options": [
        { "value": "grid", "label": "t:sections.product_list.layout_grid" },
        { "value": "slider", "label": "t:sections.product_list.layout_slider" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.recommended_products.name"
    }
  ]
}
{% endschema %}
