{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart. Always a normal full-page form
  submission so the cart works with JavaScript fully disabled, regardless
  of Theme settings > Cart > Type.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="cart color-{{ section.settings.color_scheme.id }}">
  <h1>{{ 'cart.title' | t }}</h1>

  {% if cart.item_count == 0 %}
    <div class="cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <table class="cart__items">
        {% for item in cart.items %}
          <tr class="cart__item">
            <td>
              {% render 'image', image: item.image, url: item.url, width: 160, height: 160, crop: 'center' %}
            </td>
            <td>
              <p>{{ item.product.title }}</p>
              {% if item.variant.title != 'Default Title' %}
                <p class="cart__item-variant">{{ item.variant.title }}</p>
              {% endif %}
              {% if settings.show_vendor %}
                <p class="cart__item-vendor">{{ item.product.vendor }}</p>
              {% endif %}
              {{ 'cart.remove' | t | link_to: item.url_to_remove }}
            </td>
            <td>
              <label for="updates_{{ item.key }}">{{ 'cart.quantity' | t }}</label>
              <input type="number" id="updates_{{ item.key }}" name="updates[{{ item.key }}]" min="0" value="{{ item.quantity }}">
            </td>
            <td>
              {% render 'price', price: item.final_line_price, compare_at_price: item.original_line_price %}
            </td>
          </tr>
        {% endfor %}
      </table>

      {% if settings.show_cart_note %}
        <label for="cart-note">{{ 'cart.note' | t }}</label>
        <textarea id="cart-note" name="note" placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
      {% endif %}

      <input type="submit" value="{{ 'cart.update' | t }}">

      <div class="cart__footer">
        <div class="cart__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          {% render 'price', price: cart.total_price %}
        </div>
        <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
      </div>
    </form>
  {% endif %}
</div>

{% stylesheet %}
  .cart__items {
    width: 100%;
  }

  .cart__empty {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .cart__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .cart__subtotal {
    display: flex;
    gap: 0.5rem;
    font-weight: bold;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
