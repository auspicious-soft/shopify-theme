{% comment %}
  Cart page (templates/cart.json).

  - Items: image, vendor, title, options, custom properties, selling plan,
    line discounts, unit price, a quantity stepper, line total and remove.
    Quantity / remove / note changes update in place via <cart-page>
    (assets/cart.js, Section Rendering API).
  - Summary (sticky on desktop): free shipping bar, order note, cart
    discounts, subtotal, terms checkbox, checkout, express checkout buttons,
    payment icons and app blocks.
  - Empty: message, continue shopping and, optionally, a few products.

  Always a real form too: with JavaScript off, "Update" and "Check out"
  submit the quantities and note as a normal POST to /cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{{ 'cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer></script>
{%- if cart.item_count == 0 and section.settings.empty_collection != blank -%}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-card.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign continue_url = section.settings.continue_url | default: routes.all_products_collection_url
-%}

<cart-page
  class="cart-page color-{{ section.settings.color_scheme.id }}"
  data-section-id="{{ section.id }}"
  data-updated-message="{{ 'cart.updated' | t | escape }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}" data-cart-page-contents>
    <div class="cart-page__header">
      <{{ heading_tag }} class="{{ heading_class }} cart-page__title">
        {{- 'cart.title' | t -}}
        {%- if cart.item_count > 0 %}
          <span class="cart-page__count">({{ cart.item_count }})</span>
        {%- endif -%}
      </{{ heading_tag }}>
      {%- if section.settings.show_continue_shopping and cart.item_count > 0 -%}
        <a href="{{ continue_url }}" class="cart-page__continue">{{ 'cart.continue_shopping' | t }}</a>
      {%- endif -%}
    </div>

    <p class="visually-hidden" role="status" data-cart-live></p>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <span class="cart-page__empty-icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <p class="cart-page__empty-title">{{ 'cart.empty' | t }}</p>
        <a href="{{ continue_url }}" class="button button--primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>

      {%- assign empty_collection = section.settings.empty_collection -%}
      {%- if empty_collection != blank and empty_collection.products_count > 0 -%}
        <div class="cart-page__suggestions">
          <h2 class="h4 cart-page__suggestions-title">{{ 'cart.recommendations' | t }}</h2>
          <ul class="cart-page__suggestions-grid" role="list">
            {%- for product in empty_collection.products limit: section.settings.empty_products_count -%}
              <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" class="cart-page__layout">
        <div class="cart-page__items">
          <div class="cart-page__columns" aria-hidden="true">
            <span>{{ 'cart.product' | t }}</span>
            <span>{{ 'cart.quantity' | t }}</span>
            <span>{{ 'cart.total' | t }}</span>
          </div>

          <ul class="cart-page__list" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                assign has_properties = false
                for property in item.properties
                  assign first_char = property.first | slice: 0
                  if property.last != blank and first_char != '_'
                    assign has_properties = true
                    break
                  endif
                endfor
                assign rule = item.variant.quantity_rule
                assign step = rule.increment | default: 1
              -%}
              <li
                class="cart-line"
                data-cart-item
                data-key="{{ item.key }}"
                data-quantity="{{ item.quantity }}"
                data-step="{{ step }}"
              >
                <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{
                      item.image
                      | image_url: width: 400
                      | image_tag: loading: 'lazy', widths: '150, 250, 400', sizes: '(min-width: 750px) 8rem, 6rem', alt: item.image.alt
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'cart-line__placeholder' }}
                  {%- endif -%}
                </a>

                <div class="cart-line__details">
                  {%- if settings.show_vendor and item.product.vendor != blank -%}
                    <p class="cart-line__vendor">{{ item.product.vendor }}</p>
                  {%- endif -%}
                  <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>

                  <p class="cart-line__unit-price">
                    {%- if item.original_price > item.final_price -%}
                      <s>{{ item.original_price | money }}</s>
                    {%- endif -%}
                    <span>{{ item.final_price | money }}</span>
                    {%- if item.unit_price_measurement -%}
                      <span class="cart-line__per-unit">
                        ({{ item.unit_price | money }}/
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }})
                      </span>
                    {%- endif -%}
                  </p>

                  {%- unless item.product.has_only_default_variant and has_properties == false -%}
                    <dl class="cart-line__options">
                      {%- unless item.product.has_only_default_variant -%}
                        {%- for option in item.options_with_values -%}
                          <div><dt>{{ option.name }}:</dt> <dd>{{ option.value }}</dd></div>
                        {%- endfor -%}
                      {%- endunless -%}
                      {%- for property in item.properties -%}
                        {%- assign first_char = property.first | slice: 0 -%}
                        {%- unless property.last == blank or first_char == '_' -%}
                          <div>
                            <dt>{{ property.first }}:</dt>
                            <dd>
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                              {%- else -%}
                                {{ property.last }}
                              {%- endif -%}
                            </dd>
                          </div>
                        {%- endunless -%}
                      {%- endfor -%}
                    </dl>
                  {%- endunless -%}

                  {%- if item.selling_plan_allocation -%}
                    <p class="cart-line__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- if item.line_level_discount_allocations != empty -%}
                    <ul class="cart-line__discounts" role="list">
                      {%- for allocation in item.line_level_discount_allocations -%}
                        <li>{{ allocation.discount_application.title }} (−{{ allocation.amount | money }})</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="cart-line__quantity">
                  <div class="quantity-stepper">
                    <button type="button" class="quantity-stepper__button" data-qty-decrease aria-label="{{ 'cart.decrease_quantity' | t }}">
                      {{ 'icon-minus.svg' | inline_asset_content }}
                    </button>
                    <input
                      id="CartQuantity-{{ section.id }}-{{ forloop.index }}"
                      class="quantity-stepper__input"
                      type="number"
                      inputmode="numeric"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      step="{{ step }}"
                      {% if rule.max %}max="{{ rule.max }}"{% endif %}
                      data-qty-input
                      aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}"
                    >
                    <button type="button" class="quantity-stepper__button" data-qty-increase aria-label="{{ 'cart.increase_quantity' | t }}">
                      {{ 'icon-plus.svg' | inline_asset_content }}
                    </button>
                  </div>
                  <a
                    href="{{ item.url_to_remove }}"
                    class="cart-line__remove"
                    data-remove-item
                    aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}"
                  >
                    {{- 'cart.remove' | t -}}
                  </a>
                </div>

                <div class="cart-line__total">
                  {% render 'price', price: item.final_line_price, compare_at_price: item.original_line_price %}
                </div>

                <p class="cart-line__error" data-item-error role="alert" hidden></p>
              </li>
            {%- endfor -%}
          </ul>

          <noscript>
            <button type="submit" name="update" class="button button--secondary cart-page__update">{{ 'cart.update' | t }}</button>
          </noscript>
        </div>

        <aside class="cart-summary{% if section.settings.sticky_summary %} cart-summary--sticky{% endif %} color-{{ section.settings.summary_color_scheme.id }}" aria-labelledby="CartSummary-{{ section.id }}">
          <h2 id="CartSummary-{{ section.id }}" class="h5 cart-summary__title">{{ 'cart.order_summary' | t }}</h2>

          {%- if section.settings.show_free_shipping -%}
            {% render 'cart-free-shipping' %}
          {%- endif -%}

          {%- if settings.show_cart_note -%}
            <details class="cart-summary__note"{% if cart.note != blank %} open{% endif %}>
              <summary>
                <span>{{ 'cart.note' | t }}</span>
                <span class="cart-summary__note-icon" aria-hidden="true"></span>
              </summary>
              <label for="CartNote-{{ section.id }}" class="visually-hidden">{{ 'cart.note' | t }}</label>
              <textarea
                id="CartNote-{{ section.id }}"
                class="cart-summary__note-input"
                name="note"
                rows="3"
                data-cart-note
                placeholder="{{ 'cart.note_placeholder' | t }}"
              >{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          <dl class="cart-summary__totals">
            {%- if cart.cart_level_discount_applications != empty -%}
              <div class="cart-summary__row">
                <dt>{{ 'cart.items_subtotal' | t }}</dt>
                <dd>{{ cart.items_subtotal_price | money }}</dd>
              </div>
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row cart-summary__row--discount">
                  <dt>{{ discount.title }}</dt>
                  <dd>−{{ discount.total_allocated_amount | money }}</dd>
                </div>
              {%- endfor -%}
            {%- endif -%}
            <div class="cart-summary__row cart-summary__row--total">
              <dt>{{ 'cart.subtotal' | t }}</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
          </dl>
          <p class="cart-summary__taxes">{{ 'cart.taxes_and_shipping' | t }}</p>

          {%- if section.settings.show_terms -%}
            <label class="cart-summary__terms">
              <input type="checkbox" name="attributes[Terms accepted]" value="Yes" required data-cart-terms>
              <span>
                {%- if section.settings.terms_page != blank -%}
                  {{ 'cart.terms_html' | t: url: section.settings.terms_page.url }}
                {%- else -%}
                  {{ 'cart.terms_plain' | t }}
                {%- endif -%}
              </span>
            </label>
            <p class="cart-summary__terms-error" data-terms-error role="alert" hidden>{{ 'cart.terms_error' | t }}</p>
          {%- endif -%}

          <button type="submit" name="checkout" class="button button--primary cart-summary__checkout" data-cart-checkout>
            {{- 'cart.checkout' | t -}}
          </button>

          {%- if section.settings.show_dynamic_checkout and additional_checkout_buttons -%}
            <div class="cart-summary__express">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}

          {%- if section.settings.summary_text != blank -%}
            <div class="cart-summary__text">{{ section.settings.summary_text }}</div>
          {%- endif -%}

          {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="cart-summary__payment" role="list" aria-label="{{ 'general.payment_methods' | t }}">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'cart-summary__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
        </aside>
      </form>
    {%- endif -%}
  </div>
</cart-page>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:general.cart",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_continue_shopping",
      "label": "t:sections.cart.show_continue_shopping",
      "default": true
    },
    {
      "type": "url",
      "id": "continue_url",
      "label": "t:sections.cart.continue_url",
      "info": "t:sections.cart.continue_url_info"
    },
    {
      "type": "header",
      "content": "t:sections.cart.summary"
    },
    {
      "type": "checkbox",
      "id": "sticky_summary",
      "label": "t:sections.cart.sticky_summary",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "summary_color_scheme",
      "label": "t:sections.cart.summary_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
      "label": "t:sections.cart.show_free_shipping",
      "info": "t:sections.cart.show_free_shipping_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "t:sections.cart.show_terms",
      "info": "t:sections.cart.show_terms_info",
      "default": false
    },
    {
      "type": "page",
      "id": "terms_page",
      "label": "t:sections.cart.terms_page"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.cart.show_dynamic_checkout",
      "info": "t:sections.cart.show_dynamic_checkout_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.cart.show_payment_icons",
      "default": true
    },
    {
      "type": "richtext",
      "id": "summary_text",
      "label": "t:sections.cart.summary_text",
      "info": "t:sections.cart.summary_text_info"
    },
    {
      "type": "header",
      "content": "t:sections.cart.empty_cart"
    },
    {
      "type": "collection",
      "id": "empty_collection",
      "label": "t:sections.cart.empty_collection",
      "info": "t:sections.cart.empty_collection_info"
    },
    {
      "type": "range",
      "id": "empty_products_count",
      "label": "t:sections.cart.empty_products_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.empty_collection != blank }}"
    },
    {
      "type": "header",
      "content": "t:general.section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:options.section_width.full"
        },
        {
          "value": "page",
          "label": "t:options.section_width.page"
        }
      ],
      "default": "page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:labels.button_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:options.button_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.button_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.button_size.large"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.text_case"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ]
}
{% endschema %}
