{% comment %}
  "Recently viewed": the products this shopper looked at most recently.

  Product pages record each viewed product's handle in localStorage
  (`theme:recently-viewed`, see <product-page> in sections/product.liquid).
  This section reads that list, skips the product currently being viewed,
  and fetches each card from sections/recently-viewed-card.liquid, so the
  cards match every other product card. It stays hidden until there's
  something to show (in the theme editor it shows placeholder cards).
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'product-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
<script src="{{ 'slider.js' | asset_url }}" defer></script>
<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>

{%- liquid
  assign no_products = '' | split: ','
  assign current_handle = ''
  if template.name == 'product'
    assign current_handle = product.handle
  endif

  assign placeholder_count = 0
  if request.design_mode
    assign placeholder_count = section.settings.products_to_show
  endif
-%}

<recently-viewed
  data-current-handle="{{ current_handle | escape }}"
  data-limit="{{ section.settings.products_to_show }}"
  {% unless request.design_mode %}hidden{% endunless %}
>
  {% render 'product-list',
    section: section,
    products: no_products,
    placeholder_count: placeholder_count,
    show_clear: section.settings.show_clear
  %}
</recently-viewed>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
