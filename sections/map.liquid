{% comment %}
  "Map": shows an address on an embedded Google Map (no API key needed),
  with an optional info card (caption, heading, text and a "Get directions"
  button) over the map or beside it.

  - Address: any address or place name Google Maps understands.
  - Zoom, map height (desktop and mobile), corner radius, black & white map.
  - Card: over the map (left / right) or beside it, or hidden.

  The map loads lazily (only when scrolled near) and isn't loaded in the
  theme editor's section preview thumbnails. Styles: assets/map.css.
{% endcomment %}

{{ 'map.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign address = section.settings.address | strip
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: 'h3'
  assign encoded = address | url_encode
  assign directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: encoded
  assign show_card = false
  if section.settings.card_position != 'none'
    if section.settings.caption != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.show_directions
      assign show_card = true
    endif
  endif
-%}

<div
  class="map-section map-section--card-{{ section.settings.card_position }}{% if section.settings.grayscale %} map-section--grayscale{% endif %} color-{{ section.settings.color_scheme.id }}"
  style="
    {% render 'section-padding-vars', section: section %}
    --map-height: {{ section.settings.height }}px;
    --map-height-mobile: {{ section.settings.mobile_height }}px;
    --map-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    <div class="map-section__layout">
      <div class="map-section__map">
        {%- if address != blank -%}
          <iframe
            class="map-section__frame"
            src="https://maps.google.com/maps?q={{ encoded }}&z={{ section.settings.zoom }}&output=embed"
            title="{{ 'sections.map.map_of' | t: address: address | escape }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <div class="map-section__empty">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'map-section__placeholder' }}
            {%- if request.design_mode -%}
              <p class="map-section__empty-text">{{ 'sections.map.add_address' | t }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if show_card -%}
        <div class="map-section__card color-{{ section.settings.card_color_scheme.id }}">
          {%- if section.settings.caption != blank -%}
            <p class="map-section__caption">{{ section.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} class="{{ heading_class }} map-section__heading">{{ section.settings.heading }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="map-section__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.show_directions and address != blank -%}
            <a href="{{ directions_url }}" class="button button--{{ section.settings.button_style }} map-section__button" target="_blank" rel="noopener">
              {{- section.settings.button_label | default: 'Get directions' | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:sections.map.name",
  "tag": "section",
  "class": "section-map",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.map.header_map"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:sections.map.address",
      "info": "t:sections.map.address_info",
      "default": "725 5th Ave, New York, NY 10022, USA"
    },
    {
      "type": "range",
      "id": "zoom",
      "label": "t:sections.map.zoom",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:sections.map.height",
      "min": 240,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.map.mobile_height",
      "min": 200,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:sections.map.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "t:sections.map.grayscale",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.map.header_card"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "t:sections.map.card_position",
      "default": "overlay-left",
      "options": [
        {
          "value": "overlay-left",
          "label": "t:sections.map.card_overlay_left"
        },
        {
          "value": "overlay-right",
          "label": "t:sections.map.card_overlay_right"
        },
        {
          "value": "side-left",
          "label": "t:sections.map.card_side_left"
        },
        {
          "value": "side-right",
          "label": "t:sections.map.card_side_right"
        },
        {
          "value": "none",
          "label": "t:sections.map.card_none"
        }
      ]
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption",
      "default": "Visit us"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our store"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        {
          "value": "h6",
          "label": "t:options.heading_size.extra_small"
        },
        {
          "value": "h5",
          "label": "t:options.heading_size.small"
        },
        {
          "value": "h4",
          "label": "t:options.heading_size.medium"
        },
        {
          "value": "h3",
          "label": "t:options.heading_size.large"
        },
        {
          "value": "h2",
          "label": "t:options.heading_size.extra_large"
        },
        {
          "value": "h1",
          "label": "t:options.heading_size.huge"
        }
      ],
      "default": "h4"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>725 5th Ave, New York, NY 10022, USA</p><p>Mon–Fri: 10:00 – 18:00</p>"
    },
    {
      "type": "checkbox",
      "id": "show_directions",
      "label": "t:sections.map.show_directions",
