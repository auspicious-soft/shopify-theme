      "id": "heading_case",
      "label": "t:labels.heading_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:labels.button_case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.text_case.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.text_case.none"
        }
      ],
      "default": "uppercase"
    }
  ],
  "presets": [
    {
      "name": "t:sections.map.name"
    }
  ]
}
{% endschema %}
