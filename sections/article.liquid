{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<div class="page-width color-{{ section.settings.color_scheme.id }}">
  {% if article.image %}
    {% render 'image', image: article.image, width: 1000 %}
  {% endif %}

  {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
  {%- assign heading_class = section.settings.heading_class | default: heading_tag -%}
  <{{ heading_tag }} class="{{ heading_class }}">{{ article.title }}</{{ heading_tag }}>

  {% assign date = article.published_at | time_tag: format: 'date' %}
  <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>

  {{ article.content }}

  {% if blog.comments_enabled? %}
    <h2>{{ 'blog.article_comments' | t }}</h2>

    <div id="comments">
      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <div class="article__comment">
            <p>{{ comment.author }}</p>
            <p>
              {{- comment.created_at | time_tag: format: 'date' -}}
            </p>
            <p>{{ comment.content }}</p>
          </div>
        {% endfor %}

        {{ paginate | default_pagination: anchor: 'comments' }}
      {% endpaginate %}
    </div>

    {% form 'new_comment', article %}
      <h2>{{ 'blog.comment_form_title' | t }}</h2>

      {{ form.errors | default_errors }}

      <div>
        <label for="author">{{ 'blog.comment_form_name' | t }}</label>
        <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
      </div>

      <div>
        <label for="email">{{ 'blog.comment_form_email' | t }}</label>
        <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
      </div>

      <div>
        <label for="body">{{ 'blog.comment_form_body' | t }}</label>
        <textarea name="comment[body]" id="body" required>{{ form.body }}</textarea>
      </div>

      <input type="submit" value="{{ 'blog.comment_form_submit' | t }}">
    {% endform %}
  {% endif %}
</div>

{% stylesheet %}
  .article__comment {
    padding: 1rem;
    margin-block-end: 1rem;
    border-width: var(--style-border-thickness-text-boxes);
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-border) var(--style-border-opacity-text-boxes), transparent);
    border-radius: var(--style-border-radius-text-boxes);
    box-shadow: var(--style-shadow-text-boxes);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        { "value": "h6", "label": "t:options.heading_size.extra_small" },
        { "value": "h5", "label": "t:options.heading_size.small" },
        { "value": "h4", "label": "t:options.heading_size.medium" },
        { "value": "h3", "label": "t:options.heading_size.large" },
        { "value": "h2", "label": "t:options.heading_size.extra_large" },
        { "value": "h1", "label": "t:options.heading_size.huge" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
