{% comment %}
  Collection page (templates/collection.json).

  - Banner: minimal (title + description) or over the collection image.
  - Toolbar: filter toggle, product count, sort.
  - Filters (Shopify storefront filtering, `collection.filters`): a
    sidebar on desktop or an off-canvas drawer (always a drawer below
    990px), with active-filter chips and "clear all".
  - Grid of product cards (snippets/product-card.liquid), N columns on
    desktop / 1-2 on mobile.
  - Pagination: numbered pages or a "Load more" button.

  Filtering, sorting and paging update the page in place with the Section
  Rendering API (`?section_id=`) and push the URL to history, so links are
  shareable and Back works. Without JS every control still works as a
  normal link/form. Styles live in assets/collection.css.
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'pagination.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{%- liquid
  assign section_id = section.id
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign columns = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign card_sizes = '(min-width: 990px) calc((100vw - 20rem) / ' | append: columns | append: '), calc(100vw / ' | append: columns_mobile | append: ')'

  assign filtering = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign filtering = true
  endif
  assign filter_layout = section.settings.filter_layout
  assign sorting = section.settings.enable_sorting

  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor

  # Image banner: the collection's image. Collections without one show the
  # placeholder image (or a placeholder illustration) when "Show placeholder"
  # is on, and the minimal banner when it's off.
  assign banner_image = nil
  assign banner_placeholder = false
  if section.settings.banner_style == 'image'
    assign banner_image = collection.image
    if banner_image == blank and section.settings.banner_placeholder
      if section.settings.banner_placeholder_image != blank
        assign banner_image = section.settings.banner_placeholder_image
      else
        assign banner_placeholder = true
      endif
    endif
  endif

  assign clear_url = collection.url
  if collection.sort_by != blank
    assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif
-%}

<collection-page
  class="collection color-{{ section.settings.color_scheme.id }}"
  data-section-id="{{ section_id }}"
  style="
    {% render 'section-padding-vars', section: section %}
    --grid-columns: {{ columns }};
    --grid-columns-mobile: {{ columns_mobile }};
    --banner-overlay: {{ section.settings.banner_overlay | divided_by: 100.0 }};
  "
>
  {% if section.settings.show_banner %}
    <div class="collection-banner collection-banner--{% if banner_image or banner_placeholder %}image collection-banner--{{ section.settings.banner_height }}{% else %}minimal{% endif %} collection-banner--{{ section.settings.banner_alignment }}{% if section.settings.banner_color_scheme.id != section.settings.color_scheme.id %} collection-banner--filled{% endif %} color-{{ section.settings.banner_color_scheme.id }}">
      {% if banner_placeholder %}
        <div class="collection-banner__media">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'collection-banner__image collection-banner__placeholder' }}
        </div>
      {% elsif banner_image %}
        <div class="collection-banner__media">
          {{
            banner_image
            | image_url: width: 2400
            | image_tag:
              class: 'collection-banner__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 1800, 2400',
              sizes: '100vw',
              alt: collection.title
          }}
        </div>
      {% endif %}
      <div class="collection-banner__content page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
        <{{ heading_tag }} class="{{ heading_class }} collection-banner__title">{{ collection.title | escape }}</{{ heading_tag }}>
        {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', class: 'collection-banner__breadcrumbs' %}{%- endif -%}
        {% if section.settings.show_description and collection.description != blank %}
          <div class="collection-banner__description">{{ collection.description }}</div>
        {% endif %}
      </div>
    </div>
  {% else %}
    <{{ heading_tag }} class="visually-hidden">{{ collection.title | escape }}</{{ heading_tag }}>
    {%- if section.settings.show_breadcrumbs -%}
      <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %} collection__breadcrumbs">{% render 'breadcrumbs' %}</div>
    {%- endif -%}
  {% endif %}

  <div class="collection__container page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {% paginate collection.products by section.settings.products_per_page %}
      <div class="collection__toolbar">
        {% if filtering %}
          <button
            type="button"
            class="collection__filter-toggle{% if filter_layout == 'sidebar' %} collection__filter-toggle--mobile{% endif %}"
            aria-controls="Facets-{{ section_id }}"
            aria-expanded="false"
            data-facets-open
          >
            <span class="collection__filter-icon" aria-hidden="true"><span></span><span></span></span>
            <span>{{ 'collections.filter' | t }}</span>
            <span id="FilterCount-{{ section_id }}" class="collection__filter-count" data-results-part>
              {%- if active_filter_count > 0 -%}({{ active_filter_count }}){%- endif -%}
            </span>
          </button>
        {% endif %}

        {% if section.settings.show_count %}
          <p id="ProductCount-{{ section_id }}" class="collection__count" data-results-part>
            {{- 'collections.results_count' | t: count: collection.products_count -}}
          </p>
        {% endif %}

        {% if sorting %}
          <div class="collection__sort">
            <label for="SortBy-{{ section_id }}" class="collection__sort-label">{{ 'collections.sort_by' | t }}</label>
            <div class="collection__select">
              <select id="SortBy-{{ section_id }}" name="sort_by" form="FacetsForm-{{ section_id }}" data-facets-input>
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {% for option in collection.sort_options %}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                    {{- option.name | escape -}}
                  </option>
                {% endfor %}
              </select>
              {{ 'icon-chevron.svg' | inline_asset_content }}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="collection__layout{% if filtering and filter_layout == 'sidebar' %} collection__layout--sidebar{% endif %}">
        {% render 'facets',
          results: collection,
          url: collection.url,
          section_id: section_id,
          filtering: filtering,
          sorting: sorting,
          filter_layout: filter_layout,
          clear_url: clear_url,
          button_size: section.settings.filter_button_size
        %}

        <div id="CollectionResults-{{ section_id }}" class="collection__results" data-results-part>
          {% render 'facets-active', results: collection, active_filter_count: active_filter_count, clear_url: clear_url %}

          {% if collection.products.size > 0 %}
            <ul class="collection__grid" role="list" data-collection-grid>
              {% for product in collection.products %}
                <li class="collection__item">
                  {%- liquid
                    assign eager = false
                    if paginate.current_page == 1 and forloop.index <= columns
                      assign eager = true
                    endif
                  -%}
                  {% render 'product-card', product: product, sizes: card_sizes, eager: eager, heading_tag: 'h2' %}
                </li>
              {% endfor %}
            </ul>

            {% if paginate.pages > 1 %}
              {% if section.settings.pagination_type == 'load_more' %}
                {%- liquid
                  assign shown = paginate.current_offset | plus: collection.products.size
                  assign shown_percent = shown | times: 100 | divided_by: paginate.items
                -%}
                <div class="collection__load-more" data-load-more-wrapper>
                  <p class="collection__progress-text">{{ 'collections.showing' | t: shown: shown, total: paginate.items }}</p>
                  <div class="collection__progress" aria-hidden="true">
                    <span style="width: {{ shown_percent }}%;"></span>
                  </div>
                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="button button--secondary collection__load-more-button" data-load-more>
                      {{- 'collections.load_more' | t -}}
                    </a>
                  {% endif %}
                </div>
              {% else %}
                {% render 'pagination', paginate: paginate, link_attributes: 'data-facets-link' %}
              {% endif %}
            {% endif %}
          {% else %}
            <div class="collection__empty">
              {% if active_filter_count > 0 %}
                <p>{{ 'collections.no_results' | t }}</p>
                <a href="{{ clear_url }}" class="button button--secondary" data-facets-link>{{ 'collections.clear_all' | t }}</a>
              {% else %}
                <p>{{ 'collections.empty_collection' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'cart.continue_shopping' | t }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endpaginate %}
  </div>
</collection-page>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:general.collection",
