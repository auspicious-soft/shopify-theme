{% comment %}
  Collection list page (templates/list-collections.json): a heading and a
  responsive grid of collection cards (snippets/collection-card.liquid,
  styled from Theme settings > Collection cards). Shows every collection,
  or only the ones picked in the section's Collections setting.
{% endcomment %}

{{ 'collection-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), calc(100vw / ' | append: columns_mobile | append: ')'

  assign list = collections
  if section.settings.collection_list != blank
    assign list = section.settings.collection_list
  endif
-%}

<div
  class="collection-list-page color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --grid-columns: {{ columns }};
    --grid-columns-mobile: {{ columns_mobile }};
  "
>
  <div class="page-width">
    {% if section.settings.show_heading %}
      <div class="collection-list-page__header collection-list-page__header--{{ section.settings.heading_alignment }}">
        {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
        <{{ heading_tag }} class="collection-list-page__heading">
          {%- if section.settings.heading != blank -%}
            {{- section.settings.heading | escape -}}
          {%- else -%}
            {{- 'collections.title' | t -}}
          {%- endif -%}
        </{{ heading_tag }}>
        {% if section.settings.subheading != blank %}
          <div class="collection-list-page__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if list.size > 0 %}
      <ul class="collection-list-page__grid" role="list">
        {% for collection in list %}
          <li>
            {% render 'collection-card', collection: collection, sizes: card_sizes, eager: forloop.first %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="collection-list-page__empty">{{ 'collections.empty' | t }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .collection-list-page {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .collection-list-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .collection-list-page__header--center {
    align-items: center;
    text-align: center;
  }

  .collection-list-page__heading {
    margin: 0;
    line-height: 1.1;
  }

  .collection-list-page__subheading {
    max-width: 40rem;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .collection-list-page__subheading > * {
    margin: 0;
  }

  .collection-list-page__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
    gap: calc(var(--spacing-grid-vertical) * 3) calc(var(--spacing-grid-horizontal) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .collection-list-page__grid {
      grid-template-columns: repeat(min(var(--grid-columns), 3), minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .collection-list-page__grid {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }
  }

  .collection-list-page__empty {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "t:sections.collections.show_heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.collections.heading_info",
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.collections.collection_list",
      "info": "t:sections.collections.collection_list_info"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
