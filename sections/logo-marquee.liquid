{% comment %}
  "Logo marquee": a strip of brand / press / partner logos that scrolls on
  its own. Each logo is a block with an optional link.

  The row is repeated as many times as needed to fill the screen, then
  slides one row's width in a loop, so it never shows a gap. Speed is in
  pixels per second, so it feels the same with 3 logos or 30. Pauses on
  hover (optional) and stands still for shoppers who prefer reduced motion.
{% endcomment %}

{%- liquid
  assign placeholder_count = 0
  if section.blocks.size == 0
    assign placeholder_count = 6
  endif
-%}

<logo-marquee
  class="logo-marquee color-{{ section.settings.color_scheme.id }}{% if section.settings.pause_on_hover %} logo-marquee--pause-hover{% endif %}{% if section.settings.grayscale %} logo-marquee--grayscale{% endif %}{% if section.settings.show_dividers %} logo-marquee--dividers{% endif %}"
  data-speed="{{ section.settings.speed }}"
  data-direction="{{ section.settings.direction }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --logo-height: {{ section.settings.logo_height }}px;
    --logo-height-mobile: {{ section.settings.logo_height_mobile }}px;
    --logo-gap: {{ section.settings.gap }}px;
    --logo-gap-mobile: {{ section.settings.gap | times: 0.6 | round }}px;
    --logo-items: {{ section.settings.items_desktop }};
    --logo-items-mobile: {{ section.settings.items_mobile }};
    --logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="page-width logo-marquee__header logo-marquee__header--{{ section.settings.heading_alignment }}">
      {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ heading_tag }} class="logo-marquee__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    </div>
  {%- endif -%}

  <div class="logo-marquee__viewport{% if section.settings.fade_edges %} logo-marquee__viewport--fade{% endif %}{% if section.settings.width == 'page' %} page-width{% endif %}">
    <div class="logo-marquee__track" data-logo-track>
      <ul class="logo-marquee__group" role="list" data-logo-group>
        {%- for block in section.blocks -%}
          {%- liquid
            assign logo = block.settings.logo
            assign link = block.settings.link
            assign alt = block.settings.alt | default: logo.alt | escape
            assign logo_width = logo.aspect_ratio | default: 3 | times: section.settings.logo_height | times: 2 | round | at_least: 120 | at_most: 1200
          -%}
          <li class="logo-marquee__item" {{ block.shopify_attributes }}>
            {%- if link != blank -%}
              <a
                href="{{ link }}"
                class="logo-marquee__logo"
                {% if block.settings.new_tab %}
                  target="_blank" rel="noopener"
                {% endif %}
                {% if alt != blank %}
                  aria-label="{{ alt }}"
                {% endif %}
              >
            {%- else -%}
              <span class="logo-marquee__logo">
            {%- endif -%}

            {%- if logo != blank -%}
              {{
                logo
                | image_url: width: logo_width
                | image_tag:
                  class: 'logo-marquee__image',
                  loading: 'lazy',
                  alt: alt
              }}
            {%- elsif block.settings.alt != blank -%}
              <span class="logo-marquee__text">{{ block.settings.alt | escape }}</span>
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'logo-marquee__image logo-marquee__placeholder' }}
            {%- endif -%}

            {%- if link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- for i in (1..placeholder_count) -%}
          <li class="logo-marquee__item">
            <span class="logo-marquee__logo">
              {{ 'logo' | placeholder_svg_tag: 'logo-marquee__image logo-marquee__placeholder' }}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</logo-marquee>

{% stylesheet %}
  .logo-marquee {
    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow: hidden;
  }

  .logo-marquee__header {
    margin-block-end: 1.5rem;
  }

  .logo-marquee__header--center {
    text-align: center;
  }

  .logo-marquee__heading {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* The viewport is the size container, so each logo slot can be a share of
     the visible strip: (width - gaps between logos) / logos shown. */
  .logo-marquee__viewport {
    container-type: inline-size;
    overflow: hidden;
  }

  .logo-marquee__viewport--fade {
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .logo-marquee__track {
    display: flex;
    width: max-content;
  }

  .logo-marquee.is-ready .logo-marquee__track {
    animation: logo-marquee-scroll var(--logo-duration, 30s) linear infinite;
    animation-direction: var(--logo-animation-direction, normal);
  }

  .logo-marquee--pause-hover .logo-marquee__viewport:hover .logo-marquee__track,
  .logo-marquee--pause-hover .logo-marquee__viewport:focus-within .logo-marquee__track {
    animation-play-state: paused;
  }

  @keyframes logo-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(var(--logo-loop, 0px) * -1), 0, 0);
    }
  }

  .logo-marquee__group {
    display: flex;
    align-items: center;
    gap: var(--logo-gap-mobile);
    padding: 0 var(--logo-gap-mobile) 0 0;
    margin: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .logo-marquee__group {
      gap: var(--logo-gap);
      padding-inline-end: var(--logo-gap);
    }
  }

  .logo-marquee__item {
    --items: var(--logo-items-mobile);
    --gap: var(--logo-gap-mobile);
    position: relative;
    flex: 0 0 calc((100cqw - var(--gap) * (var(--items) - 1)) / var(--items));
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .logo-marquee__item {
      --items: var(--logo-items);
      --gap: var(--logo-gap);
    }
  }

  /* Thin line halfway between logos. */
  .logo-marquee--dividers .logo-marquee__item::after {
    content: '';
    position: absolute;
    top: 50%;
    inset-inline-end: calc(var(--logo-gap-mobile) / -2);
    width: 1px;
    height: 60%;
    background-color: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    transform: translateY(-50%);
  }

  @media screen and (min-width: 750px) {
    .logo-marquee--dividers .logo-marquee__item::after {
      inset-inline-end: calc(var(--logo-gap) / -2);
    }
  }

  .logo-marquee__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: var(--logo-height-mobile);
    color: inherit;
    text-decoration: none;
    opacity: var(--logo-opacity);
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  @media screen and (min-width: 750px) {
    .logo-marquee__logo {
      height: var(--logo-height);
    }
  }

  .logo-marquee--grayscale .logo-marquee__logo {
    filter: grayscale(1);
  }

  a.logo-marquee__logo:hover,
  a.logo-marquee__logo:focus-visible {
    opacity: 1;
    filter: none;
  }

  .logo-marquee__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo-marquee__placeholder {
    fill: currentColor;
  }

  .logo-marquee__text {
    font-size: calc(var(--logo-height-mobile) * 0.5);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media screen and (min-width: 750px) {
    .logo-marquee__text {
      font-size: calc(var(--logo-height) * 0.5);
    }
  }

  /* Reduced motion: no scrolling, the logos wrap into centered rows instead. */
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee.is-ready .logo-marquee__track {
      animation: none;
    }

    .logo-marquee__track {
      width: auto;
      justify-content: center;
    }

    .logo-marquee__group {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.5rem;
      padding-inline: var(--page-margin);
    }

    .logo-marquee__group[data-logo-clone] {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('logo-marquee')) {
    class LogoMarquee extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('.logo-marquee__viewport');
        this.track = this.querySelector('[data-logo-track]');
        this.group = this.querySelector('[data-logo-group]');
        if (!this.viewport || !this.track || !this.group) return;

        this.speed = Number(this.dataset.speed) || 40;
        const reverse = this.dataset.direction === 'right';
        this.style.setProperty('--logo-animation-direction', reverse ? 'reverse' : 'normal');

        this.fill = this.fill.bind(this);
        this.resizeObserver = new ResizeObserver(this.fill);
        this.resizeObserver.observe(this.viewport);
        this.resizeObserver.observe(this.group);
        this.fill();
      }

      disconnectedCallback() {
        this.resizeObserver?.disconnect();
      }

      /** Repeat the row until the strip can loop without a gap, then set the loop length and duration. */
      fill() {
        const loop = this.group.offsetWidth;
        if (!loop) return;

        const needed = Math.ceil(this.viewport.offsetWidth / loop) + 1;
        const clones = this.track.querySelectorAll('[data-logo-clone]');
        if (clones.length !== needed) {
          clones.forEach((clone) => clone.remove());
          for (let i = 0; i < needed; i++) {
            const clone = this.group.cloneNode(true);
            clone.removeAttribute('data-logo-group');
            clone.setAttribute('data-logo-clone', '');
            clone.setAttribute('aria-hidden', 'true');
            clone.querySelectorAll('[data-shopify-editor-block]').forEach((el) => el.removeAttribute('data-shopify-editor-block'));
            clone.querySelectorAll('a').forEach((link) => link.setAttribute('tabindex', '-1'));
            this.track.appendChild(clone);
          }
        }

        const sign = document.dir === 'rtl' ? -1 : 1;
        this.style.setProperty('--logo-loop', `${loop * sign}px`);
        this.style.setProperty('--logo-duration', `${loop / this.speed}s`);
        this.classList.add('is-ready');
      }
    }

    customElements.define('logo-marquee', LogoMarquee);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.logo_marquee.name",
  "class": "section-logo-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "As featured in"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:labels.marquee_settings"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:labels.marquee_speed",
      "info": "t:sections.social_marquee.speed_info",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:labels.marquee_direction",
      "options": [
        { "value": "left", "label": "t:sections.social_marquee.direction_left" },
        { "value": "right", "label": "t:sections.social_marquee.direction_right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:labels.pause_on_hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.logo_marquee.header_logos"
    },
    {
      "type": "range",
      "id": "items_desktop",
      "label": "t:sections.logo_marquee.items_desktop",
      "info": "t:sections.logo_marquee.items_info",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "items_mobile",
      "label": "t:sections.logo_marquee.items_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:sections.logo_marquee.logo_height",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "t:sections.logo_marquee.logo_height_mobile",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.item_gap",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "t:sections.logo_marquee.logo_opacity",
      "info": "t:sections.logo_marquee.logo_opacity_info",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "t:sections.logo_marquee.grayscale",
      "info": "t:sections.logo_marquee.grayscale_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:sections.logo_marquee.show_dividers",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "t:sections.logo_marquee.fade_edges",
      "default": true
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.collection_banner.width",
      "options": [
        { "value": "full", "label": "t:sections.collection_banner.width_full" },
        { "value": "page", "label": "t:sections.collection_banner.width_page" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_marquee.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.logo_marquee.logo"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:sections.logo_marquee.alt",
          "info": "t:sections.logo_marquee.alt_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "t:labels.open_in_new_tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_marquee.name",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
