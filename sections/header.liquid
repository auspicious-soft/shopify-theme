{% comment %}
  Site header with two selectable styles:

  - "standard": a normal, static header. Desktop can show a horizontal menu
    or a hamburger toggle (icon or text), placed left or right.
  - "logo_reveal": the header bar starts with an empty logo slot; a large,
    full-width logo block renders as its own "first section" right below
    the header. Scrolling crossfades the big logo out and reveals a second,
    compact logo inside the now-sticky header bar.

  Both styles share layout (logo position, icons, drawer, nav styling) and
  can independently go transparent/overlay on a per-template basis.

  CSS lives in assets/header.css and JS in assets/header.js, both loaded
  once from layout/theme.liquid since the header renders on every page.
{% endcomment %}
{% liquid
  assign style = section.settings.header_style
  # Header style 2 ("logo_reveal"): the default logo and the compact sticky
  # logo are both always rendered into the HTML, on every template, and
  # CSS (assets/header.css, driven by the `.is-scrolled` class assets/
  # header.js toggles) decides which one is visible.
  assign is_logo_reveal = false
  if style == 'logo_reveal'
    assign is_logo_reveal = true
  endif

  # The full-width hero logo block is a homepage-only "first section" look
  # and only makes sense there; every other template just gets the header
  # bar's default/sticky logos above.
  assign show_hero = false
  if is_logo_reveal and template.name == 'index'
    assign show_hero = true
  endif

  assign logo_position = section.settings.logo_position
  assign menu_type = section.settings.menu_type
  assign hamburger_position = section.settings.hamburger_position

  assign show_horizontal_nav = false
  if menu_type == 'horizontal'
    assign show_horizontal_nav = true
  endif

  # Style 2 is always sticky by definition, on every template, so the
  # default/sticky logo swap has an `.is-scrolled` class to key off of even
  # on pages without the homepage's hero logo.
  assign sticky_type = section.settings.sticky_header_type
  assign is_sticky = false
  assign hide_on_scroll = false
  if is_logo_reveal
    assign is_sticky = true
  elsif sticky_type == 'always'
    assign is_sticky = true
  elsif sticky_type == 'on_scroll_up'
    assign is_sticky = true
    assign hide_on_scroll = true
  endif

  # Transparent/overlay header is configured per template rather than as a
  # single global toggle.
  assign enable_overlay = false
  case template.name
    when 'index'
      assign enable_overlay = section.settings.overlay_on_home
    when 'product'
      assign enable_overlay = section.settings.overlay_on_product
    when 'collection', 'list-collections'
      assign enable_overlay = section.settings.overlay_on_collection
    when 'page'
      assign enable_overlay = section.settings.overlay_on_page
    when 'blog', 'article'
      assign enable_overlay = section.settings.overlay_on_blog
  endcase

  # Assign each header element to a layout zone (start/center/end). Zones
  # are flex rows, so any combination of logo/nav/toggle sharing a zone
  # lays out gracefully instead of fighting over one CSS Grid cell.
  assign logo_zone = 'center'
  if logo_position == 'left'
    assign logo_zone = 'start'
  elsif logo_position == 'right'
    assign logo_zone = 'end'
  endif

  assign nav_zone = 'start'
  if logo_zone == 'start'
    assign nav_zone = 'center'
  elsif logo_zone == 'end'
    assign nav_zone = 'center'
  endif

  assign actions_zone = 'end'
  if logo_zone == 'end'
    assign actions_zone = 'start'
  endif

  # Any sticky header needs scroll watching: to swap in the sticky
  # background color/shadow once stuck, to hide/reveal on scroll direction
  # ("on scroll up"), and/or to drive the logo-reveal crossfade.
  assign watch_scroll = is_sticky

  assign toggle_zone = 'start'
  if hamburger_position == 'right'
    assign toggle_zone = 'end'
  endif

  # Desktop toggle: only for the hamburger menu type, placed per Header
  # settings > Hamburger position (a desktop-only setting).
  assign show_hamburger = false
  if menu_type == 'hamburger'
    assign show_hamburger = true
  endif

  # The desktop toggle renders standalone in its own zone, unless that's
  # the same zone `.header__actions` already occupies, in which case it
  # renders alongside the icons instead (avoiding a duplicate).
  assign toggle_shares_actions_zone = false
  if toggle_zone == actions_zone
    assign toggle_shares_actions_zone = true
  endif

  assign show_standalone_toggle_start = false
  assign show_standalone_toggle_end = false
  if show_hamburger and toggle_zone == 'start' and toggle_shares_actions_zone == false
    assign show_standalone_toggle_start = true
  elsif show_hamburger and toggle_zone == 'end' and toggle_shares_actions_zone == false
    assign show_standalone_toggle_end = true
  endif

  assign show_toggle_in_actions_start = false
  assign show_toggle_in_actions_end = false
  if show_hamburger and toggle_shares_actions_zone and actions_zone == 'start'
    assign show_toggle_in_actions_start = true
  elsif show_hamburger and toggle_shares_actions_zone and actions_zone == 'end'
    assign show_toggle_in_actions_end = true
  endif

  # Mobile toggle: always first in the start zone (far left), for every
  # menu type — with the horizontal menu (dropdown or mega) it's the only
  # way into the navigation on mobile. When the desktop toggle already sits
  # exactly there, that one element serves both; otherwise a separate
  # mobile-only toggle renders there and the desktop one is desktop-only.
  assign show_mobile_toggle = true
  assign desktop_toggle_class = ''
  if show_standalone_toggle_start
    assign show_mobile_toggle = false
  elsif show_hamburger
    assign desktop_toggle_class = 'header__menu-toggle--desktop-only'
  endif

  # The `sizes` attribute needs real length values, not a CSS custom
  # property, so it's built from the two configurable logo widths directly.
  assign logo_sizes = '(min-width: 989px) ' | append: section.settings.desktop_logo_width | append: 'px, ' | append: section.settings.mobile_logo_width | append: 'px'

  assign default_logo = settings.logo
  assign sticky_logo = section.settings.sticky_logo
  assign hero_logo = section.settings.hero_logo
  assign transparent_logo = section.settings.transparent_logo

%}

<header
  class="
    header header--{{ style }} header--logo-{{ logo_position }} header--menu-{{ menu_type }} header--hamburger-{{ hamburger_position }}
    full-width color-{{ section.settings.color_scheme.id }}
    {%- if is_sticky %} header--sticky{% endif -%}
    {%- if enable_overlay %} header--overlay{% endif -%}
  "
  id="Header-{{ section.id }}"
  {% if watch_scroll %}data-watch-scroll{% endif %}
  {% if hide_on_scroll %}data-hide-on-scroll{% endif %}
  {% if show_hero %}data-header-hero-target="HeaderHero-{{ section.id }}"{% endif %}
  style="
    --header-logo-width: {{ section.settings.desktop_logo_width }}px;
    --header-logo-width-mobile: {{ section.settings.mobile_logo_width }}px;
    --header-nav-font-size: {{ section.settings.nav_font_size }}px;
    --header-nav-font-weight: {{ section.settings.nav_font_weight }};
    --header-nav-item-gap: {{ section.settings.nav_item_spacing }}px;
    --header-nav-hover-color: {{ section.settings.nav_hover_color }};
    {% if watch_scroll %}
      --header-sticky-bg: {{ section.settings.sticky_background_color }};
    {% endif %}
    {% if show_hero %}
      --header-logo-reveal-speed: {{ section.settings.logo_reveal_speed }}ms;
    {% endif %}
    {% if enable_overlay %}
      --header-overlay-text: {{ section.settings.overlay_text_color }};
    {% endif %}
  "
>
  <div class="header__inner page-width">
    <div class="header__zone header__zone--start">
      {% if show_mobile_toggle %}
        {% render 'header-menu-toggle', section: section, modifier: 'header__menu-toggle--mobile-only' %}
      {% endif %}
      {% if show_standalone_toggle_start %}
        {% render 'header-menu-toggle', section: section %}
      {% endif %}
      {% if logo_zone == 'start' %}
        {% render 'header-logo', is_logo_reveal: is_logo_reveal, sticky_logo: sticky_logo, default_logo: default_logo, transparent_logo: transparent_logo, logo_sizes: logo_sizes %}
      {% endif %}
      {% if show_horizontal_nav and nav_zone == 'start' %}
        {% render 'header-navigation', section: section %}
      {% endif %}
      {% if actions_zone == 'start' %}
        {% render 'header-actions', section: section, show_toggle_here: show_toggle_in_actions_start, toggle_class: desktop_toggle_class %}
      {% endif %}
    </div>

    <div class="header__zone header__zone--center">
      {% if logo_zone == 'center' %}
        {% render 'header-logo', is_logo_reveal: is_logo_reveal, sticky_logo: sticky_logo, default_logo: default_logo, transparent_logo: transparent_logo, logo_sizes: logo_sizes %}
      {% endif %}
      {% if show_horizontal_nav and nav_zone == 'center' %}
        {% render 'header-navigation', section: section %}
      {% endif %}
    </div>

    <div class="header__zone header__zone--end">
      {% if show_standalone_toggle_end %}
        {% render 'header-menu-toggle', section: section, modifier: desktop_toggle_class %}
      {% endif %}
      {% if logo_zone == 'end' %}
        {% render 'header-logo', is_logo_reveal: is_logo_reveal, sticky_logo: sticky_logo, default_logo: default_logo, transparent_logo: transparent_logo, logo_sizes: logo_sizes %}
      {% endif %}
      {% if show_horizontal_nav and nav_zone == 'end' %}
        {% render 'header-navigation', section: section %}
      {% endif %}
      {% if actions_zone == 'end' %}
        {% render 'header-actions', section: section, show_toggle_here: show_toggle_in_actions_end, toggle_class: desktop_toggle_class %}
      {% endif %}
    </div>
  </div>
  {% if show_hero %}
  <div class="header__hero color-{{ section.settings.color_scheme.id }}" id="HeaderHero-{{ section.id }}" data-header-hero>
    {% if hero_logo != blank %}
      {{ hero_logo | image_url: width: 1200 | image_tag: alt: shop.name, class: 'header__hero-logo-image', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <span class="header__hero-logo-text">{{ shop.name }}</span>
    {% endif %}
  </div>
{% endif %}
</header>



{% render 'header-drawer', section: section %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "select",
      "id": "header_style",
      "label": "t:labels.header_style",
      "options": [
        { "value": "standard", "label": "t:options.header_style.standard" },
        { "value": "logo_reveal", "label": "t:options.header_style.logo_reveal" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:labels.logo_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    }, 
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_type",
      "label": "t:labels.menu_type",
      "options": [
        { "value": "horizontal", "label": "t:options.menu_type.horizontal" },
        { "value": "hamburger", "label": "t:options.menu_type.hamburger" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "hamburger_position",
      "label": "t:labels.hamburger_position",
      "options": [
        { "value": "left", "label": "t:options.left_right.left" },
        { "value": "right", "label": "t:options.left_right.right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.menu_type == 'hamburger' }}"
    },
    {
      "type": "select",
      "id": "hamburger_display",
      "label": "t:labels.hamburger_display",
      "options": [
        { "value": "icon", "label": "t:options.hamburger_display.icon" },
        { "value": "text", "label": "t:options.hamburger_display.text" }
      ],
      "default": "icon",
      "visible_if": "{{ section.settings.menu_type == 'hamburger' }}"
    },
    {
      "type": "text",
      "id": "hamburger_text",
      "label": "t:labels.hamburger_text",
      "default": "Menu",
      "visible_if": "{{ section.settings.menu_type == 'hamburger' and section.settings.hamburger_display == 'text' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.logo_reveal_settings",
      "info": "t:labels.logo_reveal_settings_info"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "t:labels.hero_logo",
      "info": "t:labels.hero_logo_info",
      "visible_if": "{{ section.settings.header_style == 'logo_reveal' }}"
    },
    {
      "type": "image_picker",
      "id": "sticky_logo",
      "label": "t:labels.sticky_logo",
      "info": "t:labels.sticky_logo_info",
      "visible_if": "{{ section.settings.header_style == 'logo_reveal' }}"
    },
    {
      "type": "range",
      "id": "logo_reveal_speed",
      "label": "t:labels.logo_reveal_speed",
      "min": 150,
      "max": 900,
      "step": 50,
      "unit": "ms",
      "default": 400,
      "visible_if": "{{ section.settings.header_style == 'logo_reveal' }}"
    },
    {
      "type": "header",
      "content": "t:labels.header_options"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "label": "t:labels.sticky_header",
      "info": "t:labels.sticky_header_info",
      "options": [
        { "value": "none", "label": "t:options.sticky_header_type.none" },
        { "value": "always", "label": "t:options.sticky_header_type.always" },
        { "value": "on_scroll_up", "label": "t:options.sticky_header_type.on_scroll_up" }
      ],
      "default": "always",
      "visible_if": "{{ section.settings.header_style == 'standard' }}"
    },
    {
      "type": "color",
      "id": "sticky_background_color",
      "label": "t:labels.sticky_background_color",
      "info": "t:labels.sticky_background_color_info",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.header_style == 'logo_reveal' or section.settings.sticky_header_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "desktop_logo_width",
      "label": "t:labels.desktop_logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 130
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "t:labels.mobile_logo_width",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 90
    },
    {
      "type": "header",
      "content": "t:labels.transparent_header",
      "info": "t:labels.transparent_header_info"
    },
    {
      "type": "checkbox",
      "id": "overlay_on_home",
      "label": "t:labels.overlay_on_home",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "overlay_on_product",
      "label": "t:labels.overlay_on_product",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlay_on_collection",
      "label": "t:labels.overlay_on_collection",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlay_on_page",
      "label": "t:labels.overlay_on_page",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlay_on_blog",
      "label": "t:labels.overlay_on_blog",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "t:labels.overlay_text_color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.overlay_on_home or section.settings.overlay_on_product or section.settings.overlay_on_collection or section.settings.overlay_on_page or section.settings.overlay_on_blog }}"
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "t:labels.transparent_logo",
      "info": "t:labels.transparent_logo_info",
      "visible_if": "{{ section.settings.overlay_on_home or section.settings.overlay_on_product or section.settings.overlay_on_collection or section.settings.overlay_on_page or section.settings.overlay_on_blog }}"
    },
    {
      "type": "header",
      "content": "t:labels.header_icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:labels.show_account",
      "default": true
    },
    {
      "type": "select",
      "id": "account_display",
      "label": "t:labels.account_display",
      "options": [
        { "value": "icon", "label": "t:options.account_display.icon" },
        { "value": "text", "label": "t:options.account_display.text" }
      ],
      "default": "icon",
      "visible_if": "{{ section.settings.show_account }}"
    },
    {
      "type": "text",
      "id": "account_text",
      "label": "t:labels.account_text",
      "default": "Account",
      "visible_if": "{{ section.settings.show_account and section.settings.account_display == 'text' }}"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "t:labels.show_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "t:labels.show_cart_count",
      "default": true,
      "visible_if": "{{ section.settings.show_cart }}"
    },
    {
      "type": "header",
      "content": "t:labels.localization_settings",
      "info": "t:labels.localization_settings_info"
    },
    {
      "type": "select",
      "id": "localization_selector",
      "label": "t:labels.localization_selector",
      "options": [
        { "value": "none", "label": "t:options.localization_selector.none" },
        { "value": "country", "label": "t:options.localization_selector.country" },
        { "value": "language", "label": "t:options.localization_selector.language" },
        { "value": "both", "label": "t:options.localization_selector.both" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:labels.drawer_settings"
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "t:labels.drawer_position",
      "options": [
        { "value": "left", "label": "t:options.left_right.left" },
        { "value": "right", "label": "t:options.left_right.right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "drawer_submenu_style",
      "label": "t:labels.drawer_submenu_style",
      "options": [
        { "value": "accordion", "label": "t:options.drawer_submenu_style.accordion" },
        { "value": "slide", "label": "t:options.drawer_submenu_style.slide" }
      ],
      "default": "accordion"
    },
    {
      "type": "header",
      "content": "t:labels.navigation_settings",
      "info": "t:labels.navigation_settings_info"
    },
    {
      "type": "select",
      "id": "desktop_submenu_type",
      "label": "t:labels.desktop_submenu_type",
      "info": "t:labels.desktop_submenu_type_info",
      "options": [
        { "value": "dropdown", "label": "t:options.desktop_submenu_type.dropdown" },
        { "value": "mega", "label": "t:options.desktop_submenu_type.mega" }
      ],
      "default": "dropdown",
      "visible_if": "{{ section.settings.menu_type == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "t:labels.font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15,
      "visible_if": "{{ section.settings.menu_type == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "t:labels.font_weight",
      "options": [
        { "value": "400", "label": "t:options.font_weight.regular" },
        { "value": "500", "label": "t:options.font_weight.medium" },
        { "value": "600", "label": "t:options.font_weight.semibold" },
        { "value": "700", "label": "t:options.font_weight.bold" }
      ],
      "default": "500",
      "visible_if": "{{ section.settings.menu_type == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "nav_item_spacing",
      "label": "t:labels.nav_item_spacing",
      "min": 12,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.menu_type == 'horizontal' }}"
    },
    {
      "type": "color",
      "id": "nav_hover_color",
      "label": "t:labels.nav_hover_color",
      "default": "#000000",
      "visible_if": "{{ section.settings.menu_type == 'horizontal' }}"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_promo",
      "name": "t:blocks.mega_menu_promo.name",
      "limit": 12,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:blocks.mega_menu_promo.info"
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:blocks.mega_menu_promo.menu_item",
          "info": "t:blocks.mega_menu_promo.menu_item_info"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "t:blocks.mega_menu_promo.show_image",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:blocks.mega_menu_promo.image",
          "visible_if": "{{ block.settings.show_image }}"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "t:blocks.mega_menu_promo.show_title",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:blocks.mega_menu_promo.title",
          "visible_if": "{{ block.settings.show_title }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:blocks.mega_menu_promo.link",
          "info": "t:blocks.mega_menu_promo.link_info"
        }
      ]
    }
  ]
}
{% endschema %}
