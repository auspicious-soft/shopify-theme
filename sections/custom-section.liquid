{{ 'custom-section.css' | asset_url | stylesheet_tag }}
{{ 'group.css' | asset_url | stylesheet_tag }}
{{ 'text.css' | asset_url | stylesheet_tag }}

<div class="custom-section">
  {% if section.settings.background_image %}
    <div class="custom-section__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="custom-section__content page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}" {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "full", "label": "t:options.section_width.full" },
        { "value": "page", "label": "t:options.section_width.page" }
      ],
      "default": "page"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}
