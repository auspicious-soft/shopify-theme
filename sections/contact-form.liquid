{% comment %}
  "Contact form": Shopify's contact form (messages are emailed to the store's
  sender email, Settings > Notifications) with name, email, optional phone,
  optional order number / subject, and message. Shows a success message
  after sending and field errors when something is missing.

  Optional contact details beside the form (left or right) or below it, as
  plain text, one panel, or a separate card per detail, built from blocks: icon (snippets/icon-library.liquid) + title + text,
  e.g. email, phone, address, opening hours.

  Styles live in assets/contact-form.css.
{% endcomment %}

{{ 'contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign info_position = section.settings.info_position
  if section.blocks.size == 0
    assign info_position = 'none'
  endif
  assign info_style = section.settings.info_style | default: 'panel'

  assign button_label = 'contact.form.send' | t
  if section.settings.button_label != blank
    assign button_label = section.settings.button_label
  endif
  assign success_message = 'contact.form.success' | t
  if section.settings.success_message != blank
    assign success_message = section.settings.success_message
  endif
  assign success_heading = 'contact.form.success_heading' | t
  if section.settings.success_heading != blank
    assign success_heading = section.settings.success_heading
  endif
  assign replace_form = false
  if section.settings.success_display == 'replace'
    assign replace_form = true
  endif

  assign extra_label = 'contact.form.order_number' | t
  if section.settings.extra_field == 'subject'
    assign extra_label = 'contact.form.subject' | t
  endif
-%}

<div
  class="contact contact--info-{{ info_position }} contact--align-{{ section.settings.heading_alignment }} contact--details-{{ info_style }}{% if info_style == 'panel' %} contact--info-card{% endif %} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --contact-form-width: {{ section.settings.form_width }}px;
    --contact-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      <div class="contact__header">
        {%- if section.settings.subheading != blank -%}
          <p class="contact__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="{{ heading_class }} contact__heading">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="contact__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="contact__layout">
      <div class="contact__form-wrap">
        {% form 'contact', id: form_id, class: 'contact__form' %}
          {%- if form.posted_successfully? -%}
            <div
              class="contact__message contact__message--success contact__message--{{ section.settings.success_style | default: 'highlight' }}{% if replace_form %} contact__message--replace{% endif %}"
              role="status"
              tabindex="-1"
              autofocus
            >
              {% render 'icon-library', icon: 'check', class: 'contact__message-icon' %}
              <div class="contact__message-body">
                {%- if success_heading != blank -%}
                  <p class="contact__message-heading">{{ success_heading | escape }}</p>
                {%- endif -%}
                <p>{{ success_message | escape }}</p>
                {%- if replace_form -%}
                  <a href="{{ request.path }}" class="contact__message-link">{{ 'contact.form.send_another' | t }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="contact__message contact__message--error" role="alert" tabindex="-1" autofocus>
              <p>{{ 'contact.form.error_heading' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- comment -%} "Replace the form": after sending, only the message shows. {%- endcomment -%}
          {%- unless form.posted_successfully? and replace_form -%}
          <div class="contact__fields">
            <div class="contact__field{% if section.settings.show_phone %} contact__field--half{% endif %}">
              <label class="contact__label" for="{{ form_id }}-name">{{ 'contact.form.name' | t }}</label>
              <input
                class="contact__input"
                type="text"
                id="{{ form_id }}-name"
                name="contact[{{ 'contact.form.name' | t }}]"
                value="{{ form.name }}"
                autocomplete="name"
              >
            </div>

            {%- if section.settings.show_phone -%}
              <div class="contact__field contact__field--half">
                <label class="contact__label" for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }}</label>
                <input
                  class="contact__input"
                  type="tel"
                  id="{{ form_id }}-phone"
                  name="contact[{{ 'contact.form.phone' | t }}]"
                  value="{{ form.phone }}"
                  autocomplete="tel"
                  pattern="[0-9\-\+\s\(\)]*"
                >
              </div>
            {%- endif -%}

            <div class="contact__field">
              <label class="contact__label" for="{{ form_id }}-email">
                {{- 'contact.form.email' | t }} <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                class="contact__input"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                value="{% if form.email != blank %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true" aria-describedby="{{ form_id }}-email-error"
                {% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <p id="{{ form_id }}-email-error" class="contact__field-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            </div>

            {%- if section.settings.extra_field != 'none' -%}
              <div class="contact__field">
                <label class="contact__label" for="{{ form_id }}-extra">{{ extra_label }}</label>
                <input
                  class="contact__input"
                  type="text"
                  id="{{ form_id }}-extra"
                  name="contact[{{ extra_label }}]"
                >
              </div>
            {%- endif -%}

            <div class="contact__field">
              <label class="contact__label" for="{{ form_id }}-body">
                {{- 'contact.form.message' | t }} <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <textarea
                class="contact__input contact__textarea"
                id="{{ form_id }}-body"
                name="contact[body]"
                rows="6"
                required
                aria-required="true"
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                {% endif %}
              >{{ form.body }}</textarea>
            </div>
          </div>

          {%- if section.settings.privacy_note != blank -%}
            <div class="contact__privacy rte">{{ section.settings.privacy_note }}</div>
          {%- endif -%}

          <button type="submit" class="button button--{{ section.settings.button_style }} contact__submit">
            {{- button_label | escape -}}
          </button>
          {%- endunless -%}
        {% endform %}
      </div>

      {%- if info_position != 'none' -%}
        <div class="contact__info{% if info_style != 'plain' %} color-{{ section.settings.info_color_scheme.id }}{% endif %}">
          {%- for block in section.blocks -%}
            <div class="contact__info-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="contact__info-icon">{% render 'icon-library', icon: block.settings.icon %}</span>
              {%- endif -%}
              <div class="contact__info-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="contact__info-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="contact__info-text rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

