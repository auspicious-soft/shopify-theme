{% comment %}
  "Multirow": a stack of rows, each an image beside a caption, heading,
  text and button (a Row block per row), with an optional heading above.

  - Image position for all rows: alternating (starting left or right) or
    always on one side. Each row can override it.
  - Image width, shape and corner radius; content vertical position, text
    alignment, and plain or card style (card colors per section).
  - Mobile: image above or below the text.

  Images use snippets/banner-media.liquid (mobile image supported).
  Styles: assets/multirow.css.
{% endcomment %}

{{ 'multirow.css' | asset_url | stylesheet_tag }}
{{ 'banner-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'wide'
      assign ratio = '16 / 9'
    else
      assign ratio = 'auto'
  endcase

  case section.settings.image_width
    when 'small'
      assign image_fr = 1
      assign content_fr = 2
      assign image_sizes = '(min-width: 750px) 33vw, 100vw'
    when 'large'
      assign image_fr = 2
      assign content_fr = 1
      assign image_sizes = '(min-width: 750px) 66vw, 100vw'
    else
      assign image_fr = 1
      assign content_fr = 1
      assign image_sizes = '(min-width: 750px) 50vw, 100vw'
  endcase

  case section.settings.content_position
    when 'top'
      assign v_align = 'flex-start'
    when 'bottom'
      assign v_align = 'flex-end'
    else
      assign v_align = 'center'
  endcase

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign row_heading_tag = 'h3'
  if section.settings.heading == blank
    assign row_heading_tag = 'h2'
  endif
  assign row_heading_class = section.settings.row_heading_class | default: 'h3'
-%}

<div
  class="multirow multirow--align-{{ section.settings.alignment }} multirow--mobile-align-{{ section.settings.mobile_alignment }} multirow--mobile-{{ section.settings.mobile_image_position }} multirow--content-{{ section.settings.content_style }} color-{{ section.settings.color_scheme.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --multirow-image-fr: {{ image_fr }}fr;
    --multirow-content-fr: {{ content_fr }}fr;
    --multirow-radius: {{ section.settings.corner_radius }}px;
    --multirow-row-gap: {{ section.settings.row_gap }}px;
    --multirow-justify: {{ v_align }};
    --multirow-content-width: {{ section.settings.content_width }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      <div class="multirow__header multirow__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.subheading != blank -%}
          <p class="multirow__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="{{ heading_class }} multirow__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="multirow__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="multirow__rows">
      {%- for block in section.blocks -%}
        {%- liquid
          # Which side this row's image sits on.
          assign odd = forloop.index | modulo: 2
          assign side = block.settings.image_position
          if side == 'auto' or side == blank
            case section.settings.image_position
              when 'alternate_left'
                if odd == 1
                  assign side = 'left'
                else
                  assign side = 'right'
                endif
              when 'alternate_right'
                if odd == 1
                  assign side = 'right'
                else
                  assign side = 'left'
                endif
              else
                assign side = section.settings.image_position
            endcase
          endif

          assign placeholder_name = 'lifestyle-1'
          if odd == 0
            assign placeholder_name = 'lifestyle-2'
          endif

          assign row_ratio = ratio
          if ratio == 'auto'
            assign row_ratio = block.settings.image.aspect_ratio | default: 1.25
          endif

          assign has_link = false
          if block.settings.button_label != blank and block.settings.button_link != blank
            assign has_link = true
          endif
        -%}
        <div
          class="multirow__row multirow__row--image-{{ side }}"
          style="--row-ratio: {{ row_ratio }};"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}
        >
          <div class="multirow__media">
            {% render 'banner-media',
              image: block.settings.image,
              mobile_image: block.settings.mobile_image,
              show_video: false,
              alt: block.settings.image.alt,
              sizes: image_sizes,
              placeholder: placeholder_name
            %}
          </div>

          <div class="multirow__content-wrap">
            <div class="multirow__content{% if section.settings.content_style == 'card' %} color-{{ section.settings.card_color_scheme.id }}{% endif %}">
              {%- if block.settings.caption != blank -%}
                <p class="multirow__caption">{{ block.settings.caption | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <{{ row_heading_tag }} class="{{ row_heading_class }} multirow__row-heading">{{ block.settings.heading | escape }}</{{ row_heading_tag }}>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="multirow__text multirow__text--{{ section.settings.text_size }} rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if has_link -%}
                <a
                  href="{{ block.settings.button_link }}"
                  class="{% if section.settings.button_style == 'link' %}multirow__link{% else %}button button--{{ section.settings.button_style }} multirow__button{% endif %}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

