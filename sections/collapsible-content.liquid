{% comment %}
  "Collapsible content": an accordion for FAQs, shipping and returns info,
  product care and so on. Each row (block) has a heading with an optional
  icon (from the theme's icon set, or an uploaded image) and its content
  (rich text and/or a page's content), and can start open.

  - One row open at a time (native <details name="..."> grouping) or many.
  - Layout: heading above the rows, or heading on the left and rows on the
    right. Rows as lines or cards; plus/minus or chevron expand icon.
  - Works without JavaScript (<details> / <summary>).

  Styles live in assets/collapsible-content.css; icons come from
  snippets/icon-library.liquid.
{% endcomment %}
{%- liquid
  # Theme editor only: guidance for empty fields. request.design_mode is false
  # on the live store, so these are never shown to customers.
  assign ph_heading = nil
  assign pb_heading = nil
  assign ph_content = nil
  if request.design_mode
    assign ph_heading = 'editor_placeholders.section_heading' | t
    assign pb_heading = 'editor_placeholders.question' | t
    assign ph_content = 'editor_placeholders.answer' | t
  endif
  assign s_heading = section.settings.heading | default: ph_heading
-%}

{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign group = 'Collapsible-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign has_header = false
  if s_heading != blank or section.settings.subheading != blank or section.settings.description != blank
    assign has_header = true
  endif
-%}

<div
  class="collapsible collapsible--layout-{{ section.settings.layout }} collapsible--rows-{{ section.settings.row_style }} collapsible--expand-{{ section.settings.expand_icon }} collapsible--align-{{ section.settings.heading_alignment }} collapsible--content-{{ section.settings.row_content_size }} color-{{ section.settings.color_scheme.id }}"
  style="
    {% render 'section-padding-vars', section: section %}
    --collapsible-width: {{ section.settings.content_width }}px;
    --collapsible-icon-size: {{ section.settings.icon_size }}px;
    --collapsible-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    <div class="collapsible__layout{% unless has_header %} collapsible__layout--no-header{% endunless %}">
      {%- if has_header -%}
        <div class="collapsible__header">
          {%- if section.settings.subheading != blank -%}
            <p class="collapsible__subheading{% if section.settings.subheading_letter_spacing != blank and section.settings.subheading_letter_spacing != 'none' %} letter-spacing--{{ section.settings.subheading_letter_spacing }}{% endif %}">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if s_heading != blank -%}
            <{{ heading_tag }} class="{{ heading_class }} collapsible__heading">{{ s_heading }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="collapsible__description rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="collapsible__rows">
        {%- for block in section.blocks -%}
    {%- liquid
      assign b_heading = block.settings.heading | default: pb_heading
      assign b_content = block.settings.content | default: ph_content
    -%}
          {%- liquid
            assign open = false
            if block.settings.open
              assign open = true
            endif
          -%}
          <details
            class="collapsible__row{% if section.settings.row_style == 'cards' %} color-{{ section.settings.card_color_scheme.id }}{% endif %}"
            id="Collapsible-{{ block.id }}"
            {% if section.settings.one_at_a_time %}
              name="{{ group }}"
            {% endif %}
            {% if open %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="collapsible__summary">
              {%- if section.settings.show_icons == false -%}
                {%- comment -%} Icons hidden (section setting); rows keep their icon choice. {%- endcomment -%}
              {%- elsif block.settings.icon_image != blank -%}
                <span class="collapsible__icon collapsible__icon--image">
                  {{
                    block.settings.icon_image
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', alt: '', widths: '48, 96', sizes: '48px'
                  }}
                </span>
              {%- elsif block.settings.icon != 'none' -%}
                <span class="collapsible__icon">{% render 'icon-library', icon: block.settings.icon %}</span>
              {%- endif -%}
              <span class="collapsible__title{% if section.settings.row_heading_size != 'default' %} {{ section.settings.row_heading_size }}{% endif %}">{{ b_heading | default: block.settings.page.title | escape }}</span>
              <span class="collapsible__toggle" aria-hidden="true"></span>
            </summary>

            <div class="collapsible__content">
              <div class="collapsible__content-inner rte">
                {{- b_content -}}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% render 'text-case', section: section %}

