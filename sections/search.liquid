{% comment %}
  Search results page (templates/search.json).

  - Search form (with the current terms).
  - Type tabs: All / Products / Articles / Pages (or products only).
  - Toolbar: filter toggle, result count, sort; product filters in a
    sidebar or drawer (snippets/facets.liquid, shared with the collection
    page) with active-filter chips.
  - Results: product cards, article cards and page cards in one grid.
    Numbered pages or "Load more".
  - No results / no search yet: tips and, optionally, products from a
    collection.

  Filtering, sorting and paging update in place through the collection
  page's script (assets/collection.js, <collection-page>), and push the URL
  so links are shareable and Back works. Without JS everything is plain
  links and forms.
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
{{ 'article-card.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'pagination.css' | asset_url | stylesheet_tag }}
{{ 'search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{%- liquid
  assign section_id = section.id
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_class = section.settings.heading_class | default: heading_tag
  assign columns = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign card_sizes = '(min-width: 990px) calc((100vw - 20rem) / ' | append: columns | append: '), calc(100vw / ' | append: columns_mobile | append: ')'
  assign products_only = false
  if section.settings.result_types == 'products'
    assign products_only = true
  endif

  # Current type tab: the `type` param when it names one type.
  assign current_type = 'all'
  if products_only
    assign current_type = 'product'
  elsif search.types.size == 1
    assign current_type = search.types.first
  endif

  assign filtering = false
  if section.settings.enable_filtering and search.performed and search.filters.size > 0
    assign filtering = true
  endif
  assign filter_layout = section.settings.filter_layout
  assign sorting = false
  if section.settings.enable_sorting and search.performed
    assign sorting = true
  endif

  assign active_filter_count = 0
  for filter in search.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor

  # The query, type and prefix carried by every filter / sort / clear link.
  assign terms_param = search.terms | url_encode
  assign base_url = routes.search_url | append: '?q=' | append: terms_param | append: '&options%5Bprefix%5D=last'
  assign type_param = ''
  if current_type != 'all'
    assign type_param = current_type
    assign base_url = base_url | append: '&type=' | append: current_type
  endif
  assign clear_url = base_url
  if search.sort_by != blank
    assign clear_url = clear_url | append: '&sort_by=' | append: search.sort_by
  endif
-%}

{%- capture hidden_inputs -%}
  <input type="hidden" name="q" value="{{ search.terms | escape }}">
  <input type="hidden" name="options[prefix]" value="last">
  {%- if type_param != blank -%}<input type="hidden" name="type" value="{{ type_param }}">{%- endif -%}
{%- endcapture -%}

<collection-page
  class="collection search-page color-{{ section.settings.color_scheme.id }}"
  data-section-id="{{ section_id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --grid-columns: {{ columns }};
    --grid-columns-mobile: {{ columns_mobile }};
  "
>
  <div class="collection__container page-width{% if section.settings.width == 'full' %} page-width--full{% endif %}">
    <div class="search-page__header search-page__header--{{ section.settings.heading_alignment }}">
      <{{ heading_tag }} class="{{ heading_class }} search-page__title">
        {%- if search.performed -%}
          {{- 'search.results_title' | t -}}
        {%- else -%}
          {{- 'search.title' | t -}}
        {%- endif -%}
      </{{ heading_tag }}>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label for="SearchPageInput-{{ section_id }}" class="visually-hidden">{{ 'search.title' | t }}</label>
        <input
          id="SearchPageInput-{{ section_id }}"
          class="search-page__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t | strip }}…"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input type="hidden" name="options[prefix]" value="last">
        {%- if type_param != blank -%}<input type="hidden" name="type" value="{{ type_param }}">{%- endif -%}
        <button type="submit" class="search-page__submit" aria-label="{{ 'search.submit' | t }}">
          {{ 'icon-search.svg' | inline_asset_content }}
        </button>
      </form>

      {%- if search.performed -%}
        <p id="SearchSummary-{{ section_id }}" class="search-page__summary" data-results-part>
          {{- 'search.results_count_html' | t: count: search.results_count, terms: search.terms | escape -}}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed and section.settings.show_type_tabs and products_only == false -%}
      <nav class="search-page__tabs" aria-label="{{ 'search.result_types' | t }}">
        {%- assign tab_base = routes.search_url | append: '?q=' | append: terms_param | append: '&options%5Bprefix%5D=last' -%}
        {%- assign tabs = 'all,product,article,page' | split: ',' -%}
        {%- for tab in tabs -%}
          {%- liquid
            assign tab_url = tab_base
            if tab != 'all'
              assign tab_url = tab_url | append: '&type=' | append: tab
            endif
            assign tab_key = 'search.types.' | append: tab
          -%}
          <a
            href="{{ tab_url }}"
            class="search-page__tab{% if tab == current_type %} is-active{% endif %}"
            {% if tab == current_type %}aria-current="page"{% endif %}
          >
            {{- tab_key | t -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if search.performed and search.results_count > 0 -%}
      {% paginate search.results by section.settings.results_per_page %}
        <div class="collection__toolbar">
          {%- if filtering -%}
            <button
              type="button"
              class="collection__filter-toggle{% if filter_layout == 'sidebar' %} collection__filter-toggle--mobile{% endif %}"
              aria-controls="Facets-{{ section_id }}"
              aria-expanded="false"
              data-facets-open
            >
              <span class="collection__filter-icon" aria-hidden="true"><span></span><span></span></span>
              <span>{{ 'collections.filter' | t }}</span>
              <span id="FilterCount-{{ section_id }}" class="collection__filter-count" data-results-part>
                {%- if active_filter_count > 0 -%}({{ active_filter_count }}){%- endif -%}
              </span>
            </button>
          {%- endif -%}

          {%- if section.settings.show_count -%}
            <p id="ProductCount-{{ section_id }}" class="collection__count" data-results-part>
              {{- 'search.results_short' | t: count: search.results_count -}}
            </p>
          {%- endif -%}

          {%- if sorting -%}
            <div class="collection__sort">
              <label for="SortBy-{{ section_id }}" class="collection__sort-label">{{ 'collections.sort_by' | t }}</label>
              <div class="collection__select">
                <select id="SortBy-{{ section_id }}" name="sort_by" form="FacetsForm-{{ section_id }}" data-facets-input>
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  {%- for option in search.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                      {{- option.name | escape -}}
                    </option>
                  {%- endfor -%}
                </select>
                {{ 'icon-chevron.svg' | inline_asset_content }}
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="collection__layout{% if filtering and filter_layout == 'sidebar' %} collection__layout--sidebar{% endif %}">
          {% render 'facets',
            results: search,
            url: routes.search_url,
            section_id: section_id,
            filtering: filtering,
            sorting: sorting,
            filter_layout: filter_layout,
            clear_url: clear_url,
            button_size: section.settings.filter_button_size,
            hidden_inputs: hidden_inputs
          %}

          <div id="CollectionResults-{{ section_id }}" class="collection__results" data-results-part>
            {% render 'facets-active', results: search, active_filter_count: active_filter_count, clear_url: clear_url %}

            {%- if search.results.size > 0 -%}
              <ul class="collection__grid" role="list" data-collection-grid>
                {%- for result in search.results -%}
                  {%- liquid
                    assign eager = false
                    if paginate.current_page == 1 and forloop.index <= columns
                      assign eager = true
                    endif
                  -%}
                  <li class="collection__item search-page__item search-page__item--{{ result.object_type }}">
                    {%- case result.object_type -%}
                      {%- when 'product' -%}
                        {% render 'product-card', product: result, sizes: card_sizes, eager: eager, heading_tag: 'h2' %}
                      {%- when 'article' -%}
                        <span class="search-page__type">{{ 'search.types.article_single' | t }}</span>
                        {% render 'article-card',
                          article: result,
                          image_ratio: 'square',
                          sizes: card_sizes,
                          show_excerpt: true,
                          excerpt_words: 18,
                          heading_tag: 'h2',
                          eager: eager
                        %}
                      {%- when 'page' -%}
                        <a href="{{ result.url }}" class="search-page__page-card">
                          <span class="search-page__type">{{ 'search.types.page_single' | t }}</span>
                          <h2 class="h5 search-page__page-title">{{ result.title | escape }}</h2>
                          {%- assign page_excerpt = result.content | strip_html | truncatewords: 22 -%}
                          {%- if page_excerpt != blank -%}
                            <p class="search-page__page-excerpt">{{ page_excerpt }}</p>
                          {%- endif -%}
                          <span class="search-page__page-link">{{ 'search.read_more' | t }}</span>
                        </a>
                    {%- endcase -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {%- if section.settings.pagination_type == 'load_more' -%}
                  {%- liquid
                    assign shown = paginate.current_offset | plus: search.results.size
                    assign shown_percent = shown | times: 100 | divided_by: paginate.items
                  -%}
                  <div class="collection__load-more" data-load-more-wrapper>
                    <p class="collection__progress-text">{{ 'search.showing' | t: shown: shown, total: paginate.items }}</p>
                    <div class="collection__progress" aria-hidden="true">
                      <span style="width: {{ shown_percent }}%;"></span>
                    </div>
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}" class="button button--secondary collection__load-more-button" data-load-more>
                        {{- 'collections.load_more' | t -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  {% render 'pagination', paginate: paginate, link_attributes: 'data-facets-link' %}
                {%- endif -%}
              {%- endif -%}
            {%- else -%}
              <div class="collection__empty">
                <p>{{ 'collections.no_results' | t }}</p>
                <a href="{{ clear_url }}" class="button button--secondary" data-facets-link>{{ 'collections.clear_all' | t }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {% endpaginate %}
    {%- else -%}
      {%- if search.performed -%}
        <div class="search-page__empty">
          <p class="search-page__empty-title">{{ 'search.no_results_html' | t: terms: search.terms | escape }}</p>
          <ul class="search-page__tips" role="list">
            <li>{{ 'search.tips.spelling' | t }}</li>
            <li>{{ 'search.tips.fewer_words' | t }}</li>
            <li>{{ 'search.tips.general' | t }}</li>
          </ul>
        </div>
      {%- endif -%}

      {%- assign suggestions = section.settings.suggestions_collection -%}
      {%- if suggestions != blank and suggestions.products_count > 0 -%}
        <div class="search-page__suggestions">
          <h2 class="h4 search-page__suggestions-title">
            {%- if section.settings.suggestions_heading != blank -%}
              {{- section.settings.suggestions_heading | escape -}}
            {%- else -%}
              {{- 'search.popular_products' | t -}}
            {%- endif -%}
          </h2>
          <ul class="collection__grid" role="list">
            {%- for product in suggestions.products limit: section.settings.suggestions_count -%}
              <li class="collection__item">
                {% render 'product-card', product: product, sizes: card_sizes, heading_tag: 'h3' %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</collection-page>

{% render 'text-case', section: section %}
{% render 'button-size', section: section %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
