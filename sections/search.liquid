{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="page-width color-{{ section.settings.color_scheme.id }}">
  {%- assign heading_tag = section.settings.heading_tag | default: 'h1' -%}
  {%- assign heading_class = section.settings.heading_class | default: heading_tag -%}
  <{{ heading_tag }} class="{{ heading_class }}">{{ 'search.title' | t }}</{{ heading_tag }}>

  <form action="{{ routes.search_url }}" method="get" role="search">
    <input
      type="search"
      size="50"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
    >
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      <div class="search-results">
        {% paginate search.results by 20 %}
          {% # Search result items may be an article, a page, or a product. %}
          {% for result in search.results %}
            <div class="search-result">
              {% assign featured_image = result.featured_image | default: result.image %}
              {% if featured_image %}
                {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 400 %}
              {% endif %}
              <div class="search-result__content">
                <p>
                  {{ result.title | link_to: result.url }}
                  {% if result.price %}
                    {% render 'price', price: result.price %}
                  {% endif %}
                </p>
              </div>
            </div>
          {% endfor %}

          {{ paginate | default_pagination }}
        {% endpaginate %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .search-results .prev,
  .search-results .page,
  .search-results .next {
    grid-column: 1 / -1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:labels.heading_tag_info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "t:labels.heading_class",
      "info": "t:labels.heading_class_info",
      "options": [
        { "value": "h6", "label": "t:options.heading_size.extra_small" },
        { "value": "h5", "label": "t:options.heading_size.small" },
        { "value": "h4", "label": "t:options.heading_size.medium" },
        { "value": "h3", "label": "t:options.heading_size.large" },
        { "value": "h2", "label": "t:options.heading_size.extra_large" },
        { "value": "h1", "label": "t:options.heading_size.huge" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
