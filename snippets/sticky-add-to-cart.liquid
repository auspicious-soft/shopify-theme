{% doc %}
  Sticky add to cart bar for the product page (Product section > Sticky add
  to cart). Slides in at the bottom of the screen once the main Add to cart
  button has scrolled out of view, and hides again over the footer.

  - Adds to cart through <product-form> (assets/product-form.js), so it
    opens the cart drawer just like the main button.
  - The inner bar has `data-product-part`: when the variant changes on the
    page, <product-page> re-renders it from the server (price, image, stock).
  - Variants show as one dropdown of every variant, a dropdown per option,
    or buttons per option (color options as swatches), from Product section
    > Sticky add to cart > Variant style. A choice in the bar selects the
    same options in the main variant picker (assets/sticky-add-to-cart.js),
    so both stay in sync.

  Styles: assets/sticky-add-to-cart.css.

  @param {product} product - The product
  @param {variant} variant - The selected (or first available) variant
  @param {object} section - The product section (for settings and ids)

  @example
  {% render 'sticky-add-to-cart', product: product, variant: current_variant, section: section %}
{% enddoc %}

{{ 'sticky-add-to-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sticky-add-to-cart.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{%- liquid
  assign image = variant.featured_media.preview_image | default: product.featured_media.preview_image
  assign sticky_form_id = 'StickyAtcForm-' | append: section.id
  assign show_variants = false
  if section.settings.sticky_atc_show_variants and product.has_only_default_variant == false
    assign show_variants = true
  endif
  assign picker = section.settings.sticky_atc_picker | default: 'combined'
-%}

<sticky-add-to-cart
  class="sticky-atc sticky-atc--{{ section.settings.sticky_atc_devices }} color-{{ section.settings.sticky_atc_color_scheme.id }}"
  data-watch="#ProductForm-{{ section.id }}"
  aria-hidden="true"
  inert
>
  <div id="StickyAtc-{{ section.id }}" class="sticky-atc__inner page-width" data-product-part>
    {%- if section.settings.sticky_atc_show_image and image -%}
      <div class="sticky-atc__media">
        {{ image | image_url: width: 160 | image_tag: class: 'sticky-atc__image', loading: 'lazy', alt: product.title, sizes: '64px', widths: '80, 120, 160' }}
      </div>
    {%- endif -%}

    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title | escape }}</p>
      <div class="sticky-atc__price">
        {% render 'price', price: variant.price, compare_at_price: variant.compare_at_price %}
      </div>
    </div>

    <product-form class="sticky-atc__form" data-cart-type="{{ settings.cart_type }}">
      {%- form 'product', product, id: sticky_form_id, class: 'sticky-atc__form-inner', novalidate: 'novalidate' -%}
        {%- if show_variants and picker == 'combined' -%}
          {%- comment -%} One dropdown listing every variant ("M / White"). {%- endcomment -%}
          <div class="sticky-atc__select-wrap">
            <label class="visually-hidden" for="StickyAtcVariant-{{ section.id }}">{{ 'products.choose_variant' | t }}</label>
            <select
              id="StickyAtcVariant-{{ section.id }}"
              name="id"
              class="sticky-atc__select"
              data-sticky-variant-select
            >
              {%- for v in product.variants -%}
                <option
                  value="{{ v.id }}"
                  data-options="{{ v.options | json | escape }}"
                  {% if v.id == variant.id %}selected{% endif %}
                >
                  {{- v.title | escape }}
                  {%- unless v.available %} — {{ 'products.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
            {{- 'icon-chevron.svg' | inline_asset_content -}}
          </div>
        {%- else -%}
          {%- if show_variants -%}
            {%- comment -%}
              One control per option: a dropdown each, or buttons (swatches for
              color). The hidden id below is kept current by <product-page>.
            {%- endcomment -%}
            <div class="sticky-atc__options sticky-atc__options--{{ picker }}">
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_index = forloop.index0
                  assign option_uid = 'StickyAtc-' | append: section.id | append: '-' | append: option_index
                  assign option_name = option.name | downcase | strip
                  assign is_swatch = false
                  if option_name == 'color' or option_name == 'colour'
                    assign is_swatch = true
                  endif
                -%}
                {%- if picker == 'dropdowns' -%}
                  <div class="sticky-atc__select-wrap sticky-atc__select-wrap--option">
                    <label class="visually-hidden" for="{{ option_uid }}">{{ option.name | escape }}</label>
                    <select id="{{ option_uid }}" class="sticky-atc__select" data-sticky-option data-option-index="{{ option_index }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                          {{- value | escape -}}
                          {%- unless value.available %} — {{ 'products.unavailable' | t }}{% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                    {{- 'icon-chevron.svg' | inline_asset_content -}}
                  </div>
                {%- else -%}
                  <fieldset class="sticky-atc__option{% if is_swatch %} sticky-atc__option--swatch{% endif %}">
                    <legend class="visually-hidden">{{ option.name | escape }}</legend>
                    {%- for value in option.values -%}
                      {%- assign value_id = option_uid | append: '-' | append: forloop.index0 -%}
                      <input
                        type="radio"
                        id="{{ value_id }}"
                        name="{{ option_uid }}"
                        value="{{ value | escape }}"
                        class="sticky-atc__radio"
                        data-sticky-option
                        data-option-index="{{ option_index }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      {%- if is_swatch -%}
                        <label
                          for="{{ value_id }}"
                          class="sticky-atc__swatch{% unless value.available %} is-unavailable{% endunless %}"
                          style="{% render 'swatch-style', value: value %}"
                          title="{{ value | escape }}"
                        >
                          <span class="visually-hidden">{{ value | escape }}</span>
                        </label>
                      {%- else -%}
                        <label for="{{ value_id }}" class="sticky-atc__pill{% unless value.available %} is-unavailable{% endunless %}">
                          {{- value | escape -}}
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id-input data-sticky-id>
        {%- endif -%}
        <input type="hidden" name="quantity" value="1">

        <button
          type="submit"
          name="add"
          class="button button--primary product-form__submit sticky-atc__button"
          data-add-to-cart
          {% unless variant.available %}disabled{% endunless %}
        >
          <span class="product-form__submit-label">
            {%- if variant.available -%}
              {{ 'products.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </span>
          <span class="product-form__spinner" aria-hidden="true"></span>
        </button>
        <p class="sticky-atc__error" role="alert" data-product-form-error hidden></p>
      {%- endform -%}
    </product-form>
  </div>
</sticky-add-to-cart>
