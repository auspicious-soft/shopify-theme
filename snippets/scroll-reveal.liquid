{% doc %}
  Fades/translates any `[data-animate]` element into view the first time it
  scrolls into the viewport, using a single shared IntersectionObserver.
  Rendered once, sitewide, only when
  Theme settings > Animations > Reveal sections on scroll is enabled.
  Respects prefers-reduced-motion.

  @example
  {% render 'scroll-reveal' %}
{% enddoc %}

<script src="{{ 'scroll-reveal.js' | asset_url }}" defer></script>
