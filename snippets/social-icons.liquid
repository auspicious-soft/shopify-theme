{% doc %}
  Renders links to the store's social profiles from Theme settings > Social
  media, as line icons matching the theme's icon set. Renders nothing when
  no profile is set.

  @param {string} [class] - Extra class for the list

  @example
  {% render 'social-icons', class: 'footer__social' %}
{% enddoc %}

{%- liquid
  assign platforms = 'instagram,facebook,tiktok,youtube,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
  assign has_any = false
  for platform in platforms
    assign key = 'social_' | append: platform | append: '_link'
    if settings[key] != blank
      assign has_any = true
      break
    endif
  endfor
-%}

{%- if has_any -%}
  <ul class="social-icons {{ class }}" role="list">
    {%- for platform in platforms -%}
      {%- assign key = 'social_' | append: platform | append: '_link' -%}
      {%- assign url = settings[key] -%}
      {%- if url != blank -%}
        <li>
          <a href="{{ url }}" class="social-icons__link" target="_blank" rel="noopener">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="var(--icon-stroke-width, 1.25)" stroke-linecap="round" stroke-linejoin="round">
              {%- case platform -%}
                {%- when 'instagram' -%}
                  {%- assign platform_label = 'general.social.instagram' | t -%}
                  <rect x="3" y="3" width="14" height="14" rx="4"/><circle cx="10" cy="10" r="3.2"/><circle cx="14.2" cy="5.8" r=".5" fill="currentColor" stroke="none"/>
                {%- when 'facebook' -%}
                  {%- assign platform_label = 'general.social.facebook' | t -%}
                  <path d="M11.5 17.5v-6.2h2.1l.4-2.5h-2.5V7.3c0-.8.3-1.3 1.4-1.3H14V3.8a14 14 0 0 0-1.9-.1C10.1 3.7 9 4.9 9 7v1.8H7v2.5h2v6.2"/>
                {%- when 'tiktok' -%}
                  {%- assign platform_label = 'general.social.tiktok' | t -%}
                  <path d="M11.2 3v9.4a2.7 2.7 0 1 1-2.7-2.7M11.2 3c.3 2 1.8 3.5 3.9 3.7"/>
                {%- when 'youtube' -%}
                  {%- assign platform_label = 'general.social.youtube' | t -%}
                  <rect x="2.5" y="4.5" width="15" height="11" rx="3"/><path d="M8.6 7.9v4.2l3.7-2.1z" fill="currentColor" stroke="none"/>
                {%- when 'twitter' -%}
                  {%- assign platform_label = 'general.social.twitter' | t -%}
                  <path d="M4.5 4h3l8 12h-3zM15.5 4l-4.7 5.3M4.5 16l4.7-5.3"/>
                {%- when 'pinterest' -%}
                  {%- assign platform_label = 'general.social.pinterest' | t -%}
                  <circle cx="10" cy="10" r="7.25"/><path d="M9.2 16.8l1.6-6.6M8.4 12c.3.9 1 1.4 2 1.4 1.8 0 3-1.6 3-3.6 0-2.1-1.7-3.5-3.8-3.5-2.4 0-3.9 1.6-3.9 3.5 0 .8.3 1.5.8 1.9"/>
                {%- when 'snapchat' -%}
                  {%- assign platform_label = 'general.social.snapchat' | t -%}
                  <path d="M10 3.5c-2.3 0-3.8 1.7-3.8 3.9v1.7l-1.4.5c.4.8 1.2 1 1.2 1-.5 1.4-1.7 2.6-3 2.9.5.7 1.6.7 2.3.9l.4 1.2 1.7-.2c.9.3 1.5 1.5 2.6 1.5s1.7-1.2 2.6-1.5l1.7.2.4-1.2c.7-.2 1.8-.2 2.3-.9-1.3-.3-2.5-1.5-3-2.9 0 0 .8-.2 1.2-1l-1.4-.5V7.4c0-2.2-1.5-3.9-3.8-3.9z"/>
                {%- when 'tumblr' -%}
                  {%- assign platform_label = 'general.social.tumblr' | t -%}
                  <path d="M8.6 3v3H7v2.5h1.6v4.1c0 2.1 1.2 3.4 3.3 3.4H14v-2.5h-1.7c-.8 0-1.2-.4-1.2-1.2V8.5H14V6h-2.9V3z"/>
                {%- when 'vimeo' -%}
                  {%- assign platform_label = 'general.social.vimeo' | t -%}
                  <path d="M3 7.6l.9 1.2c1-.8 1.7-1 1.9-.3.8 2.8 1.6 6.9 3.2 6.9 1.9 0 5.5-4.7 6.3-7.6.5-1.9-.4-3.3-2.4-2.9-1 .2-2 1.2-2.5 2.6 1.4-.8 2.4.2 1.5 1.8-.9 1.5-1.7 2.6-2.1 2.6-.6 0-1.4-5.2-1.9-6.2-.6-1.2-2.4.2-4.9 1.9z"/>
              {%- endcase -%}
            </svg>
            <span class="visually-hidden">{{ platform_label }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
