{% doc %}
  Renders the header's icon cluster (search, account, cart) plus the
  hamburger menu toggle when it belongs in this zone. Rendered once, into
  whichever layout zone (start/center/end) the section computed for
  actions (see sections/header.liquid).

  @param section {Object} - the header section
  @param show_toggle_here {Boolean} - whether the menu toggle belongs in this zone
  @param [toggle_class] {String} - extra class for that toggle (e.g. desktop-only)

  @example
  {% render 'header-actions', section: section, show_toggle_here: true %}
{% enddoc %}

<div class="header__actions">
  {% if section.settings.localization_selector != 'none' %}
    {% render 'header-localization', section: section %}
  {% endif %}

  {% if section.settings.show_search %}
    {% render 'predictive-search' %}
  {% endif %}

  {% if section.settings.show_account and shop.customer_accounts_enabled %}
    <shopify-account
      menu="{{ settings.customer_account_menu }}"
      class="header__action header__account{% if section.settings.account_display == 'text' %} header__account--text{% endif %}"
      {% unless section.settings.account_display == 'text' %}data-tooltip="{{ 'accessibility.account' | t }}"{% endunless %}
    >
      <span slot="signed-out-avatar" class="header__account-avatar">
        {% if section.settings.account_display == 'text' %}
          <span class="header__account-text">{{ section.settings.account_text | default: 'Account' | escape }}</span>
        {% else %}
          {{ 'icon-account.svg' | inline_asset_content }}
        {% endif %}
      </span>
    </shopify-account>
  {% endif %}

  {% if section.settings.show_cart %}
    {% if settings.cart_type == 'drawer' %}
      <button
        type="button"
        class="header__action header__cart"
        data-panel-open="cart-panel-dialog"
        aria-label="{{ 'cart.title' | t }}"
        data-tooltip="{{ 'cart.title' | t }}"
      >
        {% if section.settings.show_cart_count %}
          <cart-count class="header__cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</cart-count>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </button>
    {% else %}
      <a href="{{ routes.cart_url }}" class="header__action header__cart" data-tooltip="{{ 'cart.title' | t }}">
        {% if section.settings.show_cart_count %}
          <cart-count class="header__cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</cart-count>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    {% endif %}
  {% endif %}

  {% if show_toggle_here %}
    {% render 'header-menu-toggle', section: section, modifier: toggle_class %}
  {% endif %}
</div>

{% javascript %}
  // Hover label for the header icons (search / account / cart): one
  // tooltip on <body> that follows the mouse, just below and right of the
  // cursor. Reads the text from the icon's data-tooltip attribute.
  (() => {
    if (window.headerTooltipReady) return;
    window.headerTooltipReady = true;

    const OFFSET_X = 14;
    const OFFSET_Y = 18;
    const EDGE = 8;
    let tip = null;
    let current = null;

    const getTip = () => {
      if (!tip || !tip.isConnected) {
        tip = document.createElement('div');
        tip.className = 'header-tooltip';
        tip.setAttribute('aria-hidden', 'true');
        document.body.appendChild(tip);
      }
      return tip;
    };

    const hide = () => {
      current = null;
      if (tip) tip.classList.remove('is-visible');
    };

    document.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const target = event.target.closest && event.target.closest('.header__actions [data-tooltip]');
      if (!target || target.closest('.predictive-search[open]')) {
        hide();
        return;
      }

      const el = getTip();
      if (target !== current) {
        current = target;
        el.textContent = target.dataset.tooltip;
        el.style.color = getComputedStyle(target).color;
      }

      // Keep it on screen: flip to the left of the cursor near the right edge.
      let x = event.clientX + OFFSET_X;
      const y = event.clientY + OFFSET_Y;
      if (x + el.offsetWidth > window.innerWidth - EDGE) {
        x = event.clientX - OFFSET_X - el.offsetWidth;
      }
      el.style.transform = `translate(${x}px, ${y}px)`;
      el.classList.add('is-visible');
    });

    document.documentElement.addEventListener('mouseleave', hide);
    document.addEventListener('pointerdown', hide);
    window.addEventListener('scroll', hide, { passive: true });
  })();
{% endjavascript %}
