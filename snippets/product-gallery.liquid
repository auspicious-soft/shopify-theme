{% doc %}
  Renders the product media gallery for sections/product.liquid.

  Layouts (Product section > Media > Gallery layout):
  - thumbnails: main slider with a thumbnail strip below
  - thumbnails_left: main slider with a vertical thumbnail strip beside it
  - carousel: main slider with arrows and a counter, no thumbnails
  - grid: two-column grid of every media on desktop
  - stacked: one full-width media after another on desktop
  Below 990px every layout becomes a swipeable slider with a counter.

  Images can open in a full-screen zoom lightbox (Enable image zoom).
  Videos, external videos and 3D models are supported. The <product-page>
  element (sections/product.liquid) calls `showMedia(id)` when the selected
  variant has its own image.

  @param {product} product - The product
  @param {object} section - The product section (for settings and ids)
  @param {object} [featured_media] - Media to show first (selected variant's)

  @example
  {% render 'product-gallery', product: product, section: section, featured_media: featured_media %}
{% enddoc %}

<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>

{%- liquid
  assign layout = section.settings.gallery_layout
  assign gallery_id = 'ProductGallery-' | append: section.id
  assign featured_media = featured_media | default: product.featured_media
  assign zoom = section.settings.enable_zoom

  case section.settings.media_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    else
      assign ratio = nil
  endcase

  case section.settings.media_size
    when 'small'
      assign media_sizes = '(min-width: 990px) 40vw, 100vw'
    when 'large'
      assign media_sizes = '(min-width: 990px) 62vw, 100vw'
    else
      assign media_sizes = '(min-width: 990px) 52vw, 100vw'
  endcase
  if layout == 'grid'
    assign media_sizes = media_sizes | replace: '62vw', '31vw' | replace: '52vw', '26vw' | replace: '40vw', '20vw'
  endif

  assign show_thumbs = false
  if layout == 'thumbnails' or layout == 'thumbnails_left'
    if product.media.size > 1
      assign show_thumbs = true
    endif
  endif

  assign featured_index = 0
  for media in product.media
    if media.id == featured_media.id
      assign featured_index = forloop.index0
    endif
  endfor

  assign image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

<product-gallery
  id="{{ gallery_id }}"
  class="product-gallery product-gallery--{{ layout }}{% if show_thumbs %} product-gallery--has-thumbs{% endif %}{% if product.media.size <= 1 %} product-gallery--single{% endif %}"
  data-start-index="{{ featured_index }}"
  {% if ratio %}style="--media-ratio: {{ ratio }};"{% endif %}
>
  <div class="product-gallery__viewport">
    {% if product.media.size > 0 %}
      <ul class="product-gallery__track" role="list" data-gallery-track>
        {% for media in product.media %}
          {%- liquid
            assign loading = 'lazy'
            if forloop.index0 == featured_index
              assign loading = 'eager'
            endif
            assign media_ratio = media.preview_image.aspect_ratio | default: 1
          -%}
          <li
            class="product-gallery__slide product-gallery__slide--{{ media.media_type }}{% if forloop.index0 == featured_index %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            style="--slide-ratio: {{ media_ratio }};"
            {% unless forloop.index0 == featured_index %}aria-hidden="true"{% endunless %}
          >
            {% case media.media_type %}
              {% when 'image' %}
                {%- capture image_markup -%}
                  {{
                    media
                    | image_url: width: 2000
                    | image_tag:
                      class: 'product-gallery__image',
                      loading: loading,
                      widths: '400, 600, 800, 1000, 1300, 1600, 2000',
                      sizes: media_sizes,
                      alt: media.alt
                  }}
                {%- endcapture -%}
                {% if zoom %}
                  <button
                    type="button"
                    class="product-gallery__zoom"
                    data-open-lightbox
                    data-media-id="{{ media.id }}"
                    aria-label="{{ 'products.zoom' | t: index: forloop.index }}"
                  >
                    {{ image_markup }}
                    <span class="product-gallery__zoom-icon" aria-hidden="true">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                  </button>
                {% else %}
                  <div class="product-gallery__frame">{{ image_markup }}</div>
                {% endif %}
              {% when 'video' %}
                <div class="product-gallery__frame product-gallery__frame--video">
                  {{
                    media
                    | video_tag:
                      class: 'product-gallery__video',
                      image_size: '1600x',
                      controls: true,
                      playsinline: true,
                      preload: 'metadata',
                      loop: section.settings.video_loop,
                      muted: section.settings.video_loop
                  }}
                </div>
              {% when 'external_video' %}
                <div class="product-gallery__frame product-gallery__frame--video">
                  {{ media | external_video_tag: class: 'product-gallery__video', loading: 'lazy' }}
                </div>
              {% when 'model' %}
                <div class="product-gallery__frame product-gallery__frame--model">
                  {{ media | model_viewer_tag: image_size: '1600x', reveal: 'interaction', toggleable: true, class: 'product-gallery__model' }}
                </div>
            {% endcase %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="product-gallery__frame product-gallery__frame--placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
      </div>
    {% endif %}

    {% if product.media.size > 1 %}
      <div class="product-gallery__controls">
        <button type="button" class="product-gallery__arrow product-gallery__arrow--prev" data-gallery-prev aria-label="{{ 'products.previous_media' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
        <p class="product-gallery__counter" aria-live="polite">
          <span data-gallery-current>{{ featured_index | plus: 1 }}</span>
          <span aria-hidden="true">/</span>
          <span class="visually-hidden">{{ 'products.of' | t }}</span>
          <span>{{ product.media.size }}</span>
        </p>
        <button type="button" class="product-gallery__arrow product-gallery__arrow--next" data-gallery-next aria-label="{{ 'products.next_media' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
      </div>
    {% endif %}
  </div>

  {% if show_thumbs %}
    <ul class="product-gallery__thumbs" role="list" data-gallery-thumbs>
      {% for media in product.media %}
        <li>
          <button
            type="button"
            class="product-gallery__thumb{% if forloop.index0 == featured_index %} is-active{% endif %}"
            data-thumb-index="{{ forloop.index0 }}"
            aria-label="{{ 'products.show_media' | t: index: forloop.index }}"
            {% if forloop.index0 == featured_index %}aria-current="true"{% endif %}
          >
            {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '5rem', widths: '120, 180, 240', alt: '' }}
            {% if media.media_type == 'video' or media.media_type == 'external_video' or media.media_type == 'model' %}
              <span class="product-gallery__thumb-badge" aria-hidden="true">
                {%- if media.media_type == 'model' -%}3D{%- else -%}▶{%- endif -%}
              </span>
            {% endif %}
          </button>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if zoom and image_count > 0 %}
    <dialog class="product-lightbox" aria-label="{{ 'products.zoom_dialog' | t }}" data-lightbox>
      <button type="button" class="product-lightbox__close" data-lightbox-close aria-label="{{ 'accessibility.close' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
      <ul class="product-lightbox__track" role="list" data-lightbox-track>
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            <li class="product-lightbox__slide" data-media-id="{{ media.id }}">
              {{
                media
                | image_url: width: 3000
                | image_tag: loading: 'lazy', widths: '1000, 1500, 2000, 3000', sizes: '100vw', alt: media.alt
              }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% if image_count > 1 %}
        <button type="button" class="product-lightbox__arrow product-lightbox__arrow--prev" data-lightbox-prev aria-label="{{ 'products.previous_media' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
        <button type="button" class="product-lightbox__arrow product-lightbox__arrow--next" data-lightbox-next aria-label="{{ 'products.next_media' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
      {% endif %}
    </dialog>
  {% endif %}
</product-gallery>

