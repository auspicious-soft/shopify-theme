{% doc %}
  Renders the horizontal desktop navigation, built from the header
  section's `menu` link list setting, with one level of hover/focus
  dropdowns for items that have sub-links.

  @param section {Object} - the header section

  @example
  {% render 'header-navigation', section: section %}
{% enddoc %}

<nav class="header__navigation" aria-label="{{ 'accessibility.primary_navigation' | t }}">
  <ul class="header__menu" role="list">
    {% for link in section.settings.menu.links %}
      <li class="header__menu-item{% if link.links != blank %} header__menu-item--has-dropdown{% endif %}">
        <a
          href="{{ link.url }}"
          class="header__menu-link"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{ link.title }}
        </a>
        {% if link.links != blank %}
          <ul class="header__dropdown" role="list">
            {% for child_link in link.links %}
              <li class="header__dropdown-item">
                <a href="{{ child_link.url }}" class="header__dropdown-link">{{ child_link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
