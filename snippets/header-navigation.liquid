{% doc %}
  Renders the horizontal desktop navigation, built from the header
  section's `menu` link list setting. Items with sub-links get a chevron
  and open on hover/focus as either (Header settings > Navigation >
  Submenu type):

  - "dropdown": a compact list under the item; 3rd-level links fly out to
    the side of their parent.
  - "mega": a full-width panel under the header, with each 2nd-level link
    as a column heading and its 3rd-level links listed beneath it. A
    "Mega menu promo" block whose Menu item matches the top-level item's
    title adds an optional image and/or title-with-link on the right.

  Both use Theme settings > Colors > Menu drawer color scheme.

  @param section {Object} - the header section

  @example
  {% render 'header-navigation', section: section %}
{% enddoc %}

{%- liquid
  assign submenu_type = section.settings.desktop_submenu_type | default: 'dropdown'
  assign menu_scheme = settings.menu_drawer_color_scheme.id
-%}

<nav
  class="header__navigation header__navigation--{{ submenu_type }}"
  aria-label="{{ 'accessibility.primary_navigation' | t }}"
>
  <ul class="header__menu" role="list">
    {% for link in section.settings.menu.links %}
      <li class="header__menu-item{% if link.links != blank %} header__menu-item--has-dropdown{% endif %}">
        <a
          href="{{ link.url }}"
          class="header__menu-link"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{ link.title }}
          {%- if link.links != blank -%}
            <span class="header__menu-chevron" aria-hidden="true">{{ 'icon-chevron.svg' | inline_asset_content }}</span>
          {%- endif -%}
        </a>

        {% if link.links != blank %}
          {% if submenu_type == 'mega' %}
            {%- liquid
              assign promo = nil
              assign link_title = link.title | strip | downcase
              for block in section.blocks
                if block.type == 'mega_menu_promo'
                  assign block_item = block.settings.menu_item | strip | downcase
                  if block_item == link_title or block_item == link.handle
                    assign promo = block
                    break
                  endif
                endif
              endfor

              assign show_promo_image = false
              assign show_promo_title = false
              if promo
                if promo.settings.show_image and promo.settings.image != blank
                  assign show_promo_image = true
                endif
                if promo.settings.show_title and promo.settings.title != blank
                  assign show_promo_title = true
                endif
              endif
            -%}
            <div class="header__mega color-{{ menu_scheme }}">
              <div class="header__mega-inner page-width">
                <ul class="header__mega-columns" role="list">
                  {% for child_link in link.links %}
                    <li class="header__mega-column">
                      <a
                        href="{{ child_link.url }}"
                        class="header__mega-heading"
                        {% if child_link.active %}aria-current="page"{% endif %}
                      >
                        {{- child_link.title -}}
                      </a>
                      {% if child_link.links != blank %}
                        <ul class="header__mega-list" role="list">
                          {% for grandchild_link in child_link.links %}
                            <li>
                              <a
                                href="{{ grandchild_link.url }}"
                                class="header__mega-link"
                                {% if grandchild_link.active %}aria-current="page"{% endif %}
                              >
                                {{- grandchild_link.title -}}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>

                {% if show_promo_image or show_promo_title %}
                  {%- liquid
                    assign promo_url = promo.settings.link
                    assign promo_tag = 'div'
                    if promo_url != blank
                      assign promo_tag = 'a'
                    endif
                  -%}
                  <{{ promo_tag }}
                    class="header__mega-promo"
                    {% if promo_url != blank %}href="{{ promo_url }}"{% endif %}
                    {{ promo.shopify_attributes }}
                  >
                    {% if show_promo_image %}
                      <span class="header__mega-promo-image">
                        {{
                          promo.settings.image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '300, 400, 600, 800',
                            sizes: '(min-width: 989px) 20rem, 100vw',
                            alt: promo.settings.image.alt
                        }}
                      </span>
                    {% endif %}
                    {% if show_promo_title %}
                      <span class="header__mega-promo-title">{{ promo.settings.title | escape }}</span>
                    {% endif %}
                  </{{ promo_tag }}>
                {% endif %}
              </div>
            </div>

          {% else %}
            <ul class="header__dropdown color-{{ menu_scheme }}" role="list">
              {% for child_link in link.links %}
                <li class="header__dropdown-item{% if child_link.links != blank %} header__dropdown-item--has-children{% endif %}">
                  <a
                    href="{{ child_link.url }}"
                    class="header__dropdown-link"
                    {% if child_link.active %}aria-current="page"{% endif %}
                  >
                    {{ child_link.title }}
                    {%- if child_link.links != blank -%}
                      <span class="header__menu-chevron header__menu-chevron--side" aria-hidden="true">
                        {{- 'icon-chevron.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </a>
                  {% if child_link.links != blank %}
                    <ul class="header__dropdown header__dropdown--nested color-{{ menu_scheme }}" role="list">
                      {% for grandchild_link in child_link.links %}
                        <li class="header__dropdown-item">
                          <a
                            href="{{ grandchild_link.url }}"
                            class="header__dropdown-link"
                            {% if grandchild_link.active %}aria-current="page"{% endif %}
                          >
                            {{- grandchild_link.title -}}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
