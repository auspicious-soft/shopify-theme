{% doc %}
  Renders a product card. Everything it shows comes from Theme settings >
  Product cards: style (standard/card), image ratio + fit, second image on
  hover, vendor, rating, color swatches, quick add (none / on image hover /
  button under the content), text alignment, image padding, color scheme,
  border and shadow. Styles live in assets/product-card.css (load it once in
  the section that renders cards).

  The whole card is clickable through the title link's stretched ::after;
  swatches and quick add sit above it so they stay usable.

  @param {product} product - The product to render
  @param {string} [sizes] - `sizes` attribute for the card images
  @param {boolean} [eager] - Load the image eagerly (above-the-fold cards)
  @param {string} [heading_tag] - Title tag, defaults to h3
  @param {boolean} [image_slider] - Show every product image with prev/next arrows (and swipe on touch) instead of the hover image
  @param {string} [size_options] - Size buttons on the image: 'none' (default), 'hover' or 'always'
  @param {string} [size_option_name] - Name of the option to show as size buttons, defaults to "Size"

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign featured = product.featured_media

  case settings.card_image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = featured.preview_image.aspect_ratio | default: 1
  endcase

  assign use_slider = false
  if image_slider and product.media.size > 1
    assign use_slider = true
  endif

  assign secondary = nil
  if settings.card_show_secondary_image and product.media.size > 1 and use_slider == false
    assign secondary = product.media[1]
  endif

  assign size_mode = size_options | default: 'none'
  assign size_option = nil
  if size_mode != 'none'
    assign wanted_size_name = size_option_name | default: 'Size' | downcase | strip
    for option in product.options_with_values
      assign option_name = option.name | downcase | strip
      if option_name == wanted_size_name
        assign size_option = option
        break
      endif
    endfor
  endif

  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  assign quick_add = settings.card_quick_add | default: 'none'
  assign card_variant = product.selected_or_first_available_variant
-%}

<div
  class="product-card product-card--{{ settings.card_style }} product-card--quick-add-{{ quick_add }} product-card--align-{{ settings.card_text_alignment }} hover-{{ settings.animations_hover_elements }} color-{{ settings.card_color_scheme.id }}"
  style="--card-ratio: {{ ratio }}; --card-image-padding: {{ settings.card_image_padding }}px; --card-text-align: {{ settings.card_text_alignment }};"
  {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}
>
  <div class="product-card__media product-card__media--{{ settings.card_image_fit | default: 'cover' }}{% if secondary %} product-card__media--has-secondary{% endif %}{% if use_slider %} product-card__media--slider{% endif %}">
    {%- if use_slider -%}
      <card-image-slider class="product-card__slider">
        <div class="product-card__media-frame product-card__slides" data-card-slides>
          {%- for media in product.media limit: 8 -%}
            <a
              href="{{ product.url }}"
              class="product-card__slide"
              tabindex="-1"
              aria-hidden="true"
              draggable="false"
            >
              {{
                media.preview_image
                | image_url: width: 1000
                | image_tag:
                  class: 'product-card__image',
                  loading: loading,
                  widths: '240, 360, 480, 640, 800, 1000',
                  sizes: image_sizes,
                  alt: media.preview_image.alt
              }}
            </a>
          {%- endfor -%}
        </div>
        <button type="button" class="product-card__slide-arrow product-card__slide-arrow--prev" data-card-prev aria-label="{{ 'products.scroll_previous' | t }}" disabled>
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
        <button type="button" class="product-card__slide-arrow product-card__slide-arrow--next" data-card-next aria-label="{{ 'products.scroll_next' | t }}">
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </button>
      </card-image-slider>
    {%- else -%}
    <div class="product-card__media-frame">
      {%- if featured -%}
        {{
          featured.preview_image
          | image_url: width: 1000
          | image_tag:
            class: 'product-card__image product-card__image--primary',
            loading: loading,
            widths: '240, 360, 480, 640, 800, 1000',
            sizes: image_sizes,
            alt: featured.preview_image.alt
        }}
        {%- if secondary -%}
          {{
            secondary.preview_image
            | image_url: width: 1000
            | image_tag:
              class: 'product-card__image product-card__image--secondary',
              loading: 'lazy',
              widths: '240, 360, 480, 640, 800, 1000',
              sizes: image_sizes,
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {%- endif -%}
    </div>
    {%- endif -%}

    {% render 'badge', product: product %}

    {% if size_option and size_option.values.size > 0 %}
      <ul
        class="product-card__sizes product-card__sizes--{{ size_mode }}{% if quick_add == 'overlay' %} product-card__sizes--above-quick-add{% endif %}"
        role="list"
        aria-label="{{ size_option.name | escape }}"
      >
        {% for value in size_option.values %}
          {%- liquid
            assign size_url = product.url
            if value.variant
              assign size_url = value.variant.url
            endif
          -%}
          <li>
            <a
              href="{{ size_url }}"
              class="product-card__size{% if value.available == false %} product-card__size--unavailable{% endif %}"
              title="{{ value | escape }}"
            >
              {{- value | escape -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if quick_add == 'overlay' %}
      <div class="product-card__quick-add product-card__quick-add--overlay">
        {% render 'product-card-quick-add', product: product, variant: card_variant %}
      </div>
    {% endif %}
  </div>

  <div class="product-card__content">
    {% if settings.card_show_vendor and product.vendor != blank %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}

    <{{ heading_tag }} class="product-card__title">
      <a href="{{ product.url }}" class="product-card__link">{{ product.title | escape }}</a>
    </{{ heading_tag }}>

    {% if settings.card_show_rating and product.metafields.reviews.rating.value != blank %}
      {%- liquid
        assign rating = product.metafields.reviews.rating.value
        assign rating_max = rating.scale_max | default: 5
        assign rating_percent = rating.rating | times: 100.0 | divided_by: rating_max
      -%}
      <div class="product-card__rating" role="img" aria-label="{{ 'products.rating' | t: rating: rating.rating, max: rating_max }}">
        <span class="rating-stars" style="--rating-percent: {{ rating_percent }}%;" aria-hidden="true"></span>
        {% if product.metafields.reviews.rating_count.value > 0 %}
          <span class="product-card__rating-count">({{ product.metafields.reviews.rating_count.value }})</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-card__price">
      {%- if product.price_varies -%}
        <span class="product-card__price-from">{{ 'products.price_from' | t }}</span>
      {%- endif -%}
      {% render 'price', price: product.price, compare_at_price: product.compare_at_price %}
    </div>

    {% if settings.card_show_swatches %}
      {%- liquid
        assign swatch_option = nil
        for option in product.options_with_values
          assign option_name = option.name | downcase
          if option_name == 'color' or option_name == 'colour'
            assign swatch_option = option
            break
          endif
        endfor
      -%}
      {% if swatch_option and swatch_option.values.size > 1 %}
        <ul class="product-card__swatches" role="list" aria-label="{{ swatch_option.name | escape }}">
          {% for value in swatch_option.values limit: 5 %}
            {%- liquid
              assign swatch_color = value.swatch.color | default: value
              assign swatch_url = product.url
              if value.variant
                assign swatch_url = value.variant.url
              endif
            -%}
            <li>
              <a
                href="{{ swatch_url }}"
                class="product-card__swatch"
                style="--swatch-color: {{ swatch_color | downcase | escape }};{% if value.swatch.image %} --swatch-image: url('{{ value.swatch.image | image_url: width: 60 }}');{% endif %}"
                title="{{ value | escape }}"
              >
                <span class="visually-hidden">{{ value | escape }}</span>
              </a>
            </li>
          {% endfor %}
          {% if swatch_option.values.size > 5 %}
            <li class="product-card__swatch-more">+{{ swatch_option.values.size | minus: 5 }}</li>
          {% endif %}
        </ul>
      {% endif %}
    {% endif %}

    {% if quick_add == 'button' %}
      <div class="product-card__quick-add product-card__quick-add--button">
        {% render 'product-card-quick-add', product: product, variant: card_variant %}
      </div>
    {% endif %}
  </div>
</div>

{% javascript %}
  if (!customElements.get('card-image-slider')) {
    class CardImageSlider extends HTMLElement {
      connectedCallback() {
        this.slides = this.querySelector('[data-card-slides]');
        this.prev = this.querySelector('[data-card-prev]');
        this.next = this.querySelector('[data-card-next]');
        if (!this.slides) return;

        this.update = this.update.bind(this);
        this.onClick = this.onClick.bind(this);
        this.slides.addEventListener('scroll', this.update, { passive: true });
        this.addEventListener('click', this.onClick);
        this.update();
      }

      onClick(event) {
        const arrow = event.target.closest('[data-card-prev], [data-card-next]');
        if (!arrow) return;
        event.preventDefault();
        event.stopPropagation();
        const direction = arrow.hasAttribute('data-card-next') ? 1 : -1;
        const sign = document.dir === 'rtl' ? -1 : 1;
        this.slides.scrollBy({ left: direction * sign * this.slides.clientWidth, behavior: 'smooth' });
      }

      update() {
        const max = this.slides.scrollWidth - this.slides.clientWidth;
        const position = Math.abs(this.slides.scrollLeft);
        if (this.prev) this.prev.disabled = position <= 2;
        if (this.next) this.next.disabled = position >= max - 2;
      }
    }

    customElements.define('card-image-slider', CardImageSlider);
  }
{% endjavascript %}
