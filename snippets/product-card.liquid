{% doc %}
  The theme's one product card, used everywhere products are listed
  (collection pages, featured collection, recommended / related / recently
  viewed products). Everything it shows comes from Theme settings >
  Product cards.

  - Image slider: every product image. Drag with the mouse, swipe on touch
    screens, or use the prev/next arrows on hover (optional). Each image
    links to the product; a drag never opens the link.
  - Sale badge: "Save €53", "Save 20%" or "Sale", updated per variant.
  - Color swatches: picking a color shows that color's image, price and
    badge, and which of its sizes are in stock.
  - Quick add (on hover, always, or hidden):
      * a grid of sizes; clicking one adds the chosen color + size to cart
      * products with options but no size: "Add to cart" for the chosen variant
      * products without options: "Add to cart"
    Adding opens the cart drawer through the theme's `cart:item-added`
    event, or goes to the cart page when Theme settings > Cart is "page".

  Styles live in assets/product-card.css; load it once in the section that
  renders cards.

  @param {product} product - The product to render
  @param {string} [sizes] - `sizes` attribute for the images
  @param {boolean} [eager] - Load the first image eagerly (above-the-fold cards)
  @param {string} [heading_tag] - Title tag, defaults to h3

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign current = product.selected_or_first_available_variant
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign fit = settings.card_image_fit | default: 'cover'
  assign badge_mode = settings.card_badge_style | default: 'amount'
  assign layout = settings.card_info_layout | default: 'inline'
  assign use_slider = settings.card_image_slider
  assign use_swatches = settings.card_show_swatches

  # Older saved values ("overlay" / "button") map onto the current options.
  assign mode = settings.card_quick_add | default: 'hover'
  case mode
    when 'overlay'
      assign mode = 'hover'
    when 'button'
      assign mode = 'always'
  endcase

  case settings.card_image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = product.featured_media.preview_image.aspect_ratio | default: 0.8
  endcase

  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  # Find the color and size options by name (case-insensitive).
  assign color_name = settings.card_color_option_name | default: 'Color' | downcase | strip
  assign size_name = settings.card_size_option_name | default: 'Size' | downcase | strip
  assign color_option = nil
  assign size_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == color_name
      assign color_option = option
    elsif color_name == 'color' and option_name == 'colour'
      assign color_option = option
    endif
    if option_name == size_name
      assign size_option = option
    endif
  endfor

  assign color_index = -1
  if color_option
    assign color_index = color_option.position | minus: 1
  endif
  assign size_index = -1
  if size_option
    assign size_index = size_option.position | minus: 1
  endif

  assign media_list = product.media
  if use_slider == false
    assign media_list = product.media | slice: 0, 1
  endif
-%}

{%- capture badge_for_current -%}
  {%- if current.available == false -%}
    {{ 'badges.sold_out' | t }}
  {%- elsif current.compare_at_price > current.price -%}
    {%- case badge_mode -%}
      {%- when 'text' -%}
        {{ 'badges.sale' | t }}
      {%- when 'percent' -%}
        {%- assign percent = current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round -%}
        {{ 'products.save_percent' | t: percent: percent }}
      {%- else -%}
        {%- assign saved = current.compare_at_price | minus: current.price | money_without_trailing_zeros -%}
        {{ 'products.save_amount' | t: amount: saved }}
    {%- endcase -%}
  {%- endif -%}
{%- endcapture -%}

<product-card
  class="product-card product-card--{{ settings.card_style }} product-card--quick-{{ mode }}{% if settings.card_quick_add_touch %} product-card--quick-touch{% endif %} product-card--info-{{ layout }} product-card--align-{{ settings.card_text_alignment }} hover-{{ settings.animations_hover_elements }} color-{{ settings.card_color_scheme.id }}"
  data-color-index="{{ color_index }}"
  data-size-index="{{ size_index }}"
  data-selected="{{ current.options | json | escape }}"
  data-cart-type="{{ settings.cart_type }}"
  data-product-url="{{ product.url }}"
  style="--card-ratio: {{ ratio }}; --card-image-padding: {{ settings.card_image_padding }}px; --card-image-bg: {{ settings.card_image_background }}; --card-sale-color: {{ settings.card_sale_price_color }};"
  {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}
>
  <div class="product-card__media product-card__media--{{ fit }}">
    <div class="product-card__slides{% if use_slider and product.media.size > 1 %} product-card__slides--draggable{% endif %}" data-card-slides>
      {%- for media in media_list limit: 10 -%}
        {%- liquid
          assign slide_loading = 'lazy'
          if forloop.first
            assign slide_loading = loading
          endif
          assign slide_alt = media.preview_image.alt | default: product.title
        -%}
        <a
          href="{{ product.url }}"
          class="product-card__slide"
          draggable="false"
          {% unless forloop.first %}
            tabindex="-1" aria-hidden="true"
          {% endunless %}
        >
          {{
            media.preview_image
            | image_url: width: 1000
            | image_tag:
              class: 'product-card__image',
              loading: slide_loading,
              widths: '240, 360, 480, 640, 800, 1000',
              sizes: image_sizes,
              alt: slide_alt
          }}
        </a>
      {%- else -%}
        <a href="{{ product.url }}" class="product-card__slide" draggable="false">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
        </a>
      {%- endfor -%}
    </div>

    {%- if use_slider and settings.card_image_arrows and product.media.size > 1 -%}
      <button type="button" class="product-card__arrow product-card__arrow--prev" data-card-prev aria-label="{{ 'products.previous_media' | t }}" disabled>
        {{ 'icon-chevron.svg' | inline_asset_content }}
      </button>
      <button type="button" class="product-card__arrow product-card__arrow--next" data-card-next aria-label="{{ 'products.next_media' | t }}">
        {{ 'icon-chevron.svg' | inline_asset_content }}
      </button>
    {%- endif -%}

    <span
      class="badge product-card__badge color-{% if current.available %}{{ settings.sale_badge_color_scheme.id }}{% else %}{{ settings.sold_out_badge_color_scheme.id }}{% endif %} badge--{{ settings.badge_position | handleize }}"
      style="--badge-radius: {{ settings.badge_corner_radius }}px;"
      data-sale-scheme="color-{{ settings.sale_badge_color_scheme.id }}"
      data-sold-out-scheme="color-{{ settings.sold_out_badge_color_scheme.id }}"
      data-card-badge
      {% if badge_for_current == blank %}hidden{% endif %}
    >
      {{- badge_for_current | strip -}}
    </span>

    {%- if mode != 'none' and product.available -%}
      <div class="product-card__quick">
        {%- if product.has_only_default_variant -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="product-card__quick-form">
            <input type="hidden" name="id" value="{{ current.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="product-card__add" data-card-add>
              <span class="product-card__add-label">{{ 'products.add_to_cart' | t }}</span>
              <span class="product-card__add-done">{{ 'products.added_to_cart' | t }}</span>
            </button>
          </form>
        {%- elsif size_option -%}
          <ul class="product-card__sizes" role="list" aria-label="{{ size_option.name | escape }}">
            {%- for value in size_option.values -%}
              <li>
                <button
                  type="button"
                  class="product-card__size"
                  data-card-size="{{ value | escape }}"
                  aria-label="{{ 'products.add_size_to_cart' | t: size: value }}"
                >
                  {{- value | escape -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <button type="button" class="product-card__add" data-card-add-current>
            <span class="product-card__add-label">{{ 'products.add_to_cart' | t }}</span>
            <span class="product-card__add-done">{{ 'products.added_to_cart' | t }}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <div class="product-card__row">
      <div class="product-card__titles">
        {%- if settings.card_show_vendor and product.vendor != blank -%}
          <p class="product-card__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} class="product-card__title">
          <a href="{{ product.url }}" class="product-card__link" data-card-link>{{ product.title | escape }}</a>
        </{{ heading_tag }}>
      </div>

      <div class="product-card__price" data-card-price>
        {%- if current.compare_at_price > current.price -%}
          <s class="product-card__compare">{{ current.compare_at_price | money }}</s>
          <span class="product-card__amount product-card__amount--sale">{{ current.price | money }}</span>
        {%- else -%}
          <span class="product-card__amount">{{ current.price | money }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- if settings.card_show_rating and product.metafields.reviews.rating.value != blank -%}
      {%- liquid
        assign rating = product.metafields.reviews.rating.value
        assign rating_max = rating.scale_max | default: 5
        assign rating_percent = rating.rating | times: 100.0 | divided_by: rating_max
      -%}
      <div class="product-card__rating" role="img" aria-label="{{ 'products.rating' | t: rating: rating.rating, max: rating_max }}">
        <span class="rating-stars" style="--rating-percent: {{ rating_percent }}%;" aria-hidden="true"></span>
        {%- if product.metafields.reviews.rating_count.value > 0 -%}
          <span class="product-card__rating-count">({{ product.metafields.reviews.rating_count.value }})</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if use_swatches and color_option and color_option.values.size > 1 -%}
      <ul class="product-card__swatches" role="list" aria-label="{{ color_option.name | escape }}">
        {%- for value in color_option.values limit: 8 -%}
          {%- assign swatch_color = value.swatch.color | default: value -%}
          <li>
            <button
              type="button"
              class="product-card__swatch"
              data-card-color="{{ value | escape }}"
              aria-pressed="{{ value.selected }}"
              title="{{ value | escape }}"
              style="--swatch-color: {{ swatch_color | downcase | escape }};{% if value.swatch.image %} --swatch-image: url('{{ value.swatch.image | image_url: width: 60 }}');{% endif %}"
            >
              <span class="visually-hidden">{{ value | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
        {%- if color_option.values.size > 8 -%}
          <li class="product-card__swatch-more">+{{ color_option.values.size | minus: 8 }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  <script type="application/json" data-card-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_badge = ''
          if variant.available == false
            assign variant_badge = 'badges.sold_out' | t
          elsif variant.compare_at_price > variant.price
            case badge_mode
              when 'text'
                assign variant_badge = 'badges.sale' | t
              when 'percent'
                assign variant_percent = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                assign variant_badge = 'products.save_percent' | t: percent: variant_percent
              else
                assign variant_saved = variant.compare_at_price | minus: variant.price | money_without_trailing_zeros
                assign variant_badge = 'products.save_amount' | t: amount: variant_saved
            endcase
          endif
          assign variant_media = 0
          if variant.featured_media
            assign variant_media = variant.featured_media.position
          endif
        -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "badge": {{ variant_badge | json }},
          "media": {{ variant_media }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</product-card>

{% javascript %}
  if (!customElements.get('product-card')) {
    class ProductCard extends HTMLElement {
      connectedCallback() {
        try {
          this.variants = JSON.parse(this.querySelector('[data-card-variants]')?.textContent || '[]');
          this.selected = JSON.parse(this.dataset.selected || '[]');
        } catch (error) {
          this.variants = [];
          this.selected = [];
        }
        this.colorIndex = Number(this.dataset.colorIndex);
        this.sizeIndex = Number(this.dataset.sizeIndex);
        this.slides = this.querySelector('[data-card-slides]');
        this.prev = this.querySelector('[data-card-prev]');
        this.next = this.querySelector('[data-card-next]');

        this.onClick = this.onClick.bind(this);
        this.onSubmit = this.onSubmit.bind(this);
        this.updateArrows = this.updateArrows.bind(this);
        this.addEventListener('click', this.onClick);
        this.addEventListener('submit', this.onSubmit);
        this.slides?.addEventListener('scroll', this.updateArrows, { passive: true });

        // Mouse drag to change image (touch screens already swipe natively).
        if (this.slides?.classList.contains('product-card__slides--draggable')) {
          this.onPointerDown = this.onPointerDown.bind(this);
          this.onPointerMove = this.onPointerMove.bind(this);
          this.onPointerUp = this.onPointerUp.bind(this);
          this.slides.addEventListener('pointerdown', this.onPointerDown);
          this.slides.addEventListener('pointermove', this.onPointerMove);
          this.slides.addEventListener('pointerup', this.onPointerUp);
          this.slides.addEventListener('pointercancel', this.onPointerUp);
          this.slides.addEventListener('dragstart', (event) => event.preventDefault());
        }

        this.updateArrows();
        this.updateAvailability();
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('submit', this.onSubmit);
        this.slides?.removeEventListener('scroll', this.updateArrows);
      }

      onPointerDown(event) {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        this.drag = { id: event.pointerId, startX: event.clientX, startScroll: this.slides.scrollLeft, moved: false };
      }

      onPointerMove(event) {
        if (!this.drag || event.pointerId !== this.drag.id) return;
        const dx = event.clientX - this.drag.startX;
        if (!this.drag.moved) {
          if (Math.abs(dx) < 5) return;
          this.drag.moved = true;
          // Snapping fights a hand-driven scroll, so it's off while dragging.
          this.slides.classList.add('is-dragging');
          this.slides.setPointerCapture(event.pointerId);
        }
        this.slides.scrollLeft = this.drag.startScroll - dx;
      }

      onPointerUp(event) {
        if (!this.drag || event.pointerId !== this.drag.id) return;
        const { moved, startX, startScroll } = this.drag;
        this.drag = null;
        if (!moved) return;

        if (this.slides.hasPointerCapture(event.pointerId)) this.slides.releasePointerCapture(event.pointerId);
        this.slides.classList.remove('is-dragging');

        // Settle on the next/previous image once dragged a little, like a swipe.
        const width = this.slides.clientWidth;
        const startIndex = Math.round(Math.abs(startScroll) / width);
        const dx = event.clientX - startX;
        const threshold = Math.min(60, width * 0.15);
        let index = startIndex;
        if (Math.abs(dx) > threshold) index += (dx < 0 ? 1 : -1) * (document.dir === 'rtl' ? -1 : 1);
        this.showSlide(Math.max(0, Math.min(index, this.slides.children.length - 1)));

        // The click that ends a drag must not open the product.
        this.suppressClick = true;
        setTimeout(() => (this.suppressClick = false), 0);
      }

      onClick(event) {
        if (this.suppressClick && event.target.closest('.product-card__slide')) {
          event.preventDefault();
          this.suppressClick = false;
          return;
        }
        const target = event.target;
        const arrow = target.closest('[data-card-prev], [data-card-next]');
        if (arrow) {
          event.preventDefault();
          this.step(arrow.hasAttribute('data-card-next') ? 1 : -1);
          return;
        }

        const swatch = target.closest('[data-card-color]');
        if (swatch) {
          event.preventDefault();
          this.selectColor(swatch.dataset.cardColor);
          return;
        }

        const size = target.closest('[data-card-size]');
        if (size) {
          event.preventDefault();
          if (size.getAttribute('aria-disabled') === 'true') return;
          this.add(this.findVariant({ [this.sizeIndex]: size.dataset.cardSize }), size);
          return;
        }

        const addCurrent = target.closest('[data-card-add-current]');
        if (addCurrent) {
          event.preventDefault();
          this.add(this.findVariant(), addCurrent);
        }
      }

      /** Single-variant products use a real form (works without JS); add it over Ajax here. */
      onSubmit(event) {
        const form = event.target.closest('.product-card__quick-form');
        if (!form) return;
        event.preventDefault();
        const id = Number(new FormData(form).get('id'));
        this.add(this.variants.find((variant) => variant.id === id) || { id, available: true }, form.querySelector('[data-card-add]'));
      }

      /** The variant matching the current selection, with some options overridden. */
      findVariant(overrides = {}) {
        const wanted = this.selected.map((value, index) => (index in overrides ? overrides[index] : value));
        return this.variants.find((variant) => variant.options.every((value, index) => value === wanted[index]));
      }

      selectColor(color) {
        if (this.colorIndex < 0) return;
        this.selected[this.colorIndex] = color;

        // Keep the other options if that combination exists in this color,
        // otherwise switch to the first available variant of the color.
        let variant = this.findVariant();
        if (!variant || !variant.available) {
          variant =
            this.variants.find((v) => v.options[this.colorIndex] === color && v.available) ||
            this.variants.find((v) => v.options[this.colorIndex] === color);
          if (variant) this.selected = [...variant.options];
        }

        this.querySelectorAll('[data-card-color]').forEach((swatch) => {
          swatch.setAttribute('aria-pressed', String(swatch.dataset.cardColor === color));
        });

        if (variant) {
          this.renderVariant(variant);
          if (variant.media > 0) this.showSlide(variant.media - 1);
        }
        this.updateAvailability();
      }

      renderVariant(variant) {
        const price = this.querySelector('[data-card-price]');
        if (price) {
          price.innerHTML = variant.compare
            ? `<s class="product-card__compare">${variant.compare}</s><span class="product-card__amount product-card__amount--sale">${variant.price}</span>`
            : `<span class="product-card__amount">${variant.price}</span>`;
        }

        const badge = this.querySelector('[data-card-badge]');
        if (badge) {
          badge.textContent = variant.badge;
          badge.hidden = !variant.badge;
          badge.classList.remove(badge.dataset.saleScheme, badge.dataset.soldOutScheme);
          badge.classList.add(variant.available ? badge.dataset.saleScheme : badge.dataset.soldOutScheme);
        }

        const url = `${this.dataset.productUrl}${this.dataset.productUrl.includes('?') ? '&' : '?'}variant=${variant.id}`;
        this.querySelectorAll('[data-card-link], .product-card__slide').forEach((link) => link.setAttribute('href', url));
      }

      /** Grey out sizes (or the add button) that aren't in stock for the chosen color. */
      updateAvailability() {
        this.querySelectorAll('[data-card-size]').forEach((button) => {
          const variant = this.findVariant({ [this.sizeIndex]: button.dataset.cardSize });
          button.setAttribute('aria-disabled', String(!(variant && variant.available)));
        });

        const addCurrent = this.querySelector('[data-card-add-current]');
        if (addCurrent) {
          const variant = this.findVariant();
          addCurrent.disabled = !(variant && variant.available);
        }
      }

      async add(variant, button) {
        if (!variant || variant.available === false || !button) return;
        button.classList.add('is-loading');
        button.setAttribute('aria-busy', 'true');

        const root = window.Shopify?.routes?.root || '/';
        const productPage = `${this.dataset.productUrl}?variant=${variant.id}`;
        try {
          const response = await fetch(`${root}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] }),
          });

          if (!response.ok) {
            // Let the product page explain the problem (e.g. not enough stock).
            window.location.href = productPage;
            return;
          }

          if (this.dataset.cartType === 'page') {
            window.location.href = `${root}cart`;
            return;
          }

          document.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true }));
          button.classList.add('is-added');
          setTimeout(() => button.classList.remove('is-added'), 1500);
        } catch (error) {
          window.location.href = productPage;
        } finally {
          button.classList.remove('is-loading');
          button.removeAttribute('aria-busy');
        }
      }

      step(direction) {
        if (!this.slides) return;
        const sign = document.dir === 'rtl' ? -1 : 1;
        this.slides.scrollBy({ left: direction * sign * this.slides.clientWidth, behavior: 'smooth' });
      }

      showSlide(index) {
        const slide = this.slides?.children[index];
        if (!slide) return;
        this.slides.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }

      updateArrows() {
        if (!this.slides || !this.prev || !this.next) return;
        const max = this.slides.scrollWidth - this.slides.clientWidth;
        const position = Math.abs(this.slides.scrollLeft);
        this.prev.disabled = position <= 2;
        this.next.disabled = position >= max - 2;
      }
    }

    customElements.define('product-card', ProductCard);
  }
{% endjavascript %}
