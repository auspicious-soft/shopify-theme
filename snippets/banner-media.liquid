{% doc %}
  Background media for banner sections: an image (with an optional separate
  mobile image) or a background video. Fills its parent, which must be
  positioned (e.g. `position: absolute; inset: 0` or `relative` with a size).

  Video can be a Shopify-hosted file (with an optional mobile file) or a
  YouTube / Vimeo link; the hosted file wins when both are set. Videos play
  muted, looped and inline with no controls. The image is kept underneath
  as the poster while the video loads, and is shown instead of the video
  for visitors who prefer reduced motion.

  Below 750px the mobile image / video are used when set.

  Styles live in assets/banner-media.css; load it once in the section that
  renders this snippet.

  @param {image} [image] - Desktop image (also the video poster/fallback)
  @param {image} [mobile_image] - Image for screens under 750px
  @param {boolean} [show_video] - Use the video settings instead of only the image
  @param {video} [video] - Shopify-hosted video
  @param {video} [mobile_video] - Shopify-hosted video for screens under 750px
  @param {object} [video_url] - YouTube or Vimeo `video_url` setting value
  @param {string} [alt] - Alt text for the image
  @param {string} [sizes] - `sizes` for the desktop image, defaults to 100vw
  @param {boolean} [eager] - Load eagerly with high priority (first banner on the page)
  @param {string} [placeholder] - Placeholder SVG name when nothing is set, e.g. 'lifestyle-1'

  @example
  {% render 'banner-media',
    image: section.settings.image,
    mobile_image: section.settings.mobile_image,
    show_video: true,
    video: section.settings.video,
    video_url: section.settings.video_url,
    alt: section.settings.heading
  %}
{% enddoc %}

{%- liquid
  assign image_sizes = sizes | default: '100vw'
  assign loading = 'lazy'
  assign priority = 'auto'
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  endif

  assign has_hosted = false
  assign has_external = false
  if show_video
    if video != blank
      assign has_hosted = true
    elsif video_url != blank and video_url.id != blank
      assign has_external = true
    endif
  endif
  assign has_video = false
  if has_hosted or has_external
    assign has_video = true
  endif

  # The hosted video's own preview frame is the fallback when no image is set.
  assign poster = image
  if poster == blank and has_hosted
    assign poster = video.preview_image
  endif
  assign mobile_poster = mobile_image
  if mobile_poster == blank and has_hosted and mobile_video != blank
    assign mobile_poster = mobile_video.preview_image
  endif
-%}

<div class="banner-media{% if has_video %} banner-media--video{% endif %}">
  {%- if poster != blank -%}
    {{
      poster
      | image_url: width: 3200
      | image_tag:
        class: 'banner-media__image banner-media__image--desktop',
        widths: '750, 1100, 1500, 2000, 2560, 3200',
        sizes: image_sizes,
        loading: loading,
        fetchpriority: priority,
        alt: alt
    }}
    {%- if mobile_poster != blank -%}
      {{
        mobile_poster
        | image_url: width: 1500
        | image_tag:
          class: 'banner-media__image banner-media__image--mobile',
          widths: '375, 550, 750, 1100, 1500',
          sizes: '100vw',
          loading: loading,
          fetchpriority: priority,
          alt: alt
      }}
    {%- endif -%}
  {%- elsif has_video == false and placeholder != blank -%}
    {{ placeholder | placeholder_svg_tag: 'banner-media__image banner-media__placeholder' }}
  {%- endif -%}

  {%- if has_hosted -%}
    {{
      video
      | video_tag:
        class: 'banner-media__video banner-media__video--desktop',
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        controls: false,
        preload: 'metadata',
        image_size: '1600x'
    }}
    {%- if mobile_video != blank -%}
      {{
        mobile_video
        | video_tag:
          class: 'banner-media__video banner-media__video--mobile',
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '900x'
      }}
    {%- endif -%}
  {%- elsif has_external -%}
    {%- liquid
      if video_url.type == 'youtube'
        assign embed_src = 'https://www.youtube-nocookie.com/embed/' | append: video_url.id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: video_url.id | append: '&controls=0&playsinline=1&rel=0&modestbranding=1&disablekb=1&iv_load_policy=3'
      else
        assign embed_src = 'https://player.vimeo.com/video/' | append: video_url.id | append: '?background=1&autoplay=1&loop=1&muted=1&dnt=1'
      endif
    -%}
    <div class="banner-media__embed">
      <iframe
        src="{{ embed_src }}"
        title="{{ alt | default: 'Background video' | escape }}"
        allow="autoplay; encrypted-media; picture-in-picture"
        loading="{{ loading }}"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    </div>
  {%- endif -%}
</div>
