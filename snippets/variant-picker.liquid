{% doc %}
  Renders the product page variant picker (Product section > Variant
  picker block): every option as pills or a dropdown, with color options
  optionally shown as swatches (the option value's swatch from the Shopify
  admin, or its name as a CSS color). Values that can't be bought with the
  other current selections are struck through / marked "Unavailable".

  It only reports choices: the <product-page> element in
  sections/product.liquid listens for `change` on `[data-option-input]`,
  resolves the variant, updates the form and re-renders this picker (it has
  `data-product-part`, so it's swapped for the server's fresh markup).

  @param {product} product - The product
  @param {object} block - The variant picker block (picker_type, show_swatches)
  @param {string} section_id - The section id, for unique element ids

  @example
  {% render 'variant-picker', product: product, block: block, section_id: section.id %}
{% enddoc %}

<div
  id="VariantPicker-{{ section_id }}"
  class="variant-picker"
  data-variant-picker
  data-product-part
  {{ block.shopify_attributes }}
>
  {% for option in product.options_with_values %}
    {%- liquid
      assign option_index = forloop.index0
      assign option_id = 'Option-' | append: section_id | append: '-' | append: option_index
      assign option_name = option.name | downcase
      assign is_swatch = false
      if block.settings.show_swatches
        if option_name == 'color' or option_name == 'colour'
          assign is_swatch = true
        endif
      endif
    -%}

    {% if block.settings.picker_type == 'dropdown' and is_swatch == false %}
      <div class="variant-picker__field">
        <label class="variant-picker__label" for="{{ option_id }}">{{ option.name | escape }}</label>
        <div class="variant-picker__select">
          <select id="{{ option_id }}" data-option-input data-option-index="{{ option_index }}">
            {% for value in option.values %}
              <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                {{- value | escape -}}
                {%- unless value.available %} — {{ 'products.unavailable' | t }}{% endunless -%}
              </option>
            {% endfor %}
          </select>
          {{ 'icon-chevron.svg' | inline_asset_content }}
        </div>
      </div>
    {% else %}
      <fieldset class="variant-picker__fieldset">
        <legend class="variant-picker__label">
          {{ option.name | escape }}:
          <span class="variant-picker__selected" data-selected-value>{{ option.selected_value | escape }}</span>
        </legend>
        <div class="variant-picker__values{% if is_swatch %} variant-picker__values--swatch{% endif %}">
          {% for value in option.values %}
            {%- assign value_id = option_id | append: '-' | append: forloop.index0 -%}
            <input
              type="radio"
              id="{{ value_id }}"
              name="{{ option_id }}"
              value="{{ value | escape }}"
              class="variant-picker__input"
              data-option-input
              data-option-index="{{ option_index }}"
              {% if option.selected_value == value %}checked{% endif %}
            >
            {% if is_swatch %}
              <label
                for="{{ value_id }}"
                class="variant-picker__swatch{% unless value.available %} is-unavailable{% endunless %}"
                style="{% render 'swatch-style', value: value %}"
                title="{{ value | escape }}"
              >
                <span class="visually-hidden">
                  {{- value | escape -}}
                  {%- unless value.available %}, {{ 'products.unavailable' | t }}{% endunless -%}
                </span>
              </label>
            {% else %}
              <label for="{{ value_id }}" class="variant-picker__pill{% unless value.available %} is-unavailable{% endunless %}">
                {{- value | escape -}}
                {%- unless value.available -%}
                  <span class="visually-hidden">, {{ 'products.unavailable' | t }}</span>
                {%- endunless -%}
              </label>
            {% endif %}
          {% endfor %}
        </div>
      </fieldset>
    {% endif %}
  {% endfor %}
</div>
