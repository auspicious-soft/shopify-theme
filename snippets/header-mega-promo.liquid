{% doc %}
  Renders the "Mega menu promo" block (image and/or title with link) that
  belongs to a top-level menu link, if any. A block matches when its Menu
  item setting equals the link's title (case-insensitive) or handle.
  Renders nothing when there's no match, or when both the image and the
  title are switched off or empty.

  Shared by the desktop mega menu (snippets/header-navigation.liquid) and
  the mobile menu drawer (snippets/header-drawer.liquid).

  @param section {Object} - the header section
  @param link {Object} - the top-level menu link
  @param [modifier] {String} - extra class for placement-specific styling
  @param [sizes] {String} - image `sizes` attribute

  @example
  {% render 'header-mega-promo', section: section, link: link %}
{% enddoc %}

{%- liquid
  assign promo = nil
  assign link_title = link.title | strip | downcase
  for block in section.blocks
    if block.type == 'mega_menu_promo'
      assign block_item = block.settings.menu_item | strip | downcase
      if block_item == link_title or block_item == link.handle
        assign promo = block
        break
      endif
    endif
  endfor

  assign show_promo_image = false
  assign show_promo_title = false
  if promo
    if promo.settings.show_image and promo.settings.image != blank
      assign show_promo_image = true
    endif
    if promo.settings.show_title and promo.settings.title != blank
      assign show_promo_title = true
    endif
  endif
-%}

{%- if show_promo_image or show_promo_title -%}
  {%- liquid
    assign promo_url = promo.settings.link
    assign promo_tag = 'div'
    if promo_url != blank
      assign promo_tag = 'a'
    endif
    assign image_sizes = sizes | default: '(min-width: 989px) 20rem, 100vw'
  -%}
  <{{ promo_tag }}
    class="header__mega-promo{% if modifier != blank %} {{ modifier }}{% endif %}"
    {% if promo_url != blank %}href="{{ promo_url }}"{% endif %}
    {{ promo.shopify_attributes }}
  >
    {% if show_promo_image %}
      <span class="header__mega-promo-image">
        {{
          promo.settings.image
          | image_url: width: 800
          | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: image_sizes, alt: promo.settings.image.alt
        }}
      </span>
    {% endif %}
    {% if show_promo_title %}
      <span class="header__mega-promo-title">{{ promo.settings.title | escape }}</span>
    {% endif %}
  </{{ promo_tag }}>
{%- endif -%}
