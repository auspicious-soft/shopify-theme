{% doc %}
  Renders the header's country/currency and language selector: a trigger
  showing the current country's flag and "Country (CUR $)" label, which
  opens a small dropdown popup holding a Language and/or a Country/region
  select. Each select submits Shopify's localization form as soon as it
  changes. Header settings > Country/language selector > Show selector
  picks country, language, or both; the whole thing renders nothing when
  set to Hidden (or the store has only one country, when that is the only
  kind shown). The language select shows even with a single language.
  The popup uses Theme settings > Colors > Popup color scheme, shared by
  every popup in the theme.

  Open/close and click-outside/Escape handling come from theme-panel.liquid.
  Styling lives in assets/header-localization.css (loaded below).

  With `placement: 'drawer'` the same trigger + popup renders in the menu
  drawer's footer (where the selector lives on mobile; the header copy is
  hidden below 989px), with the popup opening upward.

  @param section {Object} - the header section
  @param [placement] {String} - 'header' (default) or 'drawer' (popup opens upward, full label on mobile)

  @example
  {% render 'header-localization', section: section %}
  {% render 'header-localization', section: section, placement: 'drawer' %}
{% enddoc %}

{% liquid
  assign selector = section.settings.localization_selector

  assign show_country = false
  if selector == 'country' or selector == 'both'
    if localization.available_countries.size > 1
      assign show_country = true
    endif
  endif

  # The language select shows even with one language (e.g. only English),
  # so customers always see which language the store is in.
  assign show_language = false
  if selector == 'language' or selector == 'both'
    if localization.available_languages.size > 0
      assign show_language = true
    endif
  endif
%}

{% if show_country or show_language %}
  {{ 'header-localization.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'header-localization.js' | asset_url }}" defer></script>

  {%- liquid
    assign placement = placement | default: 'header'
    if placement == 'drawer'
      assign panel_id = 'HeaderDrawerLocalization-' | append: section.id
    else
      assign panel_id = 'HeaderLocalization-' | append: section.id
    endif
  -%}

  {% capture localization_form %}
  {% form 'localization', class: 'header-localization__form' %}
    {%- comment -%}
      Each option is a submit button carrying its own value, so a click
      switches straight away (no JavaScript needed). The current one is
      highlighted.
    {%- endcomment -%}
    {% if show_language %}
      <div class="header-localization__field">
        <p class="header-localization__heading" id="{{ panel_id }}-language">{{ 'localization.language' | t }}:</p>
        <ul class="header-localization__options" role="list" aria-labelledby="{{ panel_id }}-language">
          {% for language in localization.available_languages %}
            {%- assign is_current = false -%}
            {%- if language.iso_code == localization.language.iso_code -%}{%- assign is_current = true -%}{%- endif -%}
            <li>
              <button
                type="submit"
                name="language_code"
                value="{{ language.iso_code }}"
                class="header-localization__option{% if is_current %} is-active{% endif %}"
                lang="{{ language.iso_code }}"
                aria-label="{{ language.endonym_name | capitalize }}"
                {% if is_current %}aria-current="true"{% endif %}
              >
                {{- language.iso_code | upcase -}}
              </button>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if show_country %}
      {%- comment -%}
        One entry per currency. It switches to the current country when that
        uses the currency, otherwise to the first country that does.
      {%- endcomment -%}
      <div class="header-localization__field">
        <p class="header-localization__heading" id="{{ panel_id }}-currency">{{ 'localization.currency' | t }}:</p>
        <ul class="header-localization__options" role="list" aria-labelledby="{{ panel_id }}-currency">
          {%- assign seen_currencies = ',' -%}
          {% for country in localization.available_countries %}
            {%- liquid
              assign currency_code = country.currency.iso_code
              assign currency_key = ',' | append: currency_code | append: ','
              if seen_currencies contains currency_key
                continue
              endif
              assign seen_currencies = seen_currencies | append: currency_code | append: ','

              assign target_country = country.iso_code
              if localization.country.currency.iso_code == currency_code
                assign target_country = localization.country.iso_code
              endif
              assign is_current = false
              if currency_code == cart.currency.iso_code
                assign is_current = true
              endif
            -%}
            <li>
              <button
                type="submit"
                name="country_code"
                value="{{ target_country }}"
                class="header-localization__option{% if is_current %} is-active{% endif %}"
                {% if is_current %}aria-current="true"{% endif %}
              >
                {{- country.currency.name | default: currency_code -}}
              </button>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endform %}
  {% endcapture %}

  {% render 'theme-panel' %}

  <header-localization class="header-localization header-localization--{{ placement }}">
    <theme-panel>
      <details id="{{ panel_id }}" class="header-localization__details">
        <summary
          class="header-localization__trigger"
          data-panel-open="{{ panel_id }}"
          aria-label="{{ 'localization.title' | t }}"
        >
          <span class="header-localization__label">
            {%- if show_language -%}{{ localization.language.iso_code | upcase }}{%- endif -%}
            {%- if show_language and show_country %} / {% endif -%}
            {%- comment -%} cart.currency: the currency prices and checkout use right now. {%- endcomment -%}
            {%- if show_country -%}{{ cart.currency.symbol | default: cart.currency.iso_code }}{%- endif -%}
          </span>
          <span class="header-localization__chevron">{{ 'icon-chevron.svg' | inline_asset_content }}</span>
        </summary>

        <div class="header-localization__panel color-{{ settings.popup_color_scheme.id }}">
          {{ localization_form }}
        </div>
      </details>
    </theme-panel>
  </header-localization>
{% endif %}
