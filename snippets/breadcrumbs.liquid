{% doc %}
  Breadcrumb trail for the current page (Home / … / current page), plus
  schema.org BreadcrumbList structured data so search engines can show the
  path in results. Rendered inside each page's main section (under the
  title; above the gallery on product pages) when that section's "Show
  breadcrumbs" setting is on. Separator, home icon, mobile visibility and
  the extra collection steps come from Theme settings > Breadcrumbs.
  Loads its own styles (assets/breadcrumbs.css).

  Trails:
  - Product: Home / Collection / Product. The collection is the one in the
    URL (/collections/x/products/y), else the product's first collection
    when Theme settings > Breadcrumbs allows it.
  - Collection: Home / (Collections) / Collection / (Tag)
  - Collection list: Home / Collections
  - Blog: Home / Blog / (Tag)      Article: Home / Blog / Article
  - Page, 404: Home / Page name

  Renders nothing on the home page.

  @param {string} [class] - Extra class for spacing in the host section

  @example
  {% render 'breadcrumbs', class: 'page__breadcrumbs' %}
{% enddoc %}

{%- liquid
  assign separator = settings.breadcrumbs_separator | default: 'chevron'
  assign product_collection = settings.breadcrumbs_product_collection
  assign collections_link = settings.breadcrumbs_collections_link
  assign home_icon = settings.breadcrumbs_home_icon

  # Names and URLs are built as two parallel lists joined by a delimiter
  # that won't appear in titles, then split for output.
  assign sep = '::bc::'
  assign home_label = 'breadcrumbs.home' | t
  assign names = home_label
  assign urls = routes.root_url

  case request.page_type
    when 'product'
      assign trail_collection = collection
      if trail_collection == blank and product_collection
        assign trail_collection = product.collections.first
      endif
      if trail_collection != blank
        assign names = names | append: sep | append: trail_collection.title
        assign urls = urls | append: sep | append: trail_collection.url
      endif
      assign names = names | append: sep | append: product.title
      assign urls = urls | append: sep | append: product.url

    when 'collection'
      if collections_link
        assign label = 'collections.title' | t
        assign names = names | append: sep | append: label
        assign urls = urls | append: sep | append: routes.collections_url
      endif
      assign names = names | append: sep | append: collection.title
      assign urls = urls | append: sep | append: collection.url
      if current_tags
        assign names = names | append: sep | append: current_tags.first
        assign urls = urls | append: sep | append: request.path
      endif

    when 'list-collections'
      assign label = 'collections.title' | t
      assign names = names | append: sep | append: label
      assign urls = urls | append: sep | append: routes.collections_url

    when 'blog'
      assign names = names | append: sep | append: blog.title
      assign urls = urls | append: sep | append: blog.url
      if current_tags
        assign names = names | append: sep | append: current_tags.first
        assign urls = urls | append: sep | append: request.path
      endif

    when 'article'
      assign names = names | append: sep | append: blog.title | append: sep | append: article.title
      assign urls = urls | append: sep | append: blog.url | append: sep | append: article.url

    when 'page'
      assign names = names | append: sep | append: page.title
      assign urls = urls | append: sep | append: page.url

    when '404'
      assign label = '404.not_found' | t
      assign names = names | append: sep | append: label
      assign urls = urls | append: sep | append: request.path
  endcase

  assign name_list = names | split: sep
  assign url_list = urls | split: sep
-%}

{%- if request.page_type != 'index' and name_list.size > 1 -%}
  {{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}

  <nav
    class="breadcrumbs breadcrumbs--{{ separator }}{% unless settings.breadcrumbs_show_mobile %} breadcrumbs--hide-mobile{% endunless %} {{ class }}"
    aria-label="{{ 'breadcrumbs.label' | t }}"
  >
    <ol class="breadcrumbs__list" role="list">
      {%- for name in name_list -%}
        {%- assign i = forloop.index0 -%}
        <li class="breadcrumbs__item">
          {%- if forloop.last -%}
            <span class="breadcrumbs__current" aria-current="page">{{ name | escape }}</span>
          {%- else -%}
            <a href="{{ url_list[i] }}" class="breadcrumbs__link">
              {%- if forloop.first and home_icon -%}
                <svg class="breadcrumbs__home-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M3.5 9 10 3.5 16.5 9"/><path d="M5 7.8v8.7h10V7.8"/><path d="M8.5 16.5v-4.5h3v4.5"/>
                </svg>
                <span class="visually-hidden">{{ name | escape }}</span>
              {%- else -%}
                {{- name | escape -}}
              {%- endif -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- for name in name_list -%}
          {%- assign i = forloop.index0 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ name | json }},
            "item": {{ request.origin | append: url_list[i] | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
