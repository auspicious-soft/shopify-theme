{% doc %}
  Product card with quick shopping, used by sections/featured-collection.liquid.

  - Image slider: every product image, prev/next arrows on hover, swipe on
    touch screens. Each image links to the product.
  - Sale badge: "Sale", "Save €53" or "Save 20%", updated per variant.
  - Color swatches: picking a color shows that color's image, price and
    badge, and which of its sizes are in stock.
  - Quick add, shown on hover (and optionally always on touch screens):
      * a grid of sizes; clicking one adds the chosen color + size to cart
      * products with options but no size: an "Add to cart" button for the
        chosen variant
      * products without options: an "Add to cart" button
    Adding opens the cart drawer through the theme's `cart:item-added`
    event, or goes to the cart page when Theme settings > Cart is "page".

  Styles live in assets/product-card-quick-shop.css; load it once in the
  section that renders these cards.

  @param {product} product - The product to render
  @param {string} [sizes] - `sizes` attribute for the images
  @param {boolean} [eager] - Load the first image eagerly
  @param {string} [image_ratio] - CSS aspect ratio for the image area, e.g. '4 / 5'
  @param {string} [image_fit] - 'cover' (default) or 'contain'
  @param {boolean} [image_slider] - Show every image with arrows, defaults to true
  @param {boolean} [show_swatches] - Show color swatches, defaults to true
  @param {string} [color_option_name] - Option shown as swatches, defaults to "Color" (also matches "Colour")
  @param {string} [quick_add] - 'hover' (default), 'always' or 'none'
  @param {boolean} [quick_add_touch] - Keep quick add visible on touch screens (no hover there)
  @param {string} [size_option_name] - Option shown as the size grid, defaults to "Size"
  @param {string} [badge_style] - 'amount' (default, "Save €53"), 'percent' or 'text' ("Sale")
  @param {string} [info_layout] - 'inline' (default, title and price on one row) or 'stacked'
  @param {boolean} [show_vendor] - Show the vendor above the title

  @example
  {% render 'product-card-quick-shop', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign ratio = image_ratio | default: '4 / 5'
  assign fit = image_fit | default: 'cover'
  assign mode = quick_add | default: 'hover'
  assign badge_mode = badge_style | default: 'amount'
  assign layout = info_layout | default: 'inline'

  assign use_slider = true
  if image_slider == false
    assign use_slider = false
  endif
  assign use_swatches = true
  if show_swatches == false
    assign use_swatches = false
  endif

  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  # Find the color and size options by name (case-insensitive).
  assign color_name = color_option_name | default: 'Color' | downcase | strip
  assign size_name = size_option_name | default: 'Size' | downcase | strip
  assign color_option = nil
  assign size_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == color_name
      assign color_option = option
    elsif color_name == 'color' and option_name == 'colour'
      assign color_option = option
    endif
    if option_name == size_name
      assign size_option = option
    endif
  endfor

  assign color_index = -1
  if color_option
    assign color_index = color_option.position | minus: 1
  endif
  assign size_index = -1
  if size_option
    assign size_index = size_option.position | minus: 1
  endif

  assign media_list = product.media
  if use_slider == false
    assign media_list = product.media | slice: 0, 1
  endif
-%}

{%- capture badge_for_current -%}
  {%- if current.available == false -%}
    {{ 'badges.sold_out' | t }}
  {%- elsif current.compare_at_price > current.price -%}
    {%- case badge_mode -%}
      {%- when 'text' -%}
        {{ 'badges.sale' | t }}
      {%- when 'percent' -%}
        {%- assign percent = current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round -%}
        {{ 'products.save_percent' | t: percent: percent }}
      {%- else -%}
        {%- assign saved = current.compare_at_price | minus: current.price | money_without_trailing_zeros -%}
        {{ 'products.save_amount' | t: amount: saved }}
    {%- endcase -%}
  {%- endif -%}
{%- endcapture -%}

<quick-shop-card
  class="qs-card qs-card--quick-{{ mode }}{% if quick_add_touch %} qs-card--quick-touch{% endif %} qs-card--info-{{ layout }}"
  data-color-index="{{ color_index }}"
  data-size-index="{{ size_index }}"
  data-selected="{{ current.options | json | escape }}"
  data-cart-type="{{ settings.cart_type }}"
  data-product-url="{{ product.url }}"
  style="--qs-ratio: {{ ratio }};"
  {% if settings.animations_reveal_on_scroll %}data-animate{% endif %}
>
  <div class="qs-card__media qs-card__media--{{ fit }}">
    <div class="qs-card__slides" data-card-slides>
      {%- for media in media_list limit: 10 -%}
        <a
          href="{{ product.url }}"
          class="qs-card__slide"
          draggable="false"
          {% unless forloop.first %}
            tabindex="-1" aria-hidden="true"
          {% endunless %}
        >
          {%- liquid
            assign slide_loading = 'lazy'
            if forloop.first
              assign slide_loading = loading
            endif
            assign slide_alt = media.preview_image.alt | default: product.title
          -%}
          {{
            media.preview_image
            | image_url: width: 1000
            | image_tag:
              class: 'qs-card__image',
              loading: slide_loading,
              widths: '240, 360, 480, 640, 800, 1000',
              sizes: image_sizes,
              alt: slide_alt
          }}
        </a>
      {%- else -%}
        <a href="{{ product.url }}" class="qs-card__slide" draggable="false">
          {{ 'product-1' | placeholder_svg_tag: 'qs-card__image qs-card__placeholder' }}
        </a>
      {%- endfor -%}
    </div>

    {%- if use_slider and product.media.size > 1 -%}
      <button type="button" class="qs-card__arrow qs-card__arrow--prev" data-card-prev aria-label="{{ 'products.previous_media' | t }}" disabled>
        {{ 'icon-chevron.svg' | inline_asset_content }}
      </button>
      <button type="button" class="qs-card__arrow qs-card__arrow--next" data-card-next aria-label="{{ 'products.next_media' | t }}">
        {{ 'icon-chevron.svg' | inline_asset_content }}
      </button>
    {%- endif -%}

    <span
      class="badge qs-card__badge color-{% if current.available %}{{ settings.sale_badge_color_scheme.id }}{% else %}{{ settings.sold_out_badge_color_scheme.id }}{% endif %} badge--{{ settings.badge_position | handleize }}"
      style="--badge-radius: {{ settings.badge_corner_radius }}px;"
      data-sale-scheme="color-{{ settings.sale_badge_color_scheme.id }}"
      data-sold-out-scheme="color-{{ settings.sold_out_badge_color_scheme.id }}"
      data-card-badge
      {% if badge_for_current == blank %}hidden{% endif %}
    >
      {{- badge_for_current | strip -}}
    </span>

    {%- if mode != 'none' and product.available -%}
      <div class="qs-card__quick">
        {%- if product.has_only_default_variant -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="qs-card__quick-form">
            <input type="hidden" name="id" value="{{ current.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="qs-card__add" data-card-add>
              <span class="qs-card__add-label">{{ 'products.add_to_cart' | t }}</span>
              <span class="qs-card__add-done">{{ 'products.added_to_cart' | t }}</span>
            </button>
          </form>
        {%- elsif size_option -%}
          <ul class="qs-card__sizes" role="list" aria-label="{{ size_option.name | escape }}">
            {%- for value in size_option.values -%}
              <li>
                <button
                  type="button"
                  class="qs-card__size"
                  data-card-size="{{ value | escape }}"
                  aria-label="{{ 'products.add_size_to_cart' | t: size: value }}"
                >
                  {{- value | escape -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <button type="button" class="qs-card__add" data-card-add-current>
            <span class="qs-card__add-label">{{ 'products.add_to_cart' | t }}</span>
            <span class="qs-card__add-done">{{ 'products.added_to_cart' | t }}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="qs-card__info">
    <div class="qs-card__row">
      <div class="qs-card__titles">
        {%- if show_vendor and product.vendor != blank -%}
          <p class="qs-card__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h3 class="qs-card__title">
          <a href="{{ product.url }}" class="qs-card__link" data-card-link>{{ product.title | escape }}</a>
        </h3>
      </div>

      <div class="qs-card__price" data-card-price>
        {%- if current.compare_at_price > current.price -%}
          <s class="qs-card__compare">{{ current.compare_at_price | money }}</s>
          <span class="qs-card__amount qs-card__amount--sale">{{ current.price | money }}</span>
        {%- else -%}
          <span class="qs-card__amount">{{ current.price | money }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- if use_swatches and color_option and color_option.values.size > 1 -%}
      <ul class="qs-card__swatches" role="list" aria-label="{{ color_option.name | escape }}">
        {%- for value in color_option.values limit: 8 -%}
          {%- liquid
            assign swatch_color = value.swatch.color | default: value
            assign is_selected = false
            if value.selected
              assign is_selected = true
            endif
          -%}
          <li>
            <button
              type="button"
              class="qs-card__swatch"
              data-card-color="{{ value | escape }}"
              aria-pressed="{{ is_selected }}"
              title="{{ value | escape }}"
              style="--swatch-color: {{ swatch_color | downcase | escape }};{% if value.swatch.image %} --swatch-image: url('{{ value.swatch.image | image_url: width: 60 }}');{% endif %}"
            >
              <span class="visually-hidden">{{ value | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
        {%- if color_option.values.size > 8 -%}
          <li class="qs-card__swatch-more">+{{ color_option.values.size | minus: 8 }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  <script type="application/json" data-card-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_badge = ''
          if variant.available == false
            assign variant_badge = 'badges.sold_out' | t
          elsif variant.compare_at_price > variant.price
            case badge_mode
              when 'text'
                assign variant_badge = 'badges.sale' | t
              when 'percent'
                assign variant_percent = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                assign variant_badge = 'products.save_percent' | t: percent: variant_percent
              else
                assign variant_saved = variant.compare_at_price | minus: variant.price | money_without_trailing_zeros
                assign variant_badge = 'products.save_amount' | t: amount: variant_saved
            endcase
          endif
          assign variant_media = 0
          if variant.featured_media
            assign variant_media = variant.featured_media.position
          endif
        -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "badge": {{ variant_badge | json }},
          "media": {{ variant_media }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</quick-shop-card>

{% javascript %}
  if (!customElements.get('quick-shop-card')) {
    class QuickShopCard extends HTMLElement {
      connectedCallback() {
        try {
          this.variants = JSON.parse(this.querySelector('[data-card-variants]')?.textContent || '[]');
          this.selected = JSON.parse(this.dataset.selected || '[]');
        } catch (error) {
          this.variants = [];
          this.selected = [];
        }
        this.colorIndex = Number(this.dataset.colorIndex);
        this.sizeIndex = Number(this.dataset.sizeIndex);
        this.slides = this.querySelector('[data-card-slides]');
        this.prev = this.querySelector('[data-card-prev]');
        this.next = this.querySelector('[data-card-next]');

        this.onClick = this.onClick.bind(this);
        this.onSubmit = this.onSubmit.bind(this);
        this.updateArrows = this.updateArrows.bind(this);
        this.addEventListener('click', this.onClick);
        this.addEventListener('submit', this.onSubmit);
        this.slides?.addEventListener('scroll', this.updateArrows, { passive: true });

        this.updateArrows();
        this.updateAvailability();
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('submit', this.onSubmit);
        this.slides?.removeEventListener('scroll', this.updateArrows);
      }

      onClick(event) {
        const target = event.target;
        const arrow = target.closest('[data-card-prev], [data-card-next]');
        if (arrow) {
          event.preventDefault();
          this.step(arrow.hasAttribute('data-card-next') ? 1 : -1);
          return;
        }

        const swatch = target.closest('[data-card-color]');
        if (swatch) {
          event.preventDefault();
          this.selectColor(swatch.dataset.cardColor);
          return;
        }

        const size = target.closest('[data-card-size]');
        if (size) {
          event.preventDefault();
          if (size.getAttribute('aria-disabled') === 'true') return;
          this.add(this.findVariant({ [this.sizeIndex]: size.dataset.cardSize }), size);
          return;
        }

        const addCurrent = target.closest('[data-card-add-current]');
        if (addCurrent) {
          event.preventDefault();
          this.add(this.findVariant(), addCurrent);
        }
      }

      /** Single-variant products use a real form; add it over Ajax like the rest. */
      onSubmit(event) {
        const form = event.target.closest('.qs-card__quick-form');
        if (!form) return;
        event.preventDefault();
        const id = Number(new FormData(form).get('id'));
        this.add(this.variants.find((variant) => variant.id === id) || { id, available: true }, form.querySelector('[data-card-add]'));
      }

      /** The variant matching the current selection, with some options overridden. */
      findVariant(overrides = {}) {
        const wanted = this.selected.map((value, index) => (index in overrides ? overrides[index] : value));
        return this.variants.find((variant) => variant.options.every((value, index) => value === wanted[index]));
      }

      selectColor(color) {
        if (this.colorIndex < 0) return;
        this.selected[this.colorIndex] = color;

        // Keep the other options if that combination exists in this color,
        // otherwise switch to the first available variant of the color.
        let variant = this.findVariant();
        if (!variant || !variant.available) {
          variant =
            this.variants.find((v) => v.options[this.colorIndex] === color && v.available) ||
            this.variants.find((v) => v.options[this.colorIndex] === color);
          if (variant) this.selected = [...variant.options];
        }

        this.querySelectorAll('[data-card-color]').forEach((swatch) => {
          swatch.setAttribute('aria-pressed', String(swatch.dataset.cardColor === color));
        });

        if (variant) {
          this.renderVariant(variant);
          if (variant.media > 0) this.showSlide(variant.media - 1);
        }
        this.updateAvailability();
      }

      renderVariant(variant) {
        const price = this.querySelector('[data-card-price]');
        if (price) {
          price.innerHTML = variant.compare
            ? `<s class="qs-card__compare">${variant.compare}</s><span class="qs-card__amount qs-card__amount--sale">${variant.price}</span>`
            : `<span class="qs-card__amount">${variant.price}</span>`;
        }

        const badge = this.querySelector('[data-card-badge]');
        if (badge) {
          badge.textContent = variant.badge;
          badge.hidden = !variant.badge;
          badge.classList.remove(badge.dataset.saleScheme, badge.dataset.soldOutScheme);
          badge.classList.add(variant.available ? badge.dataset.saleScheme : badge.dataset.soldOutScheme);
        }

        const url = `${this.dataset.productUrl}${this.dataset.productUrl.includes('?') ? '&' : '?'}variant=${variant.id}`;
        this.querySelectorAll('[data-card-link], .qs-card__slide').forEach((link) => link.setAttribute('href', url));
      }

      /** Grey out sizes (or the add button) not in stock for the chosen color. */
      updateAvailability() {
        this.querySelectorAll('[data-card-size]').forEach((button) => {
          const variant = this.findVariant({ [this.sizeIndex]: button.dataset.cardSize });
          const available = Boolean(variant && variant.available);
          button.setAttribute('aria-disabled', String(!available));
        });

        const addCurrent = this.querySelector('[data-card-add-current]');
        if (addCurrent) {
          const variant = this.findVariant();
          addCurrent.disabled = !(variant && variant.available);
        }
      }

      async add(variant, button) {
        if (!variant || variant.available === false || !button) return;
        button.classList.add('is-loading');
        button.setAttribute('aria-busy', 'true');

        const root = window.Shopify?.routes?.root || '/';
        try {
          const response = await fetch(`${root}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] }),
          });

          if (!response.ok) {
            // Let the product page explain the problem (e.g. not enough stock).
            window.location.href = `${this.dataset.productUrl}?variant=${variant.id}`;
            return;
          }

          if (this.dataset.cartType === 'page') {
            window.location.href = `${root}cart`;
            return;
          }

          document.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true }));
          button.classList.add('is-added');
          setTimeout(() => button.classList.remove('is-added'), 1500);
        } catch (error) {
          window.location.href = `${this.dataset.productUrl}?variant=${variant.id}`;
        } finally {
          button.classList.remove('is-loading');
          button.removeAttribute('aria-busy');
        }
      }

      step(direction) {
        if (!this.slides) return;
        const sign = document.dir === 'rtl' ? -1 : 1;
        this.slides.scrollBy({ left: direction * sign * this.slides.clientWidth, behavior: 'smooth' });
      }

      showSlide(index) {
        const slide = this.slides?.children[index];
        if (!slide) return;
        this.slides.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }

      updateArrows() {
        if (!this.slides || !this.prev || !this.next) return;
        const max = this.slides.scrollWidth - this.slides.clientWidth;
        const position = Math.abs(this.slides.scrollLeft);
        this.prev.disabled = position <= 2;
        this.next.disabled = position >= max - 2;
      }
    }

    customElements.define('quick-shop-card', QuickShopCard);
  }
{% endjavascript %}
