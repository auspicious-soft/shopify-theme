{% doc %}
  Product filters (Shopify storefront filtering) for the collection and
  search pages: a sidebar on desktop or an off-canvas drawer (always a drawer
  below 990px), with "Clear all" / "View results". When there are no filters
  but sorting is on, renders just the (hidden) form the sort select posts with.

  Driven by assets/collection.js (<collection-page>): it submits the form
  with the Section Rendering API and swaps every [data-results-part].
  Styles live in assets/collection.css.

  @param {object} results - The collection or `search` object (filters, sort_by)
  @param {string} url - Form action, e.g. collection.url or routes.search_url
  @param {string} section_id - The section's id
  @param {boolean} filtering - Show the filters
  @param {boolean} sorting - Sorting is shown in the toolbar
  @param {string} filter_layout - 'drawer' or 'sidebar'
  @param {string} [button_size] - Drawer button size: small / medium / large
  @param {string} [hidden_inputs] - Extra hidden inputs (the search page's q / type)
  @param {string} [value_style] - How filter values show: 'checkbox' (default) list or 'pills'.
    Colour filters always show as swatches, and Availability as a checkbox list.

  @example
  {% render 'facets', results: collection, url: collection.url, section_id: section.id, filtering: true, sorting: true, filter_layout: 'drawer' %}
{% enddoc %}

{%- if filtering -%}
  <aside
    id="Facets-{{ section_id }}"
    class="facets facets--{{ filter_layout }} facets--buttons-{{ button_size | default: 'medium' }}"
    aria-labelledby="FacetsHeading-{{ section_id }}"
    data-facets
  >
    <div class="facets__backdrop" data-facets-close></div>
    <div class="facets__panel">
      <div class="facets__header">
        <h2 id="FacetsHeading-{{ section_id }}" class="facets__heading h6">{{ 'collections.filters' | t }}</h2>
        <button type="button" class="facets__close" data-facets-close aria-label="{{ 'accessibility.close' | t }}">
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <form
        id="FacetsForm-{{ section_id }}"
        class="facets__form"
        action="{{ url }}"
        method="get"
        data-facets-form
        data-results-part
      >
        {{ hidden_inputs }}

        {% unless sorting %}
          <input type="hidden" name="sort_by" value="{{ results.sort_by | escape }}">
        {% endunless %}

        {% for filter in results.filters %}
          {%- liquid
            assign group_id = 'FacetGroup-' | append: section_id | append: '-' | append: forloop.index
            assign group_active = filter.active_values.size

            # How this filter's values show: colour swatches, a checkbox list
            # (always for Availability / yes-no filters) or the chosen style.
            assign list_mode = value_style | default: 'checkbox'
            assign filter_label_lower = filter.label | downcase
            if filter.type == 'boolean' or filter.param_name contains 'availability'
              assign list_mode = 'checkbox'
            elsif filter.presentation == 'swatch' or filter_label_lower contains 'color' or filter_label_lower contains 'colour'
              assign list_mode = 'swatches'
            endif
            if filter.type == 'price_range'
              assign group_active = 0
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign group_active = 1
              endif
            endif
          -%}
          <details id="{{ group_id }}" class="facets__group"{% if group_active > 0 or forloop.index <= 3 %} open{% endif %}>
            <summary class="facets__summary">
              <span>
                {{- filter.label | escape -}}
                {%- if group_active > 0 and filter.type != 'price_range' %}
                  <span class="facets__summary-count">({{ group_active }})</span>
                {%- endif -%}
              </span>
              <span class="facets__plus" aria-hidden="true"></span>
            </summary>

            {% if filter.type == 'price_range' %}
              {%- liquid
                assign range_max = filter.range_max | divided_by: 100.0 | ceil
                assign min_display = ''
                assign max_display = ''
                if filter.min_value.value != nil
                  assign min_display = filter.min_value.value | divided_by: 100.0
                endif
                if filter.max_value.value != nil
                  assign max_display = filter.max_value.value | divided_by: 100.0
                endif
              -%}
              <div class="facets__price">
                <div class="facets__price-field">
                  <label for="{{ group_id }}-min" class="facets__price-label">{{ 'collections.price_from' | t }}</label>
                  <div class="facets__price-input">
                    <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                    <input
                      id="{{ group_id }}-min"
                      type="number"
                      inputmode="decimal"
                      name="{{ filter.min_value.param_name }}"
                      value="{{ min_display }}"
                      placeholder="0"
                      min="0"
                      max="{{ range_max }}"
                      step="any"
                      data-facets-price
                    >
                  </div>
                </div>
                <span class="facets__price-sep" aria-hidden="true">–</span>
                <div class="facets__price-field">
                  <label for="{{ group_id }}-max" class="facets__price-label">{{ 'collections.price_to' | t }}</label>
                  <div class="facets__price-input">
                    <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                    <input
                      id="{{ group_id }}-max"
                      type="number"
                      inputmode="decimal"
                      name="{{ filter.max_value.param_name }}"
                      value="{{ max_display }}"
                      placeholder="{{ range_max }}"
                      min="0"
                      max="{{ range_max }}"
                      step="any"
                      data-facets-price
                    >
                  </div>
                </div>
              </div>
            {% else %}
              <ul class="facets__list facets__list--{{ list_mode }}" role="list">
                {% for value in filter.values %}
                  {%- liquid
                    assign option_id = group_id | append: '-' | append: forloop.index
                    assign is_disabled = false
                    if value.count == 0 and value.active == false
                      assign is_disabled = true
                    endif
                  -%}
                  <li>
                    <label
                      for="{{ option_id }}"
                      class="facets__option facets__option--{{ list_mode }}{% if is_disabled %} is-disabled{% endif %}"
                      {% if list_mode == 'swatches' %}title="{{ value.label | escape }}"{% endif %}
                    >
                      <input
                        id="{{ option_id }}"
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value | escape }}"
                        class="facets__checkbox"
                        data-facets-input
                        {% if value.active %}checked{% endif %}
                        {% if is_disabled %}disabled{% endif %}
                      >
                      {%- case list_mode -%}
                        {%- when 'swatches' -%}
                          {%- liquid
                            # Swatch colour / image, first match wins:
                            # 1. Shopify's swatch on the filter value (Search & Discovery
                            #    filter shown as swatches).
                            # 2. Shopify's colour metaobject (Content > Metaobjects >
                            #    Color, type shopify--color-pattern) whose handle matches
                            #    the value, e.g. "Light Brown" -> light-brown.
                            # 3. Theme settings > Swatches, else the name as a CSS colour.
                            assign swatch_color = value.swatch.color
                            assign swatch_image = value.swatch.image
                            if swatch_color == blank and swatch_image == blank
                              assign swatch_handle = value.label | handleize
                              assign swatch_entry = metaobjects['shopify--color-pattern'][swatch_handle]
                              if swatch_entry
                                assign swatch_color = swatch_entry.color.value.first | default: swatch_entry.color.value
                                assign swatch_image = swatch_entry.image.value
                              endif
                            endif
                          -%}
                          <span
                            class="facets__swatch"
                            style="{% if swatch_color != blank or swatch_image != blank %}{% if swatch_color != blank %}--swatch-color: {{ swatch_color }};{% endif %}{% if swatch_image != blank %} --swatch-image: url('{{ swatch_image | image_url: width: 60 }}');{% endif %}{% else %}{% render 'swatch-style', value: value.label, image_width: 60 %}{% endif %}"
                            aria-hidden="true"
                          ></span>
                          <span class="visually-hidden">{{ value.label | escape }} ({{ value.count }})</span>
                        {%- when 'pills' -%}
                          <span class="facets__pill">{{ value.label | escape }}</span>
                          <span class="visually-hidden">({{ value.count }})</span>
                        {%- else -%}
                          <span class="facets__box" aria-hidden="true"></span>
                          <span class="facets__option-label">{{ value.label | escape }}</span>
                          <span class="facets__option-count">({{ value.count }})</span>
                      {%- endcase -%}
                    </label>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </details>
        {% endfor %}

        <noscript>
          <button type="submit" class="button button--primary facets__apply">{{ 'collections.apply' | t }}</button>
        </noscript>
      </form>

      <div id="FacetsFooter-{{ section_id }}" class="facets__footer" data-results-part>
        <button type="button" class="button button--primary facets__footer-button" data-facets-close>
          {{- 'collections.apply_filter' | t -}}
        </button>
      </div>
    </div>
  </aside>
{% elsif sorting %}
  <form id="FacetsForm-{{ section_id }}" action="{{ url }}" method="get" data-facets-form hidden>{{ hidden_inputs }}</form>
{%- endif -%}
