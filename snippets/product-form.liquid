{% doc %}
  Renders the product page buy buttons (Product section > Buy buttons
  block): the product form holding the selected variant id, the add to cart
  button and, optionally, Shopify's dynamic checkout buttons.

  The variant picker and quantity blocks live elsewhere in the info column
  and join this form through the `form` attribute (form id =
  `form_id`). Submission follows Theme settings > Cart > Type: a normal
  submit for "page", otherwise an Ajax Cart API request that opens the cart
  drawer/notification.

  @param {product} product - The product
  @param {variant} variant - The selected (or first available) variant
  @param {string} form_id - The product form id
  @param {object} block - The buy buttons block (button_style, show_dynamic_checkout)
  @param {string} section_id - The section id, for unique element ids
  @param {string} [quantity] - Quantity selector markup shown on the same line as Add to cart

  @example
  {% render 'product-form', product: product, variant: current_variant, form_id: form_id, block: block, section_id: section.id %}
{% enddoc %}

<script src="{{ 'product-form.js' | asset_url }}" defer></script>

<product-form class="product-form" data-cart-type="{{ settings.cart_type }}" {{ block.shopify_attributes }}>
  {% form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate' %}
    <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id-input>

    <div class="product-form__buttons">
      <div class="product-form__row">
      {{ quantity }}
      <button
        id="AddToCart-{{ section_id }}"
        type="submit"
        name="add"
        class="button button--{{ block.settings.button_style | default: 'primary' }} product-form__submit"
        data-add-to-cart
        data-product-part
        {% unless variant.available %}disabled{% endunless %}
      >
        <span class="product-form__submit-label">
          {%- if variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </span>
        <span class="product-form__spinner" aria-hidden="true"></span>
      </button>
      </div>

      {% if block.settings.show_dynamic_checkout %}
        <div class="product-form__dynamic">{{ form | payment_button }}</div>
      {% endif %}
    </div>

    <p class="product-form__error" role="alert" data-product-form-error hidden></p>
  {% endform %}
</product-form>

