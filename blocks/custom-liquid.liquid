{% doc %}
  Renders a Custom Liquid block.

  @example
  {% content_for 'block', type: 'custom-liquid', id: 'custom-liquid' %}
{% enddoc %}
<div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.name",
      "info": "t:sections.custom_liquid.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.name"
    }
  ]
}
{% endschema %}
