{% doc %}
  Renders a single announcement message (text, optional icon and optional
  link) used by the announcement bar's marquee and vertical slider modes.
  The same block type is intentionally shared by both modes so merchants
  manage one list of messages regardless of which display mode is active.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign is_slide = false
  if section.settings.layout_mode == 'slider'
    assign is_slide = true
  endif
%}

{% unless block.settings.enabled == false %}
  <div
    class="announcement-bar__item{% if is_slide %} announcement-bar__slide{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.link != blank %}
      <a
        class="announcement-bar__link"
        href="{{ block.settings.link }}"
        {% if block.settings.open_in_new_tab %}
          target="_blank"
          rel="noopener"
        {% endif %}
      >
        {% if block.settings.icon != blank %}
          <span class="announcement-bar__icon" aria-hidden="true">
            {{
              block.settings.icon
              | image_url: width: 64
              | image_tag: loading: 'lazy', widths: '32,64', sizes: '20px'
            }}
          </span>
        {% endif %}
        <span class="announcement-bar__text">{{ block.settings.text }}</span>
        {% if block.settings.open_in_new_tab %}
          <span class="announcement-bar__visually-hidden">{{ 'accessibility.opens_in_new_window' | t }}</span>
        {% endif %}
      </a>
    {% else %}
      {% if block.settings.icon != blank %}
        <span class="announcement-bar__icon" aria-hidden="true">
          {{
            block.settings.icon
            | image_url: width: 64
            | image_tag: loading: 'lazy', widths: '32,64', sizes: '20px'
          }}
        </span>
      {% endif %}
      <span class="announcement-bar__text">{{ block.settings.text }}</span>
    {% endif %}
  </div>
{% endunless %}

{% stylesheet %}
  .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: inherit;
    white-space: nowrap;
  }

  /* Inside the vertical slider, each item becomes a fixed-height slot (the
     same height the section uses for its per-step translateY, via the
     shared --announcement-bar-slide-height custom property) so the track
     can move by exactly one item per step with nothing left showing from
     its neighbors. Text is kept to a single line so it can never grow
     taller than that slot. */
  .announcement-bar--slider .announcement-bar__slide {
    display: flex;
    align-items: center;
    height: var(--announcement-bar-slide-height, 2.4em);
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
    justify-content: var(--announcement-bar-justify, center);
  }

  .announcement-bar--slider .announcement-bar__slide .announcement-bar__text,
  .announcement-bar--slider .announcement-bar__slide .announcement-bar__link {
    min-width: 0;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .announcement-bar__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
  }

  .announcement-bar__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .announcement-bar__text {
    color: inherit;
  }

  .announcement-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__link:hover,
  .announcement-bar__link:focus-visible {
    text-decoration: underline;
  }

  .announcement-bar__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Separator after every marquee item, including the last one in a group,
     so the pattern continues unbroken where one repeated group meets the
     next. The character itself is supplied by the section as a CSS custom
     property so this stylesheet stays unaware of the merchant's choice. */
  .announcement-bar--marquee .announcement-bar__item::after {
    content: var(--announcement-bar-separator-content, '\2022');
    margin-inline-start: 0.75em;
    opacity: 0.6;
  }

  .announcement-bar--marquee.announcement-bar--no-separator .announcement-bar__item::after {
    content: none;
  }

  .announcement-bar__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_item",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:labels.enable",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free shipping on orders above $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.icon"
    }
  ]
}
{% endschema %}
