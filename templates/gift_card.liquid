{% layout none %}

{% comment %}
  Gift card page (the link in the gift card email). A standalone page:
  shop logo, the card (balance, status), the recipient's message, the code
  with a copy button, a QR code for in-store use, expiry, Apple Wallet, and
  "Start shopping" / "Print". Colors and the card image come from
  Theme settings > Gift card. Styles: assets/gift-card.css, behavior:
  assets/gift-card.js.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/gift-card-liquid
{% endcomment %}

{%- liquid
  assign balance = gift_card.balance | money
  assign initial_value = gift_card.initial_value | money
  assign status = 'active'
  if gift_card.enabled == false
    assign status = 'disabled'
  elsif gift_card.expired
    assign status = 'expired'
  elsif gift_card.balance == 0
    assign status = 'used'
  endif
-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% render 'css-variables' %}

    {% unless settings.type_body_font.system? and settings.type_header_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="gift-card-page color-{{ settings.gift_card_color_scheme.id }}">
    <main class="gift-card">
      <header class="gift-card__header">
        <a href="{{ routes.root_url }}" class="gift-card__logo">
          {%- if settings.logo -%}
            {{
              settings.logo
              | image_url: width: 400
              | image_tag: alt: shop.name, widths: '200, 300, 400', sizes: '10rem', class: 'gift-card__logo-image'
            }}
          {%- else -%}
            <span class="gift-card__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </header>

      <h1 class="h3 gift-card__title">{{ 'gift_card.title' | t: value: initial_value, shop: shop.name }}</h1>

      {%- comment -%} The card {%- endcomment -%}
      <div class="gift-card__card color-{{ settings.gift_card_card_color_scheme.id }}{% if status != 'active' %} gift-card__card--inactive{% endif %}">
        {%- if settings.gift_card_image != blank -%}
          {{
            settings.gift_card_image
            | image_url: width: 1200
            | image_tag: class: 'gift-card__card-image', widths: '600, 900, 1200', sizes: '(min-width: 40rem) 32rem, 90vw', alt: ''
          }}
          <span class="gift-card__card-overlay" aria-hidden="true"></span>
        {%- endif -%}

        <div class="gift-card__card-top">
          <span class="gift-card__card-shop">{{ shop.name }}</span>
          <span class="gift-card__card-label">{{ 'gift_card.card' | t }}</span>
        </div>

        <div class="gift-card__card-bottom">
          <p class="gift-card__balance">
            <span class="visually-hidden">{{ 'gift_card.balance' | t }}</span>
            {{ balance }}
          </p>
          {%- if gift_card.balance != gift_card.initial_value -%}
            <p class="gift-card__initial">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
          {%- endif -%}
        </div>

        {%- if status != 'active' -%}
          {%- assign status_key = 'gift_card.status.' | append: status -%}
          <span class="gift-card__status">{{ status_key | t }}</span>
        {%- endif -%}
      </div>

      {%- if status == 'expired' -%}
        <p class="gift-card__notice" role="alert">{{ 'gift_card.expired' | t }}</p>
      {%- elsif status == 'disabled' -%}
        <p class="gift-card__notice" role="alert">{{ 'gift_card.disabled' | t }}</p>
      {%- endif -%}

      {%- comment -%} Message from the sender (gift cards sent to a recipient) {%- endcomment -%}
      {%- if gift_card.message != blank -%}
        <figure class="gift-card__message">
          <blockquote>{{ gift_card.message | escape | newline_to_br }}</blockquote>
          {%- if gift_card.recipient.name != blank -%}
            <figcaption>{{ 'gift_card.for_recipient' | t: name: gift_card.recipient.name }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}

      {%- if status == 'active' -%}
        <div class="gift-card__redeem">
          <p class="gift-card__redeem-label">{{ 'gift_card.use_at_checkout' | t }}</p>

          <div class="gift-card__code-row">
            <code class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</code>
            <button
              type="button"
              class="gift-card__copy"
              data-copy-code="{{ gift_card.code | escape }}"
              data-copied-label="{{ 'gift_card.copied' | t | escape }}"
              aria-describedby="GiftCardCode"
              hidden
            >
              {{- 'gift_card.copy_code' | t -}}
            </button>
          </div>
          <p class="visually-hidden" role="status" data-copy-status></p>

          <div class="gift-card__qr-wrap">
            <div class="gift-card__qr" data-qr-identifier="{{ gift_card.qr_identifier }}" aria-hidden="true"></div>
            <p class="gift-card__qr-label">{{ 'gift_card.scan_in_store' | t }}</p>
          </div>

          {%- if gift_card.expires_on -%}
            {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
            <p class="gift-card__expires">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gift-card__actions">
        <a href="{{ routes.root_url }}" class="button button--primary">{{ 'gift_card.start_shopping' | t }}</a>
        <button type="button" class="button button--secondary" data-print hidden>{{ 'gift_card.print' | t }}</button>
      </div>

      {%- if gift_card.pass_url and status == 'active' -%}
        <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="120"
            height="40"
            loading="lazy"
          >
        </a>
      {%- endif -%}
    </main>
  </body>
</html>
